#!/bin/bash
# Cache the latest Bing photos of the day for the Kodi home screen. Offline is not an error.
set -euo pipefail
DIR=/var/cache/media-stick/wallpapers
KEEP=24
API='https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=8&mkt=en-US'
BLUR=/var/cache/media-stick/wallpapers-blur
BUNDLED=/home/media/.kodi/addons/script.media-stick.home/resources/wallpapers
log() { echo "media-stick-wallpapers: $*"; }

# Small, soft copies of every photo (downloaded and bundled) for the skin's backgrounds behind
# Settings and dialogs: made once per photo, so Kodi never blurs anything itself.
blur_all() {
  local src n
  mkdir -p "$BLUR"
  for src in "$DIR"/*.jpg "$BUNDLED"/*.jpg; do
    [ -s "$src" ] || continue
    n=${src##*/}
    [ -s "$BLUR/$n" ] && continue
    if ffmpeg -nostdin -loglevel error -y -i "$src" -vf "scale=960:-2,gblur=sigma=24,eq=saturation=1.25"          -q:v 2 -f mjpeg "$BLUR/.part" && [ -s "$BLUR/.part" ]; then
      chmod 0644 "$BLUR/.part"; mv "$BLUR/.part" "$BLUR/$n"
    else
      rm -f "$BLUR/.part"; log "could not blur $n"
    fi
  done
  for src in "$BLUR"/*.jpg; do
    [ -e "$src" ] || continue
    n=${src##*/}
    [ -e "$DIR/$n" ] || [ -e "$BUNDLED/$n" ] || rm -f "$src"
  done
}

mkdir -p "$DIR"
json=$(curl -fsS --max-time 20 "$API") || { log "bing unreachable, keeping the cache"; blur_all; exit 0; }
urlbases=$(printf '%s' "$json" | jq -r '.images[].urlbase') || { log "unexpected answer from bing"; blur_all; exit 0; }

tmp=$(mktemp "$DIR/.part.XXXXXX")
trap 'rm -f "$tmp"' EXIT
while IFS= read -r urlbase; do
  [ -n "$urlbase" ] || continue
  name=${urlbase##*/}; name=${name#*id=}          # OHR.Name_EN-US123
  name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')
  dst="$DIR/$name.jpg"
  [ -s "$dst" ] && continue
  if ! curl -fsS --max-time 60 -o "$tmp" "https://www.bing.com${urlbase}_1920x1080.jpg"; then
    log "download failed: $name"; continue
  fi
  if [ "$(stat -c %s "$tmp")" -ge 51200 ] && [ "$(head -c 2 "$tmp" | od -An -tx1 | tr -d ' \n')" = ffd8 ]; then
    chmod 0644 "$tmp"; mv "$tmp" "$dst"; tmp=$(mktemp "$DIR/.part.XXXXXX"); log "added $name"
  else
    log "not a usable JPEG: $name"
  fi
done <<< "$urlbases"

# keep the newest $KEEP, drop the rest
ls -t "$DIR"/*.jpg 2>/dev/null | tail -n +$((KEEP + 1)) | while IFS= read -r old; do rm -f "$old"; done
blur_all
exit 0
