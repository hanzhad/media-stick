#!/usr/bin/python3
"""Keep the home-screen tiles: our favourites first, the ones added on the TV after.

Usage: kodi-favourites --check <ours.xml>    exit 1 if favourites.xml needs changing
       kodi-favourites --apply <ours.xml>    rewrite it (Kodi must be stopped)
"""
import os
import sys
import xml.etree.ElementTree as ET

PATH = "/home/media/.kodi/userdata/favourites.xml"
mode, ours_path = sys.argv[1], sys.argv[2]

ours = ET.parse(ours_path).getroot().findall("favourite")
names = {f.get("name") for f in ours}
theirs = []
if os.path.exists(PATH):
    theirs = [f for f in ET.parse(PATH).getroot().findall("favourite") if f.get("name") not in names]

root = ET.Element("favourites")
for f in ours + theirs:
    e = ET.SubElement(root, "favourite", name=f.get("name"), thumb=f.get("thumb") or "")
    e.text = (f.text or "").strip()
    e.tail = "\n"
root.text = "\n"
new = ET.tostring(root, encoding="unicode") + "\n"
old = open(PATH).read() if os.path.exists(PATH) else ""

if mode == "--check":
    sys.exit(0 if old == new else 1)
if old != new:
    tmp = PATH + ".tmp"
    open(tmp, "w").write(new)
    os.replace(tmp, PATH)
    print("favourites")
