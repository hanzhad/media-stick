#!/usr/bin/python3
"""What the TV shows, as a web page on the home network: http://mediastick.local:8090

Each frame is a Kodi screenshot (Kodi renders it itself, so menus come out right; a
playing video sits on a hardware overlay and may show black). Frames go to /run
(RAM), never to the SD card. One capture at a time, at most ~2 per second, shared by
every open page.
"""
import glob
import json
import os
import socket
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("SCREEN_VIEW_PORT", "8090"))
SHOTS = "/run/media-stick/shots"
MIN_INTERVAL = 0.5

PAGE = """<!doctype html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Media Stick screen</title>
<style>html,body{margin:0;background:#000;height:100%}
img{display:block;width:100%;height:100%;object-fit:contain}
#s{position:fixed;top:6px;right:10px;font:12px system-ui;color:#8aa}</style></head>
<body><img id="i" alt=""><div id="s"></div><script>
const i=document.getElementById('i'),s=document.getElementById('s');let n=0;
function next(){const t=Date.now();const im=new Image();
 im.onload=()=>{i.src=im.src;s.textContent=(Date.now()-t)+' ms';setTimeout(next,300)};
 im.onerror=()=>{s.textContent='Kodi не отвечает';setTimeout(next,2000)};
 im.src='/shot.png?'+(n++)}
next();</script></body></html>""".encode()

lock = threading.Lock()
last = {"t": 0.0, "png": b""}


def kodi_screenshot():
    req = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "Input.ExecuteAction",
                      "params": {"action": "screenshot"}})
    with socket.create_connection(("127.0.0.1", 9090), timeout=2) as s:
        s.sendall(req.encode())
        s.recv(4096)


def capture():
    with lock:
        if time.time() - last["t"] < MIN_INTERVAL and last["png"]:
            return last["png"]
        for f in glob.glob(f"{SHOTS}/*.png"):
            os.remove(f)
        kodi_screenshot()
        for _ in range(80):
            files = glob.glob(f"{SHOTS}/*.png")
            if files:
                with open(files[0], "rb") as fh:
                    png = fh.read()
                if png.endswith(b"IEND\xaeB`\x82"):  # Kodi has finished writing it
                    os.remove(files[0])
                    last.update(t=time.time(), png=png)
                    return png
            time.sleep(0.05)
        raise TimeoutError("no screenshot from Kodi")


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, body, ctype, code=200):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path.startswith("/shot.png"):
            try:
                return self.send(capture(), "image/png")
            except (OSError, TimeoutError) as e:
                return self.send(str(e).encode(), "text/plain", 503)
        if self.path == "/":
            return self.send(PAGE, "text/html; charset=utf-8")
        self.send(b"not found", "text/plain", 404)


if __name__ == "__main__":
    os.makedirs(SHOTS, exist_ok=True)
    ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
