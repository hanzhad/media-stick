#!/usr/bin/env python3
"""media-stick-lease: a cooperative lease on the device, so two testers do not break each other's view.

One holder at a time, a stated reason, a time limit. The tools in tools/ and media-stick-update
respect it; nothing here is enforced by the kernel. It lives in RAM, so a reboot clears it, and an
expired lease is free.

  media-stick-lease acquire --for HOLDER --why TEXT [--ttl 30m] [--wait 5m]
  media-stick-lease renew   --for HOLDER [--ttl 30m]      (only ever extends)
  media-stick-lease release --for HOLDER
  media-stick-lease status  [--json]
  media-stick-lease check                                  exit 0 free or expired, 3 held
  media-stick-lease steal   --for HOLDER --force [--why TEXT] [--ttl 30m]   (the owner's, never automatic)

HOLDER is "<name> [<session id>]". TTL is like 90s, 30m, 2h, 1h30m (a bare number is minutes), at
most 4h. Exit: 0 ok, 2 bad usage, 3 held by someone else (or unreadable), 4 renew without a live
lease. State: <root>/device-lease/lease.json; every change is made under flock on
<root>/device-lease.lock (the lease directory itself is made with mkdir). Nothing secret goes in it.
"""
import argparse
import fcntl
import json
import os
import re
import sys
import time

ROOT = os.environ.get("MEDIASTICK_LEASE_ROOT", "/run/media-stick")  # tests point it at a temp dir
STATE_DIR = os.path.join(ROOT, "device-lease")
LEASE = os.path.join(STATE_DIR, "lease.json")
LOCK = os.path.join(ROOT, "device-lease.lock")
MAX_TTL = 4 * 3600  # a lease never outlives this; an unreadable one is trusted for this long, then free
DEFAULT_TTL = 30 * 60
POLL = 1.0
EXIT_BUSY, EXIT_USAGE, EXIT_NOT_HELD = 3, 2, 4


def now():
    """Epoch seconds; MEDIASTICK_NOW fixes the clock for tests."""
    fixed = os.environ.get("MEDIASTICK_NOW")
    return int(float(fixed)) if fixed else int(time.time())


def parse_duration(text):
    """'90s', '30m', '2h', '1h30m' or a bare number of minutes -> seconds; ValueError otherwise."""
    text = text.strip().lower()
    if re.fullmatch(r"\d+", text):
        return int(text) * 60
    if not re.fullmatch(r"(\d+[smh])+", text):
        raise ValueError("not a duration (use 90s, 30m, 2h, 1h30m): %r" % text)
    units = {"s": 1, "m": 60, "h": 3600}
    return sum(int(n) * units[u] for n, u in re.findall(r"(\d+)([smh])", text))


def clean(text):
    """One line of printable text, at most 200 characters."""
    return " ".join("".join(c for c in text if c.isprintable() or c.isspace()).split())[:200]


def clock(ts):
    return time.strftime("%H:%M", time.localtime(ts))


def minutes_left(lease, t):
    return max(1, -(-(lease["expires"] - t) // 60))


def in_use_text(lease, t):
    return "device in use by %s: %s, until %s (%d min left)" % (
        lease["holder"], lease["why"], clock(lease["expires"]), minutes_left(lease, t))


def valid(data):
    return (isinstance(data, dict) and isinstance(data.get("holder"), str) and data["holder"]
            and isinstance(data.get("why"), str)
            and all(isinstance(data.get(k), (int, float)) and not isinstance(data.get(k), bool)
                    for k in ("since", "expires")))


def load(t):
    """-> (state, lease): free | expired | held | unreadable. Reads only; the caller holds a lock."""
    try:
        with open(LEASE, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return "free", None
    except (OSError, ValueError):
        data = None
    if data is not None and valid(data):
        return ("held" if data["expires"] > t else "expired"), data
    try:
        stamp = os.stat(LEASE).st_mtime
    except OSError:
        return "free", None
    # corrupt: never silently free, but it cannot block forever either
    return ("free", None) if t - stamp > MAX_TTL else ("unreadable", None)


class Lock:
    """flock on the lock file. Writers make it (readable by all, owned like the root dir); readers
    only wait for a writer in the middle of a change."""

    def __init__(self, write):
        self.write, self.fd = write, None

    def __enter__(self):
        if self.write:
            make_dir(ROOT)
        try:
            self.fd = os.open(LOCK, os.O_RDONLY | (os.O_CREAT if self.write else 0), 0o644)
        except OSError:
            if self.write:
                raise
            return self  # no lock file: no writer has ever run here
        if self.write:
            hand_over(LOCK)
        fcntl.flock(self.fd, fcntl.LOCK_EX if self.write else fcntl.LOCK_SH)
        return self

    def __exit__(self, *exc):
        if self.fd is not None:
            os.close(self.fd)


def hand_over(path):
    """Run as root (sudo), keep the files owned by whoever owns /run/media-stick (media)."""
    if os.geteuid() == 0:
        st = os.stat(ROOT)
        os.chown(path, st.st_uid, st.st_gid)


def make_dir(path):
    try:
        os.mkdir(path, 0o755)
    except FileExistsError:
        return
    except FileNotFoundError:
        os.makedirs(path, 0o755, exist_ok=True)
    if path != ROOT:
        hand_over(path)


def write_lease(holder, why, since, expires):
    make_dir(STATE_DIR)  # mkdir: atomic, and the one place the state is created
    lease = {"holder": holder, "why": why, "since": since, "expires": expires,
             "text": "%s: %s, %s-%s" % (holder, why, clock(since), clock(expires))}
    tmp = os.path.join(STATE_DIR, ".lease.%d.tmp" % os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(lease, f)
        f.write("\n")
    os.chmod(tmp, 0o644)
    hand_over(tmp)
    os.replace(tmp, LEASE)
    return lease


def drop():
    try:
        os.unlink(LEASE)
    except FileNotFoundError:
        pass
    try:
        os.rmdir(STATE_DIR)
    except OSError:
        pass


def busy(state, lease, t):
    """Print who has the device (stderr) and return the busy exit code."""
    if state == "unreadable":
        print("device lease file is unreadable; only the owner can clear it: "
              "media-stick-lease steal --for <holder> --force", file=sys.stderr)
    else:
        print(in_use_text(lease, t), file=sys.stderr)
    return EXIT_BUSY


def cmd_acquire(a):
    deadline, told = time.monotonic() + a.wait, False
    while True:
        t = now()
        with Lock(True):
            state, lease = load(t)
            if state in ("free", "expired"):
                new = write_lease(a.holder, a.why, t, t + a.ttl)
                print("lease acquired: until %s (%d min): %s" % (clock(new["expires"]), minutes_left(new, t), a.why))
                return 0
            if state == "held" and lease["holder"] == a.holder:
                new = write_lease(a.holder, a.why, lease["since"], max(lease["expires"], t + a.ttl))
                print("lease renewed: until %s (%d min): %s" % (clock(new["expires"]), minutes_left(new, t), a.why))
                return 0
            if time.monotonic() >= deadline:
                return busy(state, lease, t)
        if not told:
            print("waiting: %s" % ("lease unreadable" if state == "unreadable" else in_use_text(lease, t)),
                  file=sys.stderr)
            told = True
        time.sleep(min(POLL, max(0.0, deadline - time.monotonic())))


def cmd_renew(a):
    t = now()
    with Lock(True):
        state, lease = load(t)
        if state == "held" and lease["holder"] == a.holder:
            new = write_lease(a.holder, lease["why"], lease["since"], max(lease["expires"], t + a.ttl))
            print("lease renewed: until %s (%d min left)" % (clock(new["expires"]), minutes_left(new, t)))
            return 0
        if state in ("held", "unreadable"):
            return busy(state, lease, t)
        print("no live lease for %s (%s); acquire one first" % (a.holder, "expired" if state == "expired" else "free"),
              file=sys.stderr)
        return EXIT_NOT_HELD


def cmd_release(a):
    t = now()
    with Lock(True):
        state, lease = load(t)
        if state == "unreadable" or (state == "held" and lease["holder"] != a.holder):
            return busy(state, lease, t)
        drop()
        print("lease released" if state == "held" else "no live lease; nothing to release")
        return 0


def cmd_steal(a):
    if not a.force:
        print("steal takes a live lease from its holder; add --force (the owner's, never automatic)", file=sys.stderr)
        return EXIT_USAGE
    t = now()
    with Lock(True):
        state, lease = load(t)
        new = write_lease(a.holder, a.why or "taken over", t, t + a.ttl)
        if state == "held":
            print("took the lease from %s (%s, until %s)" % (lease["holder"], lease["why"], clock(lease["expires"])))
        elif state == "unreadable":
            print("took the lease over an unreadable lease file")
        else:
            print("the lease was free; acquired")
        print("lease until %s (%d min)" % (clock(new["expires"]), minutes_left(new, t)))
        return 0


def status_text(state, lease, t):
    if state == "held":
        return in_use_text(lease, t)
    if state == "expired":
        return "free (lease of %s expired at %s)" % (lease["holder"], clock(lease["expires"]))
    if state == "unreadable":
        return "lease file unreadable (owner: steal --for <holder> --force)"
    return "free"


def cmd_status(a):
    t = now()
    with Lock(False):
        state, lease = load(t)
    if a.json:
        out = {"state": state, "holder": None, "why": None, "since": None, "expires": None,
               "seconds_left": None, "now": t, "text": status_text(state, lease, t)}
        if lease:
            out.update(holder=lease["holder"], why=lease["why"], since=lease["since"], expires=lease["expires"],
                       seconds_left=max(0, lease["expires"] - t) if state == "held" else 0)
        print(json.dumps(out))
    else:
        print(status_text(state, lease, t))
    return 0


def cmd_check(a):
    t = now()
    with Lock(False):
        state, lease = load(t)
    if state in ("held", "unreadable"):
        print(status_text(state, lease, t))
        return EXIT_BUSY
    return 0


def duration(text):
    try:
        return parse_duration(text)
    except ValueError as e:
        raise argparse.ArgumentTypeError(str(e))


def ttl_value(text):
    seconds = duration(text)
    if not 0 < seconds <= MAX_TTL:
        raise argparse.ArgumentTypeError("ttl must be between 1s and 4h")
    return seconds


def text_value(text):
    text = clean(text)
    if not text:
        raise argparse.ArgumentTypeError("must not be empty")
    return text


def build_parser():
    p = argparse.ArgumentParser(prog="media-stick-lease", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, holder=True, ttl=False, why=False):
        s = sub.add_parser(name)
        s.set_defaults(fn=fn)
        if holder:
            s.add_argument("--for", dest="holder", required=True, type=text_value, help="<name> [<session id>]")
        if ttl:
            s.add_argument("--ttl", type=ttl_value, default=DEFAULT_TTL, help="default 30m, at most 4h")
        if why:
            s.add_argument("--why", required=(name == "acquire"), type=text_value, help="what for")
        return s

    add("acquire", cmd_acquire, ttl=True, why=True).add_argument(
        "--wait", type=duration, default=0, help="wait up to this long for a held lease")
    add("renew", cmd_renew, ttl=True)
    add("release", cmd_release)
    add("steal", cmd_steal, ttl=True, why=True).add_argument("--force", action="store_true")
    add("status", cmd_status, holder=False).add_argument("--json", action="store_true")
    add("check", cmd_check, holder=False)
    return p


def main(argv=None):
    a = build_parser().parse_args(argv)
    try:
        return a.fn(a)
    except OSError as e:
        print("media-stick-lease: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
