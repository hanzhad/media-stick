#!/usr/bin/python3
"""The one page: http://mediastick.local

  - hotspot up (no network yet)  -> Wi-Fi setup
  - phone                         -> remote; screen, settings and info behind buttons
  - wide screen                   -> screen, remote and device info side by side

Runs as user media. Talks to Kodi over its local JSON-RPC socket (no Kodi password),
and reaches root-only actions through `sudo -n` on a fixed list of commands, with any
secret passed on stdin.

Requests that change something must carry the header X-Panel: 1. A browser cannot add
that header to a cross-site request without a preflight this server never answers, so
another web page cannot press buttons here. The Host header is checked too, against
DNS rebinding.
"""
import hashlib
import glob
import json
import math
import os
import re
import socket
import ssl
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, "/usr/local/lib/media-stick")
import panel_accounts   # the Accounts tab and its API
import panel_watch      # the Смотреть tab and its API
import panel_lang       # the device's language: its settings page and API
import panel_onboarding_ui   # the sheet of the shared TV <-> phone onboarding
try:
    import mediastick_onboarding   # what the TV asks of this phone; the panel works without it
except ImportError:
    mediastick_onboarding = None
try:
    import mediastick_screen   # who has the TV (a cast, AirPlay, a web app); the panel works without it
except ImportError:
    mediastick_screen = None

PORT = int(os.environ.get("PANEL_PORT", "80"))
REPO = "/opt/media-stick"
SHOTS = "/run/media-stick/shots"
HOST_OK = re.compile(r"^(mediastick(\.local)?|localhost|\d{1,3}(\.\d{1,3}){3}|\[[0-9a-f:]+\])(:\d+)?$", re.I)

# Trusted HTTPS (see media-stick-cert, media-stick-https). Everything here is inert until
# media-stick-cert has published a certificate: no TLS files, no listener, no redirect.
# The environment overrides exist for tests.
HTTPS_PORT = int(os.environ.get("PANEL_HTTPS_PORT", "443"))
TLS_CRT = os.environ.get("PANEL_TLS_CRT", "/etc/media-stick/tls/fullchain.pem")
TLS_KEY = os.environ.get("PANEL_TLS_KEY", "/etc/media-stick/tls/key.pem")
STATE_DIR = os.environ.get("PANEL_STATE_DIR", "/var/lib/media-stick")
PANEL_URL = STATE_DIR + "/panel-url"        # https://<name>.duckdns.org/ once a certificate exists
SUGGEST = STATE_DIR + "/https-suggest"      # the subdomain bootstrap proposed for this device
HTTPS_HELPER = ["sudo", "-n", "/usr/local/bin/media-stick-https"]
PUBLIC_RE = re.compile(r"^https://([a-z0-9-]{1,63}[.]duckdns[.]org)/?$")
TOKEN_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)
https_state = {"up": False}                 # the HTTPS listener is running

# Kodi actions a button may send (Input.ExecuteAction names).
ACTIONS = {"up", "down", "left", "right", "select", "back", "contextmenu", "info",
           "playpause", "stop", "volumeup", "volumedown", "mute", "fastforward",
           "rewind", "osd", "skipnext", "skipprevious", "fullscreen"}

# Kodi's fullscreen video window (no OSD, no dialog) does not handle the MOVE_* actions that
# Input.ExecuteAction "left" and the like send straight to it: arrows work there only through
# the keymap (FullscreenVideo: left/right step, up/down chapter or big step, select = OSD).
# So in that window alone the arrows are sent as those actions themselves. With the OSD or any
# other dialog up, and everywhere else (Home, menus, our own screens), they stay MOVE_*.
PLAYER_KEYS = {"left": "stepback", "right": "stepforward", "up": "chapterorbigstepforward",
               "down": "chapterorbigstepback", "select": "osd"}
PLAYER_DIALOGS = ("videoosd", "osdvideosettings", "osdaudiosettings", "subtitlesettings",
                  "videobookmarks", "playerprocessinfo", "fullscreeninfo", "subtitlesearch")
PLAYER_BOOLS = (["Window.IsActive(fullscreenvideo)", "System.HasModalDialog"]
                + ["Window.IsActive(%s)" % w for w in PLAYER_DIALOGS])

# While a web app (Chromium, see web-app) has the screen, the same buttons become
# keys typed into the browser; "home" closes it and brings Kodi back.
WEB_KEYS = {"up": "Up", "down": "Down", "left": "Left", "right": "Right",
            "select": "Return", "back": "Escape", "playpause": "space",
            "fastforward": "Right", "rewind": "Left", "fullscreen": "f", "mute": "m"}

# ---------------- helpers ----------------

def run(cmd, stdin=None, timeout=20):
    try:
        p = subprocess.run(cmd, input=stdin, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip()
    except (subprocess.TimeoutExpired, OSError):
        return 124, ""


def web_app_on():
    return run(["systemctl", "is-active", "-q", "web-app@*"])[0] == 0

def wayland_env():
    rt = f"/run/user/{os.getuid()}"
    socks = sorted(glob.glob(f"{rt}/wayland-[0-9]"))
    return dict(os.environ, XDG_RUNTIME_DIR=rt, WAYLAND_DISPLAY=os.path.basename(socks[-1]) if socks else "wayland-0")

def web_key(key):
    subprocess.run(["wtype", "-k", key], env=wayland_env(), timeout=5, capture_output=True)

def web_type(text):
    subprocess.run(["wtype", "--", text], env=wayland_env(), timeout=10, capture_output=True)

def kodi(method, params=None, timeout=3):
    req = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params or {}})
    with socket.create_connection(("127.0.0.1", 9090), timeout=timeout) as s:
        s.sendall(req.encode())
        buf = b""
        while True:  # Kodi sends one JSON object, no newline
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
            try:
                return json.loads(buf).get("result")
            except ValueError:
                continue
    return None

def player_action(a, flags):
    """The action to send for button `a` given Kodi's answer to PLAYER_BOOLS (a dict): the
    player's own action while the bare fullscreen video is up, else `a` unchanged."""
    if a not in PLAYER_KEYS or not isinstance(flags, dict):
        return a
    if flags.get(PLAYER_BOOLS[0]) is True and all(flags.get(k) is False for k in PLAYER_BOOLS[1:]):
        return PLAYER_KEYS[a]
    return a

def key_action(a):
    """What Input.ExecuteAction gets for button `a`; one extra question to Kodi, asked only for
    the keys that differ in the player. Any trouble asking: the button as it is."""
    if a not in PLAYER_KEYS:
        return a
    try:
        return player_action(a, kodi("XBMC.GetInfoBooleans", {"booleans": PLAYER_BOOLS}))
    except (OSError, ValueError):
        return a

class FocusWatch:
    """What has focus on the TV, as a counter that goes up each time it changes, so the phone
    can buzz when something really moved there (a key press that reached the edge does not).
    One kept-open JSON-RPC connection, asked at most every 80 ms however many pages poll."""
    def __init__(self):
        self.lock = threading.Lock()
        self.sock = None
        self.buf = b""
        self.rid = 0
        self.sig = None
        self.win = None
        self.n = 0
        self.t = 0.0

    def _close(self):
        try:
            if self.sock:
                self.sock.close()
        except OSError:
            pass
        self.sock, self.buf = None, b""

    def _call(self, method, params):
        if self.sock is None:
            self.sock = socket.create_connection(("127.0.0.1", 9090), timeout=1.0)
        self.rid += 1
        self.sock.sendall(json.dumps({"jsonrpc": "2.0", "id": self.rid, "method": method,
                                      "params": params}).encode())
        dec = json.JSONDecoder()
        while True:   # replies and Kodi's own notifications come back to back, no separator
            try:
                text = self.buf.decode("utf-8")
                obj, end = dec.raw_decode(text.lstrip())
            except (UnicodeDecodeError, ValueError):
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise OSError("kodi closed the connection")
                self.buf += chunk
                continue
            used = len(text) - len(text.lstrip()) + end
            self.buf = text[used:].encode("utf-8")
            if obj.get("id") == self.rid:
                return obj.get("result") or {}

    def poll(self, max_age=0.08):
        with self.lock:
            now = time.monotonic()
            if now - self.t < max_age:
                return self.n
            for attempt in (1, 2):
                try:
                    r = self._call("GUI.GetProperties", {"properties": ["currentwindow", "currentcontrol"]})
                    break
                except (OSError, ValueError):
                    self._close()
                    if attempt == 2:
                        return self.n
            self.win = (r.get("currentwindow") or {}).get("id")
            sig = "%s|%s" % (self.win, (r.get("currentcontrol") or {}).get("label"))
            if self.sig is not None and sig != self.sig:
                self.n += 1
            self.sig, self.t = sig, time.monotonic()
            return self.n

    def after(self, before):
        """After a key: Kodi runs actions on its own thread, so look a few times."""
        n = before
        for wait in (0.04, 0.05, 0.08):
            time.sleep(wait)
            n = self.poll(0)
            if n != before:
                break
        return n

FOCUS = FocusWatch()

KB_WINDOWS = {10103, 10109}   # Kodi's on-screen keyboard and its number pad

def kb_state(win=None):
    """Kodi's on-screen keyboard while it is up: its heading and the text typed so far, so the
    phone can offer its own keyboard instead. None when no keyboard is up."""
    if win is None:
        win = ((kodi("GUI.GetProperties", {"properties": ["currentwindow"]}) or {})
               .get("currentwindow") or {}).get("id")
    if win not in KB_WINDOWS:
        return None
    r = kodi("XBMC.GetInfoLabels", {"labels": ["Control.GetLabel(311)", "Control.GetLabel(312).index(1)"]}) or {}
    return {"title": r.get("Control.GetLabel(311)", ""), "text": r.get("Control.GetLabel(312).index(1)", ""),
            "num": win == 10109}

def kb_now():
    """kb_state from the window FocusWatch last saw: nothing more is asked unless it is a keyboard."""
    try:
        return kb_state(FOCUS.win) if FOCUS.win in KB_WINDOWS else None
    except OSError:
        return None

def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default

_pub = {"mtime": None, "host": ""}

def public_host():
    """<name>.duckdns.org from panel-url, or "". Read again when the file changes."""
    try:
        m = os.stat(PANEL_URL).st_mtime_ns
    except OSError:
        _pub.update(mtime=None, host="")
        return ""
    if m != _pub["mtime"]:
        hit = PUBLIC_RE.match(read(PANEL_URL).lower())
        _pub.update(mtime=m, host=hit.group(1) if hit else "")
    return _pub["host"]

def host_name(host):
    return re.sub(r":[0-9]+$", "", host.lower())

https_cache = {"t": 0.0, "s": None}
https_lock = threading.Lock()

def https_status():
    """The helper's status (no secrets), asked at most every 2 s however many pages poll."""
    with https_lock:
        if https_cache["s"] and time.time() - https_cache["t"] < 2:
            return https_cache["s"]
        rc, out = run(HTTPS_HELPER + ["status"], timeout=15)
        try:
            s = json.loads(out)
            if not isinstance(s, dict):
                raise ValueError
        except ValueError:
            s = {"configured": False, "domain": "", "state": "error", "cert_days_left": None, "url": "",
                 "message": "Помощник HTTPS не отвечает"}
        s["message"] = TOKEN_RE.sub("***", str(s.get("message", "")))
        s["suggest"] = read(SUGGEST)
        https_cache.update(t=time.time(), s=s)
        return s

# ---------------- screen ----------------

shot_lock = threading.Lock()
last_shot = {"t": 0.0, "png": b"", "gen": 0}

def forget_shot():
    """The screen has changed under us (a pointer action): the next frame must be new."""
    last_shot["gen"] += 1
    last_shot["t"] = 0.0

def screenshot():
    with shot_lock:
        if time.time() - last_shot["t"] < 0.5 and last_shot["png"]:
            return last_shot["png"]
        gen = last_shot["gen"]
        for f in glob.glob(f"{SHOTS}/*.png"):
            os.remove(f)
        kodi("Input.ExecuteAction", {"action": "screenshot"})
        for _ in range(80):
            files = glob.glob(f"{SHOTS}/*.png")
            if files:
                with open(files[0], "rb") as fh:
                    png = fh.read()
                if png.endswith(b"IEND\xaeB`\x82"):
                    os.remove(files[0])
                    last_shot.update(t=time.time() if last_shot["gen"] == gen else 0.0, png=png)
                    return png
            time.sleep(0.05)
        raise TimeoutError("no screenshot from Kodi")

# ---------------- pointer ----------------

# A virtual mouse for Kodi (setting input.enablemouse is on): the page says where on the
# picture of the TV a finger landed, positions are fractions 0..1 of the screen. One
# absolute-position uinput device, made in the background when the panel starts (Kodi
# needs about 2 s to notice a new device) and reused; /dev/uinput is group input by a
# udev rule and the panel's user is in that group. Without access every other part of the
# panel keeps working and /api/pointer answers 503.
SCREEN_W, SCREEN_H = 1920, 1080
POINTER_NAME = "media-stick-pointer"
POINTER_ACTIONS = {"click", "right", "move", "move_by", "scroll"}

class PointerUnavailable(Exception):
    pass

class Pointer:
    SETTLE_S = 2.2   # Kodi picks up a new input device after about 2 s
    RETRY_S = 5.0    # do not hammer /dev/uinput while it is not usable

    def __init__(self):
        self.lock = threading.RLock()
        self.ui = None
        self.ev = None
        self.ready_at = 0.0
        self.tried = 0.0
        self.err = ""
        self.x = None    # last position, fractions of the screen; None until first move
        self.y = None

    def _open(self):
        """Make the device if there is none. Lock held."""
        if self.ui is not None or time.time() - self.tried < self.RETRY_S:
            return
        self.tried = time.time()
        try:
            from evdev import AbsInfo, UInput, ecodes
        except ImportError:
            self.err = "не установлен python3-evdev"
            return
        caps = {ecodes.EV_KEY: [ecodes.BTN_LEFT, ecodes.BTN_RIGHT],
                ecodes.EV_REL: [ecodes.REL_WHEEL],
                ecodes.EV_ABS: [(ecodes.ABS_X, AbsInfo(0, 0, SCREEN_W - 1, 0, 0, 0)),
                                (ecodes.ABS_Y, AbsInfo(0, 0, SCREEN_H - 1, 0, 0, 0))]}
        try:
            self.ui = UInput(caps, name=POINTER_NAME)
        except OSError as e:
            self.err = "нет доступа к /dev/uinput (%s)" % (e.strerror or e)
            return
        self.ev = ecodes
        self.err = ""
        self.x = self.y = None
        self.ready_at = time.time() + self.SETTLE_S

    def start(self):
        """Make the device now, in the background, so the first tap need not wait."""
        def go():
            with self.lock:
                self._open()
        threading.Thread(target=go, daemon=True).start()

    def close(self):
        with self.lock:
            try:
                if self.ui is not None:
                    self.ui.close()
            except OSError:
                pass
            self.ui = None
            self.tried = 0.0

    def _ready(self):
        self._open()
        if self.ui is None:
            raise PointerUnavailable(self.err or "устройство не создано")
        wait = self.ready_at - time.time()
        if wait > 0:
            time.sleep(wait)

    def _abs(self, fx, fy):
        self.ui.write(self.ev.EV_ABS, self.ev.ABS_X, round(fx * (SCREEN_W - 1)))
        self.ui.write(self.ev.EV_ABS, self.ev.ABS_Y, round(fy * (SCREEN_H - 1)))
        self.ui.syn()

    def move_to(self, fx, fy, settle=0.08):
        """Absolute move; waits `settle` s after a real move so Kodi registers the hover."""
        moved = self.x is None or abs(fx - self.x) > 1e-4 or abs(fy - self.y) > 1e-4
        self._abs(fx, fy)
        self.x, self.y = fx, fy
        time.sleep(settle if moved else 0.02)

    def move_by(self, dfx, dfy):
        """Relative move in screen fractions: the air mouse (POST /api/pointer move_by)."""
        fx = 0.5 if self.x is None else self.x
        fy = 0.5 if self.y is None else self.y
        self.move_to(min(1.0, max(0.0, fx + dfx)), min(1.0, max(0.0, fy + dfy)), 0.0)

    def act(self, action, fx=None, fy=None, wheel=0):
        with self.lock:
            self._ready()
            try:
                if fx is None:   # scroll without a position: where the pointer already is
                    fx = 0.5 if self.x is None else self.x
                    fy = 0.5 if self.y is None else self.y
                ev = self.ev
                if action == "move":
                    self.move_to(fx, fy, 0.0)
                elif action == "move_by":   # fx, fy are the deltas here
                    self.move_by(fx, fy)
                elif action in ("click", "right"):
                    self.move_to(fx, fy)
                    btn = ev.BTN_LEFT if action == "click" else ev.BTN_RIGHT
                    self.ui.write(ev.EV_KEY, btn, 1)
                    self.ui.syn()
                    time.sleep(0.05)
                    self.ui.write(ev.EV_KEY, btn, 0)
                    self.ui.syn()
                elif action == "scroll":
                    self.move_to(fx, fy, 0.03)
                    for _ in range(abs(wheel)):   # one notch per event; + is up, like a wheel
                        self.ui.write(ev.EV_REL, ev.REL_WHEEL, 1 if wheel > 0 else -1)
                        self.ui.syn()
                        time.sleep(0.01)
            except OSError as e:
                self.close()   # made again on the next action
                raise PointerUnavailable("устройство пропало (%s)" % (e.strerror or e))

POINTER = Pointer()

# ---------------- state ----------------

def wifi_status():
    """Read-only nmcli calls: no sudo, so no PAM/polkit/logind work per poll."""
    rc, out = run(["nmcli", "-t", "-f", "DEVICE,STATE,CONNECTION", "dev"])
    wlan = next((l.split(":", 2) for l in out.splitlines() if l.startswith("wlan0:")), None)
    con = wlan[2] if wlan and len(wlan) > 2 else ""
    ap = con == "ms-setup"
    ssid = ""
    if con and not ap:
        ssid = run(["nmcli", "-g", "802-11-wireless.ssid", "con", "show", con])[1]
    online = run(["nmcli", "-t", "networking", "connectivity"])[1] == "full"
    return {"online": online, "ap": ap, "ssid": ssid}

# what the page may know of an onboarding document: the schema's fields, minus the TV-only chips
ONBOARDING_FIELDS = ("v", "service", "flow", "state", "kicker", "title", "step", "steps", "code", "link", "action",
                     "hint", "warn", "items", "updated", "expires")

def onboarding_docs():
    """The live onboarding documents for the phone's sheet; [] when there is no library, no directory or no document."""
    if mediastick_onboarding is None:
        return []
    try:
        return [{k: d[k] for k in ONBOARDING_FIELDS if k in d} for d in mediastick_onboarding.list_active()]
    except Exception:
        return []

def screen_owner():
    """Who has the TV besides Kodi: "miracast", "airplay", "web-app", or "" (Kodi's, nobody's, or no library)."""
    if mediastick_screen is None:
        return ""
    try:
        return mediastick_screen.owner()
    except Exception:
        return ""

status_cache = {"t": 0.0, "s": None}
status_lock = threading.Lock()

def status():
    """Shared by every open page: computed at most once per 3 s."""
    with status_lock:
        if status_cache["s"] and time.time() - status_cache["t"] < 3:
            return status_cache["s"]
        s = _status()
        status_cache.update(t=time.time(), s=s)
        return s

def sd_minutes(ts, now=None):
    """Whole minutes from `now` to a systemd timestamp ("Mon 2026-11-23 15:05:00 UTC", box-local time);
    negative = in the past, None = empty or "n/a"."""
    m = re.search(r"(\d{4})-(\d\d)-(\d\d) (\d\d):(\d\d):(\d\d)", ts or "")
    if not m:
        return None
    t = time.mktime(tuple(int(x) for x in m.groups()) + (0, 0, -1))
    return int((t - (time.time() if now is None else now)) // 60)


def _status():
    s = {"time": time.strftime("%H:%M")}
    s["wifi"] = wifi_status()
    s["uptime"] = run(["uptime", "-p"])[1].replace("up ", "")
    s["temp"] = run(["vcgencmd", "measure_temp"])[1].split("=")[-1].strip().replace("'C", "°C")
    t = run(["vcgencmd", "get_throttled"])[1].split("=")[-1]
    s["throttled"] = t
    s["power_ok"] = t == "0x0"
    mem = dict(l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l)
    s["mem_free_mb"] = int(mem.get("MemAvailable", "0 kB").split()[0]) // 1024
    st = os.statvfs("/")
    s["disk_free_gb"] = round(st.f_bavail * st.f_frsize / 1e9, 1)
    s["ip"] = run(["hostname", "-I"])[1].split()
    s["https_url"] = read(PANEL_URL)
    s["page"] = PAGE_VER
    s["lang"] = panel_lang.current()
    s["commit"] = run(["git", "-C", REPO, "log", "-1", "--format=%h %s"])[1]
    s["commit_date"] = run(["git", "-C", REPO, "log", "-1", "--format=%cs"])[1]
    s["bad_commit"] = read("/var/lib/media-stick/bad-commit")[:7]
    nxt = run(["systemctl", "show", "media-stick-update.timer", "-p", "NextElapseUSecRealtime", "--value"])[1]
    s["next_update"] = nxt
    s["next_update_min"] = sd_minutes(nxt)
    # when the last check finished: the oneshot service's exit time (empty until the first run after the start)
    last = run(["systemctl", "show", "media-stick-update.service", "-p", "ExecMainExitTimestamp", "--value"])[1]
    s["last_check"] = last
    s["last_check_min"] = None if sd_minutes(last) is None else -sd_minutes(last)
    s["playing"] = ""
    s["kb"] = None
    players = []
    try:
        players = kodi("Player.GetActivePlayers") or []
        s["kodi"] = "up"
        if players:
            item = kodi("Player.GetItem", {"playerid": players[0]["playerid"],
                                           "properties": ["title", "showtitle"]}) or {}
            it = item.get("item", {})
            s["playing"] = it.get("title") or it.get("label") or ""
        s["kb"] = kb_state()
    except OSError:
        s["kodi"] = "down"
    # keys that do nothing now, greyed out on the page: in a web app only its own keys work;
    # in Kodi the playback keys need something playing
    if web_app_on():
        s["dead"] = sorted(ACTIONS - set(WEB_KEYS) - {"home"})
    elif not players:
        s["dead"] = ["fastforward", "osd", "playpause", "rewind", "stop"]
    else:
        s["dead"] = []
    s["screen"] = screen_owner()
    s["onboarding"] = onboarding_docs()
    return s

# ---------------- page ----------------

PAGE = r"""<!doctype html><html lang="ru"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#121620">
<meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Media Stick"><title>Media Stick</title>
