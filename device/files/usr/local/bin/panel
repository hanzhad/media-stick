<script>
const PAGE_VER='@@PAGE_VER@@';   // filled in by the server: a hash of this page
const $=id=>document.getElementById(id);
const wide=()=>matchMedia('(min-width:900px)').matches;
const esc=t=>String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;');
async function api(path,body){
  const o=body===undefined?{}:{method:'POST',headers:{'X-Panel':'1','Content-Type':'application/json'},body:JSON.stringify(body)};
  const r=await fetch(path,o); if(!r.ok){const e=new Error(await r.text());e.http=r.status;throw e} return r.json();
}
// Haptics. Android: navigator.vibrate. iPhone has no vibrate for pages, but since iOS 18 a
// switch-style checkbox ticks when it flips, so a hidden one is flipped instead.
const hapEl=(()=>{const l=document.createElement('label');l.setAttribute('aria-hidden','true');
  l.style.cssText='position:fixed;left:-200px;top:0;width:1px;height:1px;opacity:0;pointer-events:none';
  const i=document.createElement('input');i.type='checkbox';i.setAttribute('switch','');i.tabIndex=-1;
  l.appendChild(i);document.body.appendChild(l);return l})();
function buzz(){if(navigator.vibrate){navigator.vibrate(12);return}try{hapEl.click()}catch(e){}}
// The panel counts focus changes on the TV (fc). Arrows and swipes buzz only when the focus
// really moved there (none at the end of a row); the other keys buzz on the tap itself.
let fcSeen=null;
function fcNote(r){if(r&&r.kb)kbUi(r.kb);if(!r||typeof r.fc!=='number')return;if(fcSeen!==null&&r.fc!==fcSeen)buzz();fcSeen=r.fc}
const NAV=new Set(['up','down','left','right']);
// iPhone ticks only inside the tap itself (a tick after the reply is dropped), so there
// every key ticks on the tap; Android ticks arrows only when the focus really moved.
const late=!!navigator.vibrate;
let tickSoon=null;
function pressKey(a){
  const nav=late&&NAV.has(a);if(!nav)buzz();
  api('/api/key',{action:a}).then(r=>{if(nav)fcNote(r);else if(r&&typeof r.fc==='number')fcSeen=r.fc;if(r&&r.kb)kbUi(r.kb)}).catch(keyFailed);
  clearTimeout(tickSoon);tickSoon=setTimeout(tick,1200)   // playback may have started or stopped
}
document.querySelectorAll('[data-a]').forEach(b=>b.addEventListener('click',()=>pressKey(b.dataset.a)));
// Kodi's on-screen keyboard is slow to type on with a remote. While it is up the phone shows
// its own text box in the air pad's place: what is typed there shows in Kodi's field as it
// goes (and what is typed on the TV shows here), Done or the phone's Enter confirms it on the
// TV, Cancel closes it there. «Пульт» = back to the pad, type with the remote.
let kbOpen=false, kbHid=false, kbT=null, kbSent='', kbQuiet=0, kbTyped=0, kbPoll=null, kbPb=false, kbMan=false;
function kbPolling(on){
  clearInterval(kbPoll);kbPoll=null;
  if(on)kbPoll=setInterval(()=>{if(kbPb||document.hidden)return;kbPb=true;
    api('/api/focus').then(r=>kbUi(r&&r.kb||null)).catch(()=>{}).finally(()=>kbPb=false)},700)
}
function kbUi(k){
  if(performance.now()<kbQuiet)return;   // a reply from before Done / Cancel
  const box=$('kb'), inp=$('kb-in');
  if(!k&&kbMan)return;   // the manual overlay stays until it is closed
  if(!k){
    if(kbOpen&&document.activeElement===inp)inp.blur();
    kbOpen=kbHid=false;box.classList.add('hide');box.closest('.rc').classList.remove('kbon');kbPolling(false);return
  }
  if(kbHid)return;
  if(kbMan){kbMan=false;kbOpen=false;$('kb-x').textContent='Пульт';$('kb-c').classList.remove('hide')}   // the TV opened its own keyboard: it takes over
  $('kb-t').textContent=k.title||'Ввод на телевизоре';
  inp.inputMode=k.num?'numeric':'text';
  // the TV says "type on your phone": the box is on the remote card (Кнопки), so go there from any other tab or mode
  if(!kbOpen&&!wide()&&(tab!=='remote'||mode==='screen')){setMode('keys');const g=document.querySelector('[data-go=remote]');if(g)g.click()}
  if(!kbOpen){kbOpen=true;inp.value=kbSent=k.text||'';box.classList.remove('hide');box.closest('.rc').classList.add('kbon');kbPolling(true)}
  else if((k.text||'')!==inp.value&&!kbT&&performance.now()-kbTyped>1200)inp.value=kbSent=k.text||''
}
function kbSend(done){
  clearTimeout(kbT);kbT=null;const v=$('kb-in').value;
  if(!done&&v===kbSent)return;kbSent=v;
  api('/api/text',{text:v,done:!!done}).catch(keyFailed)
}
function kbClose(){kbMan=false;kbUi(null);kbQuiet=performance.now()+1500;clearTimeout(tickSoon);tickSoon=setTimeout(tick,1600)}
$('kb-in').addEventListener('input',()=>{kbTyped=performance.now();clearTimeout(kbT);kbT=setTimeout(()=>kbSend(false),150)});
$('kb-in').addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();buzz();kbSend(true);kbClose()}});
$('kb-ok').addEventListener('click',()=>{buzz();kbSend(true);kbClose()});
$('kb-c').addEventListener('click',()=>{buzz();clearTimeout(kbT);api('/api/key',{action:'back'}).catch(keyFailed);kbClose()});
$('kb-x').addEventListener('click',()=>{if(kbMan){kbMan=false;kbOpen=false;$('kb-in').blur();$('kb').classList.add('hide');$('kb').closest('.rc').classList.remove('kbon');return}kbHid=true;$('kb-in').blur();$('kb').classList.add('hide');$('kb').closest('.rc').classList.remove('kbon');kbPolling(false)});
// «Текст»: the same overlay as when the TV asks for text, opened by hand (it types into whatever has focus on the TV)
function kbManual(){
  if(kbOpen)return;
  const box=$('kb'), inp=$('kb-in');
  kbMan=true;kbHid=false;kbOpen=true;
  $('kb-t').textContent='Текст на ТВ';$('kb-x').textContent='Закрыть';$('kb-c').classList.add('hide');
  inp.inputMode='text';inp.value=kbSent='';
  box.classList.remove('hide');box.closest('.rc').classList.add('kbon');inp.focus()
}
$('txt-open').addEventListener('click',()=>{buzz();kbManual()});
function keysUi(dead){
  const d=new Set(dead||[]);
  document.querySelectorAll('button[data-a]').forEach(b=>{b.disabled=d.has(b.dataset.a)})
}
document.addEventListener('touchstart',()=>{},{passive:true});  // iOS: enables :active
const lsGet=k=>{try{return localStorage.getItem(k)}catch(e){return null}};
const lsSet=(k,v)=>{try{localStorage.setItem(k,v)}catch(e){}};
const TABS=['watch','remote','settings'], MODES=['keys','air','screen'];
let tab='watch', mode='keys', httpsUrl='';
const screenOn=()=>tab==='remote'&&mode==='screen';
// the picture runs only while it is on a phone's screen; a computer shows one still frame
function screenSync(){if(!wide())setLive(screenOn())}
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>{
  const again=tab==='settings'&&b.dataset.go==='settings';
  tab=TABS.includes(b.dataset.go)?b.dataset.go:'watch';
  document.querySelectorAll('[data-go]').forEach(x=>x.classList.toggle('on',x===b));
  document.querySelectorAll('[data-tab]').forEach(s=>s.classList.toggle('hide',s.dataset.tab!==tab));
  if(tab!=='remote')airStop(true);
  lsSet('tab',tab);
  if(tab==='settings'){loadNets('w-ssid');httpsLoad()}
  if(again&&spage)spBack();
  else if(tab!=='settings'&&SP_OF[location.hash.replace(/[?].*$/,'').slice(1)]){   // a reload must not reopen the page
    history.replaceState(null,'',location.pathname+location.search);spPushed=false;setPage('')
  }
  screenSync()
}));
// The remote has three modes: the buttons, the air pointer (the pad in the D-pad's place) and the screen.
function setMode(m){
  if(!MODES.includes(m))m='keys';
  mode=m;lsSet('mode',m);
  $('t-remote').dataset.mode=m;
  document.querySelectorAll('.modes [data-m]').forEach(b=>{const on=b.dataset.m===m;b.classList.toggle('on',on);b.setAttribute('aria-selected',String(on))});
  if(m!=='air')airStop(true);
  airUi();screenSync()
}
document.querySelectorAll('.modes [data-m]').forEach(b=>b.addEventListener('click',()=>{buzz();setMode(b.dataset.m)}));
// Settings on a phone: the list, or one page of it (spage; '' = the list). A page has a hash, so the back button works.
const SP_HASH={acc:'accounts',lang:'language',wifi:'wifi',https:'https',info:'device',act:'maintenance'}, SP_OF={}, SP_ID={acc:'t-acc',lang:'t-lang',wifi:'t-wifi',https:'t-https',info:'t-info',act:'t-act'};
Object.keys(SP_HASH).forEach(k=>{SP_OF[SP_HASH[k]]=k});
let spage='', spPushed=false;
function setPage(p){
  spage=p;
  document.querySelectorAll('[data-spage]').forEach(s=>s.classList.toggle('sp-hide',s.dataset.spage!==p));
  $('t-setlist').classList.toggle('sp-hide',p!=='');
  if(!wide())window.scrollTo(0,0)
}
function openSettings(p){
  if(tab!=='settings')document.querySelector('[data-go=settings]').click();
  setPage(p);
  if(wide())setTimeout(()=>$(SP_ID[p]).scrollIntoView({behavior:'smooth',block:'start'}),150)
}
function goPage(p){spPushed=true;const h='#'+SP_HASH[p];if(location.hash===h)hashGo();else location.hash=h}
function spBack(){
  if(spPushed){spPushed=false;history.back();return}
  history.replaceState(null,'',location.pathname+location.search);setPage('')
}
document.querySelectorAll('.srow[data-sp]').forEach(b=>b.addEventListener('click',()=>{buzz();goPage(b.dataset.sp)}));
document.querySelectorAll('[data-spage]').forEach(s=>{
