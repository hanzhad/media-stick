  const step=airSw.side?SW_KEY_PX:SW_WHEEL_PX, n=Math.trunc(airSw.acc/step);
  if(!n)return;
  airSw.acc-=n*step;
  if(airSw.side){kpend+=n;flushKeys()}else{wpend-=n;flushWheel()}
});
airPadUi();
