  hd.className='sp-head';b.className='btn sm';b.textContent='‹ Настройки';b.addEventListener('click',spBack);hd.append(b);s.prepend(hd)});
function openAccounts(){goPage('acc')}
// The one toast of the page (Смотреть uses it too). A key that did not get through says why, at most once in 2 s.
let toastT=null, failAt=0;
function toast(text){const e=$('toast');e.textContent=text;e.classList.remove('hide');clearTimeout(toastT);toastT=setTimeout(()=>e.classList.add('hide'),Math.min(7000,1500+text.length*50))}   // a long text stays longer
function tvErr(e){
  if(!e||!e.http)return 'ТВ не ответил';
  let m=e.message;try{m=JSON.parse(m).error||m}catch(_){}
  return m&&m.length<=140?m:'ТВ не ответил'
}
function keyFailed(e){const now=Date.now();if(now-failAt<2000)return;failAt=now;toast(tvErr(e))}
// keyboard on a computer drives Kodi like a remote
const KEYS={ArrowUp:'up',ArrowDown:'down',ArrowLeft:'left',ArrowRight:'right',Enter:'select',Backspace:'back',Escape:'back',' ':'playpause',c:'contextmenu',i:'info',h:'home','+':'volumeup','-':'volumedown',m:'mute'};
document.addEventListener('keydown',e=>{if(e.target.tagName==='INPUT'||e.target.tagName==='SELECT')return;const a=KEYS[e.key];if(a){e.preventDefault();api('/api/key',{action:a}).catch(()=>{})}});

function act(what){api('/api/'+what,{}).then(()=>toast(what==='reboot'?'Перезагружаю…':'Обновление запущено')).catch(e=>toast(tvErr(e)))}
// Two taps instead of confirm(): embedded browsers (the Claude app's included) refuse
// dialogs silently, and a button that asks first would then do nothing.
const armedAt={};
function armed(id,label){const b=$(id),now=Date.now();
  if(armedAt[id]&&now-armedAt[id]<4000){armedAt[id]=0;b.textContent=b.dataset.t;return true}
  armedAt[id]=now;b.dataset.t=b.dataset.t||b.textContent;b.textContent=label;
  setTimeout(()=>{if(armedAt[id]===now){armedAt[id]=0;b.textContent=b.dataset.t}},4000);return false}

async function loadNets(sel){
  const s=$(sel); s.innerHTML='<option>сканирую…</option>';
  try{const n=await api('/api/wifi/scan');
    s.innerHTML=n.map(x=>`<option value="${x.ssid.replace(/"/g,'&quot;')}">${x.ssid.replace(/</g,'&lt;')} (${x.signal}%)</option>`).join('')||'<option value="">— не найдено —</option>';
  }catch(e){s.innerHTML='<option value="">ошибка</option>'}
}
async function wifiConnect(){
  const ssid=$('s-manual').value.trim()||$('s-ssid').value;
  if(!ssid){show('s-msg','Выберите сеть');return}
  show('s-msg','Подключаюсь… точка доступа пропадёт, смотрите на телевизор.');
  api('/api/wifi/connect',{ssid,psk:$('s-psk').value,country:$('s-country').value}).catch(()=>{});
}
async function wifiChange(){
  const ssid=$('w-ssid').value; if(!ssid)return;
  const psk=$('w-psk').value;
  if(psk&&(psk.length<8||psk.length>63)){show('w-msg','Пароль Wi-Fi — от 8 до 63 символов.');return}
  if(!armed('w-btn','Нажмите ещё раз, чтобы сменить')){show('w-msg','Приставка перейдёт на «'+ssid+'». Подключение займёт до минуты.');return}
  show('w-msg','Подключаюсь к «'+ssid+'»… до минуты.');
  try{await api('/api/wifi/connect',{ssid,psk})}
  catch(e){hideMsg('w-msg');toast('Не отправилось: '+tvErr(e));return}
  $('w-psk').value='';
  for(let i=0;i<25;i++){
    await new Promise(r=>setTimeout(r,3000));
    try{const s=await api('/api/status');
      if(s.wifi.ssid===ssid){hideMsg('w-msg');toast('Подключено к «'+ssid+'». Адрес: '+(s.ip||[]).join(', '));return}
      if(i>15&&!s.wifi.ssid){hideMsg('w-msg');toast('Не получилось подключиться к «'+ssid+'». Проверьте пароль.');return}
    }catch(e){}
  }
  hideMsg('w-msg');toast('Нет ответа. Если приставка ушла в другую сеть, откройте http://mediastick.local из неё.');
}
function show(id,t){const m=$(id);m.textContent=t;m.classList.remove('hide')}
function hideMsg(id){$(id).classList.add('hide')}

const dot=ok=>'<span class="dot'+(ok?'':' bad')+'"></span>';
// «О приставке» in plain words. All of it is formatted here, from the status as it is.
const ruDur=mins=>{
  if(mins<1)return 'меньше минуты';
  const d=Math.floor(mins/1440), h=Math.floor(mins%1440/60), m=mins%60, p=[];
  if(d)p.push(d+' дн');if(h)p.push(h+' ч');if(m)p.push(m+' мин');
  return p.join(' ')
};
// `uptime -p`: "1 hour, 3 minutes" (also weeks and days)
function ruUptime(up){
  let m=0;
  String(up||'').replace(/(\d+)\s+(week|day|hour|minute)s?/g,(x,n,k)=>{m+=n*({week:10080,day:1440,hour:60,minute:1})[k];return x});
  return ruDur(m)
}
// minutes to the next check (the server counts them, systemd's clock is the box's own) and the clock time systemd gives
function ruNextCheck(next,mins){
  if(mins==null)return '—';
  if(mins<1)return 'сейчас';
  if(mins<60)return 'через '+mins+' мин';
  if(mins<1440)return 'через '+Math.round(mins/60)+' ч';
  const c=/(\d\d:\d\d):\d\d/.exec(next||''), days=Math.floor(mins/1440);
  return days<2&&c?'завтра в '+c[1]:'через '+days+' дн'
}
// minutes since the last check finished
function ruAgo(mins){
  if(mins==null)return '—';
  if(mins<1)return 'только что';
  if(mins<60)return mins+' мин назад';
  if(mins<1440)return Math.floor(mins/60)+' ч назад';
  return Math.floor(mins/1440)+' дн назад'
}
const ruDate=v=>{const m=/^(\d{4})-(\d\d)-(\d\d)$/.exec(v||'');return m?m[3]+'.'+m[2]+'.'+m[1]:''};
// vcgencmd get_throttled, never shown as hex. Now: 0x1 under-voltage, 0x2 frequency capped, 0x4 throttled (0x8, the soft
// temperature limit, is the temperature's business). Since the start: the same bits shifted by 16 (0x10000 and up).
const POWER_NOW=0x1|0x2|0x4, POWER_PAST=0x10000|0x20000|0x40000|0x80000;
const powerBits=s=>{const t=parseInt(s.throttled,16);return isNaN(t)?null:t};
const powerState=s=>{const t=powerBits(s);return t===null?null:(t&POWER_NOW)!==0};   // true = weak right now, null = unknown
const powerPast=s=>{const t=powerBits(s);return t!==null&&(t&POWER_PAST)!==0&&(t&POWER_NOW)===0};
const tempC=s=>parseFloat(s.temp)||0;
const HOT_C=75;
const needAttention=s=>powerState(s)===true||tempC(s)>HOT_C||s.disk_free_gb<1;
const dash=(v,html)=>v?html:'—';
const fmt=s=>{
  const cm=String(s.commit||''), sp=cm.indexOf(' '), hash=sp<0?cm:cm.slice(0,sp), subject=sp<0?'':cm.slice(sp+1), pw=powerState(s);
  return [
 ['Сеть',dot(s.wifi.online)+esc(s.wifi.ssid||'кабель')+' · '+esc((s.ip||[]).join(', '))],
 ['ТВ',s.kodi==='up'?(s.playing?'<svg class="i s"><use href="#i-play"/></svg> '+esc(s.playing):'работает'):dot(false)+'не отвечает'],
 ['Температура',dash(s.temp,esc(s.temp)+(tempC(s)>HOT_C?' · '+dot(false)+'высокая':''))],
 ['Питание',pw===null?'нет данных':pw?dot(false)+'слабый блок питания — приставка может тормозить':dot(true)+'в норме'+(powerPast(s)?'<span class="dsub">были просадки питания с момента включения</span>':'')],
 ['Память',s.mem_free_mb+' МБ свободно'],
 ['Диск',s.disk_free_gb+' ГБ свободно'],
 ['Работает',esc(ruUptime(s.uptime))],
 ['Версия',dash(hash,esc(hash)+(s.commit_date?' · '+esc(ruDate(s.commit_date)):'')+(s.bad_commit?' '+dot(false)+'откат с '+esc(s.bad_commit):'')+(subject?'<span class="dsub">'+esc(subject)+'</span>':''))],
 ['Обновление',esc(ruNextCheck(s.next_update,s.next_update_min))+(s.last_check_min==null?'':'<span class="dsub">проверено '+esc(ruAgo(s.last_check_min))+'</span>')],
].map(([k,v])=>`<dt>${k}</dt><dd>${v}</dd>`).join('')};
// the rows of the settings list: a short state on the right of each
function setRows(s){
  s=s||lastStatus;if(!s)return;
  const v=(id,text)=>{$(id).textContent=text};
  v('sv-acc',window.accRowText?accRowText():'');
  v('sv-wifi',s.wifi.ssid||'кабель');
  v('sv-lang',window.langRowText?langRowText(s):'');
  v('sv-https',HTTPS_RE.test(httpsUrl)?'включено':'выключено');
  v('sv-act',s.last_check_min==null?'—':'проверено '+ruAgo(s.last_check_min));
  v('act-last','Автообновление: '+(s.last_check_min==null?'ещё не проверяло с включения':'проверено '+ruAgo(s.last_check_min))+'. '+(s.next_update_min==null?'':ruNextCheck(s.next_update,s.next_update_min)==='сейчас'?'Следующая проверка сейчас.':'Следующая проверка '+ruNextCheck(s.next_update,s.next_update_min)+'.'));
  const need=needAttention(s);v('sv-info',need?'нужно внимание':'всё в порядке');$('sv-info').classList.toggle('warnt',need)
}

// The header says what the TV is doing, not the Wi-Fi (that is under «О приставке»): the dot is green when
// the TV answers, amber when a cast or a web app has the TV, red when it does not answer or the box is out of reach.
// `now` is what Смотреть knows of the player (speed 0 = paused); the status alone knows only the title.
const TV_BUSY={miracast:'ТВ занят трансляцией с компьютера',airplay:'ТВ занят трансляцией AirPlay','web-app':'На ТВ открыто приложение'};
function tvState(s,now){
  if(!s)return {dot:'bad',text:'нет связи с приставкой'};
  if(TV_BUSY[s.screen])return {dot:'warn',text:TV_BUSY[s.screen]};
  if(s.kodi!=='up')return {dot:'bad',text:'ТВ не отвечает'};
  if(s.playing)return {dot:'ok',text:(now&&now.playing&&now.speed===0?'Пауза: ':'Играет: ')+s.playing};   // the state first: the pill cuts the title, not it
  return {dot:'ok',text:'ТВ свободен'}
}
let lastStatus=null;
function hdrDraw(){const v=tvState(lastStatus,window.wtLast);$('hdr-dot').className='dot'+(v.dot==='ok'?'':' '+v.dot);$('hdr-t').textContent=v.text}
// A phone keeps a page (above all a home-screen app) in memory for days, so after an update
// it would go on running the old code. The status carries the hash of the page the panel
// serves now; when it differs, reload, but not while a finger is on the air pad or the
// keyboard is open, and at most once a minute.
function pageCheck(v){
  if(!v||v===PAGE_VER||PAGE_VER.charAt(0)==='@'||airHeld)return;
  const a=document.activeElement;if(a&&(a.tagName==='INPUT'||a.tagName==='SELECT'))return;
  try{const t=+sessionStorage.getItem('reloadAt')||0;if(Date.now()-t<60000)return;sessionStorage.setItem('reloadAt',String(Date.now()))}catch(e){}
  location.reload()
}
document.addEventListener('visibilitychange',()=>{if(!document.hidden)tick()});   // back to the app: check at once
async function tick(){
  try{const s=await api('/api/status');
    if(s.wifi.ap){ if($('setup').classList.contains('hide')){$('app').classList.add('hide');$('setup').classList.remove('hide');loadNets('s-ssid')} }
    else{$('setup').classList.add('hide');$('app').classList.remove('hide')}
    lastStatus=s;hdrDraw(); $('info').innerHTML=fmt(s);
    httpsUrl=s.https_url||'';setRows(s); httpsCheck(); airUi(); keysUi(s.dead);kbUi(s.kb);
    pageCheck(s.page);
    if(window.accNote)accNote(s.signin);
    if(window.obNote)obNote(s.onboarding);
  }catch(e){lastStatus=null;hdrDraw()}
}
tick(); setInterval(tick,5000);

// The screen costs Kodi a full-resolution render per frame, so it runs only when asked
// for: the button (or opening the tab on a phone), about one frame a second, off again
// after two minutes or when the page is hidden.
const LIVE_MAX_MS=120000, FRAME_GAP_MS=1000;
let live=false, liveSince=0, shotBusy=false, liveTimer=null, gotFrame=false, failed=0, redo=false;
function shotState(t,bad){ // over the placeholder until a frame exists, under the picture after
  if(!gotFrame)$('shot-s').textContent=t;
  const c=$('shot-ms'); c.textContent=gotFrame?t:''; c.classList.toggle('bad',!!bad)
}
let full=false;
function fullOn(on){
  full=on;$('shot-box').classList.toggle('full',on);document.body.classList.toggle('fs',on);
  $('fbar').classList.toggle('hide',!on);$('fhint').classList.toggle('hide',!on);
  if(on&&!live)setLive(true);
  const d=document, el=d.documentElement;   // where the browser can (Android, computers), real full screen
  try{if(on&&el.requestFullscreen&&!d.fullscreenElement)el.requestFullscreen()   // and a real landscape lock
        .then(()=>screen.orientation&&screen.orientation.lock&&screen.orientation.lock('landscape')).catch(()=>{});
      else if(!on&&d.fullscreenElement)d.exitFullscreen().catch(()=>{})}catch(e){}
  if(on)addEventListener('devicemotion',rotMotion);else removeEventListener('devicemotion',rotMotion);
  rotApply()
}
// Which way to turn: +90 = the phone's top to the left (the usual way), -90 = to the right.
// Gravity tells it where the motion sensor is open (Android; iPhone after the air mouse got its
// permission); the flip button covers the rest and, when gravity was seen, also learns its sign.
let rotDir=1, rotCal=1, rotSeen=0;
try{rotDir=localStorage.getItem('fsdir')==='-1'?-1:1;rotCal=localStorage.getItem('fscal')==='-1'?-1:1}catch(e){}
const touchy=matchMedia('(pointer:coarse)').matches;
let rotDeg=0;
function rotApply(){
  const b=$('shot-box'), on=full&&touchy&&innerHeight>innerWidth;
  rotDeg=on?90*rotDir:0;
  b.classList.toggle('rot',on);document.body.classList.toggle('rot',on);
  document.body.classList.toggle('rotm',on&&rotDir<0);
  document.documentElement.style.setProperty('--r',rotDeg+'deg');
  b.style.width=on?innerHeight+'px':'';b.style.height=on?innerWidth+'px':'';
}
function rotFlip(){
  rotDir=-rotDir;buzz();
  if(Date.now()-rotSeen<3000)rotCal=-rotCal;   // gravity said the other way: its sign is the other way here
  try{localStorage.setItem('fsdir',String(rotDir));localStorage.setItem('fscal',String(rotCal))}catch(e){}
  rotApply()
}
function rotMotion(e){
  const a=e.accelerationIncludingGravity;if(!a||a.x==null||a.y==null)return;
  if(Math.abs(a.x)<7||Math.abs(a.x)<Math.abs(a.y)*2)return;   // not clearly on its side
  rotSeen=Date.now();
  const d=(a.x>0?1:-1)*rotCal;
  if(d!==rotDir){rotDir=d;try{localStorage.setItem('fsdir',String(d))}catch(_){}rotApply()}
}
addEventListener('resize',()=>{if(full)rotApply()});
document.addEventListener('fullscreenchange',()=>{if(!document.fullscreenElement&&full)fullOn(false)});
document.addEventListener('keydown',e=>{if(full&&e.key==='Escape'){e.stopImmediatePropagation();fullOn(false)}},true);
function setLive(on){
  live=on; liveSince=Date.now();
  $('live-t').textContent=on?'Стоп':'Показать';
  $('live-ic').setAttribute('href',on?'#i-stop':'#i-play');
  if(on){failed=0;shotState('Загрузка…');frame()}
  else{clearTimeout(liveTimer);shotState(gotFrame?'Остановлено':'Нажмите «Показать»')}
}
function frame(){
  if(shotBusy){redo=true;return}
  shotBusy=true; const t=Date.now(), im=new Image();
  im.onload=()=>{shotBusy=false;failed=0;gotFrame=true;$('shot').src=im.src;$('shot-box').classList.add('has');
    if(live)shotState((Date.now()-t)+' мс');
    clearTimeout(liveTimer);
    if(live&&!document.hidden&&Date.now()-liveSince<LIVE_MAX_MS)liveTimer=setTimeout(frame,FRAME_GAP_MS);
    else if(live)setLive(false);
    if(redo){redo=false;setTimeout(frame,0)}};
  // the first frame after idle can be slow or fail once: retry before giving up
  im.onerror=()=>{shotBusy=false;redo=false;
    if(!gotFrame&&failed++<1){shotState('Загрузка…');setTimeout(frame,800);return}
    shotState('ТВ не отвечает',true);if(live)liveTimer=setTimeout(frame,3000)};
  im.src='/shot.png?'+t;
}
document.addEventListener('visibilitychange',()=>{if(document.hidden&&live)setLive(false)});

// Tap on the picture = click at that spot on the TV; hold = right click (Kodi's context
// menu); drag up or down = scroll (wheel at that spot, a step per 18 px); drag sideways =
// left/right keys, one per half a card, so a short flick goes far (the wheel is no good on
// the home carousel: Kodi focuses whatever card is under the cursor). Spots are fractions
// of the picture itself, not of its box (object-fit leaves bars). A fresh frame follows
// each action, live or not.
const LONG_MS=500, SLOP_PX=10, STEP_PX=18, REFRESH_MS=380;
const HINT=$('shot-h').textContent, box=$('shot-box');
let ptrNote=null, g=null, lastType='', spend=0, sbusy=false, spos=null;
const ptr=(action,x,y,dy)=>api('/api/pointer',dy===undefined?{action,x,y}:{action,x,y,dy});
function ptrErr(e){
  const h=$('shot-h'); h.textContent=e.message||'Не получилось'; h.classList.add('bad');
  clearTimeout(ptrNote); ptrNote=setTimeout(()=>{h.textContent=HINT;h.classList.remove('bad')},4000)
}
// A screen point -> px in the picture box's own frame (the box may be turned by rotDeg about
// its centre). Everything below works in that frame, so a turned picture needs nothing else.
function loc(cx,cy){
  const r=box.getBoundingClientRect(), W=box.clientWidth, H=box.clientHeight,
        vx=cx-(r.left+r.width/2), vy=cy-(r.top+r.height/2);
  const q=rotDeg===90?[vy,-vx]:rotDeg===-90?[-vy,vx]:[vx,vy];
  return {x:q[0]+W/2,y:q[1]+H/2}
}
function spot(lx,ly){
  const im=$('shot'), w=im.naturalWidth, h=im.naturalHeight;
  if(!gotFrame||!w||!h)return null;
  const W=box.clientWidth, H=box.clientHeight, k=Math.min(W/w,H/h), dw=w*k, dh=h*k,
        x=(lx-(W-dw)/2)/dw, y=(ly-(H-dh)/2)/dh;
  return x<0||x>1||y<0||y>1?null:{x,y}
}
function ripple(lx,ly,cls){
  const d=document.createElement('i');
  d.className='rip'+(cls?' '+cls:''); d.style.left=lx+'px'; d.style.top=ly+'px';
  box.appendChild(d); setTimeout(()=>d.remove(),900)
}
function tap(action,cx,cy){
  const p=spot(cx,cy); if(!p)return;
  buzz(); ripple(cx,cy,action==='right'?'r':'');
  if(!live)setLive(true);  // the first tap also starts the live picture (same limits as the button)
  ptr(action,p.x,p.y).then(()=>setTimeout(frame,REFRESH_MS)).catch(ptrErr)
}
let kpend=0, kbusy=false;   // >0: right presses owed, <0: left
function flushKeys(){
  if(kbusy||!kpend)return;
  const right=kpend>0; kpend+=right?-1:1; kbusy=true;
  api('/api/key',{action:right?'right':'left'}).then(r=>{fcNote(r);if(screenOn()||full)setTimeout(frame,REFRESH_MS)}).catch(ptrErr)
    .finally(()=>{kbusy=false;flushKeys()})
}
function cardPx(){   // half a home-screen card (a card is about 252 of 1920 px) in picture pixels
  return Math.max(16,Math.min(box.clientWidth,box.clientHeight*16/9)*126/1920)
}
function flushScroll(){
  if(sbusy||!spend||!spos)return;
  const d=spend; spend=0; sbusy=true;
  ptr('scroll',spos.x,spos.y,d).then(()=>setTimeout(frame,REFRESH_MS)).catch(ptrErr)
    .finally(()=>{sbusy=false;flushScroll()})
}
box.addEventListener('pointerdown',e=>{
  lastType=e.pointerType;
  if(g||(e.pointerType==='mouse'&&e.button!==0))return;
  const q=loc(e.clientX,e.clientY);
  g={id:e.pointerId,x:q.x,y:q.y,lx:q.x,ly:q.y,acc:0,moved:false,scroll:false,side:false,long:false,t:0};
  try{box.setPointerCapture(e.pointerId)}catch(_){}
  // a mouse has its own right button (contextmenu below); only a finger needs the hold
  if(e.pointerType!=='mouse')g.t=setTimeout(()=>{if(g&&!g.moved){g.long=true;tap('right',g.x,g.y)}},LONG_MS)
});
box.addEventListener('pointermove',e=>{
  if(!g||e.pointerId!==g.id)return;
  const q=loc(e.clientX,e.clientY), dx=q.x-g.x, dy=q.y-g.y;
  if(!g.moved&&Math.hypot(dx,dy)>SLOP_PX){
    g.moved=true; clearTimeout(g.t);
    const p=spot(g.x,g.y);
    if(p&&Math.abs(dy)>Math.abs(dx)){g.scroll=true;spos=p;if(!live)setLive(true)}
    else if(p){g.side=true;g.lx=g.x;if(!live)setLive(true)}
  }
  if(g.side){  // finger left = the row moves left = the next card (right key)
    g.acc+=q.x-g.lx; g.lx=q.x;
    const c=cardPx(), n=Math.trunc(g.acc/c);
    if(n){g.acc-=n*c;kpend-=n;flushKeys()}
  }
  if(g.scroll){  // finger down = wheel up (the view follows the finger)
    g.acc+=q.y-g.ly; g.ly=q.y;
    const n=Math.trunc(g.acc/STEP_PX);
    if(n){g.acc-=n*STEP_PX;spend+=n;flushScroll()}
  }
});
function endGesture(e,cancel){
  if(!g||e.pointerId!==g.id)return;
  clearTimeout(g.t); const s=g; g=null;
  if(!cancel&&!s.moved&&!s.long)tap('click',s.x,s.y)
}
box.addEventListener('pointerup',e=>endGesture(e,false));
box.addEventListener('pointercancel',e=>endGesture(e,true));
box.addEventListener('contextmenu',e=>{e.preventDefault();if(lastType==='mouse'){const q=loc(e.clientX,e.clientY);tap('right',q.x,q.y)}});
if(wide()){shotState('Загрузка…');frame()}  // one still frame on a computer, live only on request

// ---- HTTPS card (Настройки). The helper does the work as root; the token is typed here,
// goes to the panel once and is never shown again, not even while the card is configured.
const TOKRE=/^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$/i, SUBRE=/^[a-z0-9-]{1,63}$/;
const TOKFORM='xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx';
const subOf=v=>v.trim().toLowerCase().replace(/^https?:[/][/]/,'').replace(/[/]$/,'').replace(/[.]duckdns[.]org$/,'');
let hSug='', hTimer=null, hDeep='', hLoaded=false;
function hCheck(){
  const tok=$('h-tok').value.trim(), ok=TOKRE.test(tok), th=$('h-th');
  th.textContent=!tok?'Токен — длинный код вида '+TOKFORM:ok?'Токен похож на настоящий':'Это не похоже на токен DuckDNS: он выглядит как '+TOKFORM;
  th.classList.toggle('bad',!!tok&&!ok);
  $('h-btn').disabled=!(SUBRE.test(subOf($('h-dom').value))&&ok)
}
$('h-dom').addEventListener('input',hCheck);$('h-tok').addEventListener('input',hCheck);
if(navigator.clipboard&&navigator.clipboard.readText)$('h-paste').classList.remove('hide');
function pasteTok(){
  navigator.clipboard.readText().then(t=>{$('h-tok').value=t.trim();hCheck()})
    .catch(()=>{$('h-th').textContent='Браузер не дал прочитать буфер: вставьте токен в поле вручную';$('h-th').classList.add('bad')})
}
// On plain http navigator.clipboard does not exist: a hidden textarea and execCommand do the copy.
function copyText(t){
  if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(t).then(()=>true,()=>false);
  const a=document.createElement('textarea');
  a.value=t;a.setAttribute('readonly','');a.style.cssText='position:fixed;left:-9999px;top:0;opacity:0';
  document.body.appendChild(a);a.select();a.setSelectionRange(0,t.length);
  let ok=false;try{ok=document.execCommand('copy')}catch(e){}
  a.remove();return Promise.resolve(ok)
}
function copySug(){
  const b=$('h-copy');buzz();
  copyText(hSug).then(ok=>{b.textContent=ok?'Скопировано':'Выделите имя вручную';setTimeout(()=>b.textContent='Скопировать',1800)})
}
function hSuggest(name){
  hSug=name;
  $('h-sugbox').classList.toggle('hide',!name);$('h-sug').textContent=name;
  $('h-s2').textContent=name?'Добавьте на duckdns.org поддомен:':'Добавьте любой свободный поддомен.'
}
const H_TEXT={'updating-dns':'Обновляю адрес в DuckDNS…','issuing':'Получаю сертификат. Это занимает 1–3 минуты, можно подождать на этой странице.'};
function hView(s){
  const cfg=!!s.configured;
  hSuggest(s.suggest||'');
  $('h-setup').classList.toggle('hide',cfg);
  $('h-off').classList.toggle('hide',!cfg);
  const open=cfg&&s.state==='ok'&&/^https:[/][/][a-z0-9.-]+[/]?$/.test(s.url||'');
  $('h-open').classList.toggle('hide',!open);
  if(open)$('h-link').href=s.url;
  if(!cfg){
    if(!$('h-dom').value)$('h-dom').value=hDeep||s.suggest||'';
    if(!hLoaded)$('h-msg').classList.add('hide');
    hCheck()
  }else if(s.state==='ok'){
    const d=s.cert_days_left;
    show('h-msg','Работает: '+s.url+(d==null?'':'. Сертификат действует ещё '+d+' дн., продлевается сам.'))
  }else if(s.state==='error'){
    show('h-msg','Не получилось: '+(s.message||'неизвестная ошибка')+'. Повторю сам в течение суток; можно «Отключить» и начать заново.')
  }else show('h-msg',H_TEXT[s.state]||'Настраиваю…');
  hLoaded=true
}
// hWait: a restart of the panel is expected (it restarts itself the moment the certificate is
// ready, and after «Отключить»), so a failed request then means "wait", not "broken".
let hWait=false, hFails=0, hWaitMsg='Панель перезапускается…';
async function httpsLoad(){
  clearTimeout(hTimer);
  try{
    const s=await api('/api/https');hFails=0;const was=hWait;hView(s);
    if(was&&s.state==='ok')toast('HTTPS включён');
    hWait=s.state==='updating-dns'||s.state==='issuing';
    if(hWait)hWaitMsg='Сертификат готов, панель перезапускается…';
    if(hWait)hTimer=setTimeout(httpsLoad,3000)
  }catch(e){
    if(hWait&&++hFails<=20){show('h-msg',hWaitMsg);hTimer=setTimeout(httpsLoad,3000);return}
    hWait=false;show('h-msg','Нет связи с панелью: '+e.message)
  }
}
async function httpsSet(){
  const domain=subOf($('h-dom').value), token=$('h-tok').value.trim();
  if(!SUBRE.test(domain)||!TOKRE.test(token))return;
  $('h-btn').disabled=true;show('h-msg','Отправляю…');
  try{await api('/api/https',{domain,token})}
  catch(e){hideMsg('h-msg');toast('Не получилось: '+tvErr(e).split(token).join('***'));hCheck();return}
  $('h-tok').value='';hCheck();hWait=true;hFails=0;httpsLoad()
}
