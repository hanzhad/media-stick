# ---------------- server ----------------

def json_body(h):
    n = int(h.headers.get("Content-Length") or 0)
    if n > 8192:   # not read to the end: this connection cannot carry another request
        h.close_connection = True
    try:
        return json.loads(h.rfile.read(min(n, 8192)) or b"{}")
    except ValueError:
        return {}

class H(BaseHTTPRequestHandler):
    # Keep-alive: the air mouse sends ~30 requests a second and the focus poll ~8; with
    # HTTP/1.0 each was a new connection and, over HTTPS, a new TLS handshake, which is real
    # work for a Pi 3. Every reply carries Content-Length; an idle connection is dropped
    # after 20 s.
    protocol_version = "HTTP/1.1"
    timeout = 20

    def log_message(self, *a):  # never log requests: bodies may carry a Wi-Fi password
        pass

    def send(self, body, ctype="application/json", code=200):
        if isinstance(body, (dict, list)):
            body = json.dumps(body)
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    secure = False   # True in the HTTPS listener's handler class

    def host_ok(self):
        host = self.headers.get("Host", "")
        if HOST_OK.match(host):
            return True
        pub = public_host()
        return bool(pub) and host_name(host) == pub

    def redirect_to_https(self):
        """Plain http addressed by our public name -> the same path on https, but only
        while the HTTPS listener is really up (else the redirect would lead nowhere)."""
        pub = public_host()
        if self.secure or not pub or not https_state["up"] or host_name(self.headers.get("Host", "")) != pub:
            return False
        path = self.path if self.path.startswith("/") else "/"
        self.send_response(301 if self.command in ("GET", "HEAD") else 308)
        self.send_header("Location", "https://" + pub + path)
        self.send_header("Content-Length", "0")
        self.end_headers()
        return True

    def https_set(self, b):
        """POST /api/https {domain, token}: the helper validates and stores them."""
        if not isinstance(b, dict):
            return self.send("bad request", "text/plain", 400)
        req = json.dumps({"domain": str(b.get("domain", "")), "token": str(b.get("token", ""))})
        rc, out = run(HTTPS_HELPER + ["set"], stdin=req, timeout=20)
        https_cache["t"] = 0.0
        if rc != 0:
            return self.send(TOKEN_RE.sub("***", out) or "Не получилось сохранить", "text/plain", 400)
        return self.send({"ok": True})

    def pointer_post(self, b):
        """POST /api/pointer {action, x, y, dy}: x and y are fractions 0..1 of the screen."""
        if not isinstance(b, dict):
            return self.send("bad request", "text/plain", 400)
        a = b.get("action", "click")
        if a not in POINTER_ACTIONS:
            return self.send("unknown action", "text/plain", 400)

        def num(v):
            ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
            return float(v) if ok else None

        wheel = 0
        if a == "move_by":   # air mouse: dx, dy are fractions of the screen, at most 0.25 per call
            dx, dy = num(b.get("dx")), num(b.get("dy"))
            if dx is None or dy is None:
                return self.send("dx and dy: numbers", "text/plain", 400)
            fx, fy = min(0.25, max(-0.25, dx)), min(0.25, max(-0.25, dy))
        else:
            fx, fy = num(b.get("x")), num(b.get("y"))
            has_xy = "x" in b or "y" in b
            # {"here": true} clicks where the pointer already is (the air mouse's tap)
            here = b.get("here") is True and a in ("click", "right") and not has_xy
            if not here and (has_xy or a != "scroll") and (fx is None or fy is None):
                return self.send("x and y: numbers 0..1", "text/plain", 400)
            if fx is not None:
                fx, fy = min(1.0, max(0.0, fx)), min(1.0, max(0.0, fy))
        if a == "scroll":
            dy = num(b.get("dy"))
            if dy is None:
                return self.send("dy: a number", "text/plain", 400)
            wheel = int(max(-10, min(10, round(dy))))
        try:
            POINTER.act(a, fx, fy, wheel)
        except PointerUnavailable as e:
            return self.send("Указатель недоступен: %s" % e, "text/plain", 503)
        forget_shot()
        return self.send({"ok": True})

    def do_GET(self):
        if self.redirect_to_https():
            return
        if not self.host_ok():
            # hotspot mode: every name resolves here, so phones' captive-portal checks
            # land on us; send them to the page
            if wifi_status().get("ap"):
                self.send_response(302)
                self.send_header("Location", "http://10.42.0.1/")
                self.send_header("Content-Length", "0")
                self.end_headers()
                return
            return self.send("bad host", "text/plain", 421)
        p = self.path.split("?")[0]
        if p == "/":
            return self.send(PAGE, "text/html; charset=utf-8")
        if p == "/api/status":
            return self.send(panel_accounts.with_signin(status()))
        if p == "/api/accounts":
            return self.send(panel_accounts.view())
        if p == panel_watch.PREFIX + "art":      # an app's icon: bytes with a day's cache, not JSON
            code, headers, body = panel_watch.art_response(panel_watch.art(self.path, kodi),
                                                           self.headers.get("If-None-Match", ""))
            self.send_response(code)
            for name, value in headers:
                self.send_header(name, value)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if code != 304:
                self.wfile.write(body)
            return
        if p.startswith(panel_watch.PREFIX):
            body, code = panel_watch.get(self.path, kodi)
            return self.send(body, code=code)
        if p == "/api/https":
            return self.send(https_status())
        if p == "/api/focus":   # polled by the air pad while it is held
            return self.send({"fc": FOCUS.poll(), "kb": kb_now()})
        if p == "/api/wifi/scan":
            rc, out = run(["sudo", "-n", "/usr/local/bin/wifi-setup", "scan"], timeout=40)
            return self.send(out or "[]")
        if p == "/shot.png":
            try:
                return self.send(screenshot(), "image/png")
            except (OSError, TimeoutError) as e:
                return self.send(str(e), "text/plain", 503)
        # anything else (phone captive-portal probes on our own name): the page
        self.send(PAGE, "text/html; charset=utf-8")

    def do_POST(self):
        if self.redirect_to_https():
            return
        if not self.host_ok() or self.headers.get("X-Panel") != "1":
            return self.send("forbidden", "text/plain", 403)
        p = self.path.split("?")[0]
        b = json_body(self)
        if p == "/api/pointer":
            return self.pointer_post(b)
        if p.startswith(panel_accounts.PREFIX):
            body, code = panel_accounts.post(p, b, kodi)
            return self.send(body, code=code)
        if p.startswith(panel_watch.PREFIX):
            body, code = panel_watch.post(p, b, kodi)
            return self.send(body, code=code)
        if p == panel_lang.PATH:
            body, code = panel_lang.post(p, b, kodi)
            return self.send(body, code=code)
        try:
            if p == "/api/key":
                a = b.get("action")
                if web_app_on():
                    if a == "home":
                        run(["sudo", "-n", "systemctl", "stop", "web-app@*"])
                    elif a in WEB_KEYS:
                        web_key(WEB_KEYS[a])
                    elif a not in ACTIONS:
                        return self.send("unknown action", "text/plain", 400)
                    return self.send({"ok": True})
                if a != "home" and a not in ACTIONS:
                    return self.send("unknown action", "text/plain", 400)
                before = FOCUS.poll(0)
                status_cache["t"] = 0   # what plays may change: the next status looks again
                if a == "home":
                    kodi("GUI.ActivateWindow", {"window": "home"})
                else:
                    kodi("Input.ExecuteAction", {"action": key_action(a)})
                return self.send({"ok": True, "fc": FOCUS.after(before), "kb": kb_now()})
            if p == "/api/text" and web_app_on():
                web_type(str(b.get("text", ""))[:200])
                return self.send({"ok": True})
            if p == "/api/text":
                # done false: the text shows in Kodi's keyboard as it is typed on the phone
                kodi("Input.SendText", {"text": str(b.get("text", ""))[:200], "done": b.get("done", True) is not False})
                return self.send({"ok": True})
        except OSError:
            return self.send("ТВ не отвечает", "text/plain", 503)
        if p == "/api/https":
            return self.https_set(b)
        if p == "/api/https/clear":
            # answer first: the helper restarts this very panel
            self.send({"ok": True, "message": "HTTPS отключён, панель перезапускается."})
            https_cache["t"] = 0.0
            threading.Thread(target=run, args=(HTTPS_HELPER + ["clear"],), kwargs={"timeout": 60},
                             daemon=True).start()
            return
        if p == "/api/wifi/connect":
            req = json.dumps({"ssid": b.get("ssid", ""), "psk": b.get("psk", ""),
                              "country": b.get("country", "")})
            # answer first: the connect takes the hotspot (and maybe this page) away
            self.send({"ok": True, "message": "подключаюсь"})
            threading.Thread(target=run, args=(["sudo", "-n", "/usr/local/bin/wifi-setup", "connect"],),
                             kwargs={"stdin": req, "timeout": 120}, daemon=True).start()
            return
        if p == "/api/update":
            subprocess.Popen(["sudo", "-n", "systemctl", "start", "--no-block", "media-stick-update.service"])
            return self.send({"ok": True, "message": "Проверяю обновления. Если есть новая версия, она поставится за пару минут."})
        if p == "/api/reboot":
            self.send({"ok": True, "message": "Перезагружаюсь, вернусь через минуту."})
            subprocess.Popen(["sudo", "-n", "systemctl", "reboot"])
            return
        self.send("not found", "text/plain", 404)

class DualStack(ThreadingHTTPServer):
    """IPv6 and IPv4 on one socket: mediastick.local often resolves to IPv6 first."""
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()

class TLSServer(DualStack):
    """The same handler over TLS. The handshake runs in the request's own thread, not in
    accept(), so a client that stalls in it cannot hold up the others."""
    ctx = None

    def finish_request(self, request, client_address):
        request.settimeout(15)
        try:
            tls = self.ctx.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError):
            return
        try:
            self.RequestHandlerClass(tls, client_address, self)
        finally:
            try:
                tls.close()
            except OSError:
                pass

class HTTPSHandler(H):
    secure = True

def start_https():
    """Serve HTTPS on 443 too when media-stick-cert has published a certificate. Any
    failure leaves port 80 as it was."""
    if not (os.path.isfile(TLS_CRT) and os.path.isfile(TLS_KEY)):
        return
    try:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(TLS_CRT, TLS_KEY)
        srv = TLSServer(("::", HTTPS_PORT), HTTPSHandler)
    except (OSError, ssl.SSLError) as e:
        print("panel: HTTPS not started: %s" % e, file=sys.stderr, flush=True)
        return
    srv.ctx = ctx
    https_state["up"] = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()

SETTLE_EVERY = 5   # s between looks at a given-up sign-in with another account

def settle_loop():
    while True:
        time.sleep(SETTLE_EVERY)
        try:
            panel_accounts.settle(kodi)
        except Exception as e:
            print("panel: sign-in settle failed: %s" % e, file=sys.stderr, flush=True)

if __name__ == "__main__":
    os.makedirs(SHOTS, exist_ok=True)
    POINTER.start()
    threading.Thread(target=settle_loop, daemon=True).start()
    start_https()
    DualStack(("::", PORT), H).serve_forever()
