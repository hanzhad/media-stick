function airNote(t,bad){
  const h=$('air-h');h.textContent=t||AIR_HINT;h.classList.toggle('bad',!!bad);
  clearTimeout(airNoteT);if(t)airNoteT=setTimeout(()=>airNote(''),5000)
}
function airPump(){
  if(airBusy)return;
  const wait=AIR_GAP_MS-(performance.now()-airLast);
  if(wait>0){if(!airTimer)airTimer=setTimeout(()=>{airTimer=null;airPump()},wait);return}
  const cl=v=>Math.max(-AIR_MAX,Math.min(AIR_MAX,v));
  let body=null;
  if(Math.abs(airAcc.x)>1e-5||Math.abs(airAcc.y)>1e-5){
    const dx=cl(airAcc.x), dy=cl(airAcc.y);airAcc.x-=dx;airAcc.y-=dy;
    body={action:'move_by',dx,dy}
  }else if(airClick){airClick=false;body={action:'click',here:true}}
  if(!body)return;
  airBusy=true;airLast=performance.now();
  api('/api/pointer',body).then(()=>{if(body.action==='click'){if(live)setTimeout(frame,REFRESH_MS);clearTimeout(tickSoon);tickSoon=setTimeout(tick,1200)}})
    .catch(e=>{airAcc.x=airAcc.y=0;airClick=false;airLast=performance.now()+1000;airNote(e.message||'Не получилось',1)})
    .finally(()=>{airBusy=false;if(airClick||Math.abs(airAcc.x)>1e-5||Math.abs(airAcc.y)>1e-5)airPump()})
}
function onMotion(e){
  const r=e.rotationRate;
  if(!airHeld||!r||r.alpha==null||r.beta==null||r.gamma==null)return;
  const now=performance.now();airGot=true;
  if(airSw){airTPrev=now;return}   // the thumb is scrolling: the dot stays put
  let dt=airTPrev?(now-airTPrev)/1000:0;airTPrev=now;
  if(dt<=0)return;if(dt>0.1)dt=0.1;
  const dz=v=>Math.abs(v)<AIR_DZ?0:v-Math.sign(v)*AIR_DZ;
  // rotationRate per the spec (Chrome): alpha about the screen normal (z), beta about the
  // short axis (x), gamma about the long axis (y). iOS Safari labels them alpha = x, beta = y,
  // gamma = z. w = the turn rate as a vector in the phone's own frame, deg/s.
  const ios=airAskNeeded, w=ios?[r.alpha,r.beta,r.gamma]:[r.beta,r.gamma,r.alpha];
  // Like a laser pointer: the dot follows the aim, the line out of the top edge p = (0,1,0).
  // It swings at v = w x p = (-wz, 0, wx); a twist about the aim (wy) drops out, whatever
  // angle the phone is held at. v is split along the room's horizontal across the aim
  // (right = p x up) and the vertical across it (q = right x p). "Up" in the phone's frame
  // comes from gravity (smoothed accelerationIncludingGravity); its sign differs between
  // browsers, so it is fixed at each press from the screen side: while aiming, the screen
  // faces up or towards you, never the floor.
  let xr, yr;
  const a=e.accelerationIncludingGravity;
  if(a&&a.x!=null&&a.y!=null&&a.z!=null){
    const v=[a.x,a.y,a.z];
    if(!airG){airG=v;airGs=a.z<0?-1:1}else for(let i=0;i<3;i++)airG[i]+=0.15*(v[i]-airG[i]);
    const n=Math.hypot(airG[0],airG[1],airG[2]);
    if(n>3){
      const u=airG.map(c=>c*airGs/n);               // up, unit vector, phone frame
      let rx=u[2], rz=-u[0]; const rn=Math.hypot(rx,rz);   // right = top edge (0,1,0) x up
      if(rn>0.2){rx/=rn;rz/=rn;
        xr=w[0]*rz-w[2]*rx;                         // v.right, + = right
        yr=w[0]*rx+w[2]*rz}                         // v.q, + = up
    }
  }
  if(xr===undefined){xr=-w[2];yr=w[0]}              // no gravity (or aimed straight up): own axes
  const tx=dz(xr), ty=-dz(yr), sp=Math.hypot(tx,ty);   // deg/s; left and up are negative
  // Shake filter: smoothing follows the speed (a "1 euro" filter in spirit): a hand held
  // nearly still is smoothed hard, so the dot does not tremble; a quick swing almost not,
  // so it does not lag.
  const al=Math.min(0.8,0.12+sp/150);
  airSm.x+=al*(tx-airSm.x);airSm.y+=al*(ty-airSm.y);
  // Acceleration: slow turns move the dot less (precise), fast swings more (across the TV
  // without turning far); 0.6 below 8 deg/s up to 1.8 above 120, smoothly.
  const v=Math.hypot(airSm.x,airSm.y), q=Math.min(1,Math.max(0,(v-8)/112)), gain=0.6+1.2*q*q*(3-2*q);
  const k=gain*Math.pow(1.3,airK-9)/AIR_DEG_FULL;   // screen widths per degree
  airAcc.x+=airSm.x*dt*k;airAcc.y+=airSm.y*dt*k*(16/9)*1.5;   // the same angle is more of a short side, and wrists bend less up/down
  airMoved+=Math.hypot(airSm.x,airSm.y)*dt;
  airPump()
}
// iOS 13+ gives motion data only after DeviceMotionEvent.requestPermission(), and shows its
// prompt only when that call comes from a tap ("click"/"touchend"): from pointerdown it is
// refused silently. So on iOS the pad first works as a button that asks, and only after
// "granted" as the hold-and-aim pad. A refusal iOS keeps until the page is opened anew.
const airAskNeeded=!!(window.DeviceMotionEvent&&typeof DeviceMotionEvent.requestPermission==='function');
function airPadUi(){
