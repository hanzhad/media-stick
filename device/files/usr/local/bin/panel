document.addEventListener('keydown',e=>{if(e.target.tagName==='INPUT'||e.target.tagName==='SELECT')return;const a=KEYS[e.key];if(a){e.preventDefault();api('/api/key',{action:a}).catch(()=>{})}});

function act(what){api('/api/'+what,{}).then(r=>show('a-msg',r.message||'ок')).catch(e=>show('a-msg',e.message))}
// Two taps instead of confirm(): embedded browsers (the Claude app's included) refuse
// dialogs silently, and a button that asks first would then do nothing.
const armedAt={};
function armed(id,label){const b=$(id),now=Date.now();
  if(armedAt[id]&&now-armedAt[id]<4000){armedAt[id]=0;b.textContent=b.dataset.t;return true}
  armedAt[id]=now;b.dataset.t=b.dataset.t||b.textContent;b.textContent=label;
  setTimeout(()=>{if(armedAt[id]===now){armedAt[id]=0;b.textContent=b.dataset.t}},4000);return false}

async function loadNets(sel){
  const s=$(sel); s.innerHTML='<option>сканирую…</option>';
  try{const n=await api('/api/wifi/scan');
    s.innerHTML=n.map(x=>`<option value="${x.ssid.replace(/"/g,'&quot;')}">${x.ssid.replace(/</g,'&lt;')} (${x.signal}%)</option>`).join('')||'<option value="">— не найдено —</option>';
  }catch(e){s.innerHTML='<option value="">ошибка</option>'}
}
async function wifiConnect(){
  const ssid=$('s-manual').value.trim()||$('s-ssid').value;
  if(!ssid){show('s-msg','Выберите сеть');return}
  show('s-msg','Подключаюсь… точка доступа пропадёт, смотрите на телевизор.');
  api('/api/wifi/connect',{ssid,psk:$('s-psk').value,country:$('s-country').value}).catch(()=>{});
}
async function wifiChange(){
  const ssid=$('w-ssid').value; if(!ssid)return;
  const psk=$('w-psk').value;
  if(psk&&(psk.length<8||psk.length>63)){show('w-msg','Пароль Wi-Fi — от 8 до 63 символов.');return}
  if(!armed('w-btn','Нажмите ещё раз')){show('w-msg','Приставка перейдёт на «'+ssid+'». Нажмите ещё раз, чтобы подтвердить.');return}
  show('w-msg','Подключаюсь к «'+ssid+'»… до минуты.');
  try{await api('/api/wifi/connect',{ssid,psk})}
  catch(e){show('w-msg','Не отправилось: '+e.message);return}
  $('w-psk').value='';
  for(let i=0;i<25;i++){
    await new Promise(r=>setTimeout(r,3000));
    try{const s=await api('/api/status');
      if(s.wifi.ssid===ssid){show('w-msg','Подключено к «'+ssid+'». Адрес: '+(s.ip||[]).join(', '));return}
      if(i>15&&!s.wifi.ssid){show('w-msg','Не получилось подключиться к «'+ssid+'». Проверьте пароль.');return}
    }catch(e){}
  }
  show('w-msg','Нет ответа. Если приставка ушла в другую сеть, откройте http://mediastick.local из неё.');
}
function show(id,t){const m=$(id);m.textContent=t;m.classList.remove('hide')}

const dot=ok=>'<span class="dot'+(ok?'':' bad')+'"></span>';
const fmt=s=>[
 ['Сеть',dot(s.wifi.online)+esc(s.wifi.ssid||'кабель')+' · '+esc((s.ip||[]).join(', '))],
 ['Kodi',s.kodi==='up'?(s.playing?'<svg class="i s"><use href="#i-play"/></svg> '+esc(s.playing):'работает'):dot(false)+'не отвечает'],
 ['Температура',esc(s.temp)],
 ['Питание',s.power_ok?dot(true)+'норма':dot(false)+'просадка '+esc(s.throttled)],
 ['Память',s.mem_free_mb+' МБ свободно'],
 ['Диск',s.disk_free_gb+' ГБ свободно'],
 ['Работает',esc(s.uptime)],
 ['Версия',esc(s.commit)+(s.bad_commit?' '+dot(false)+'откат с '+esc(s.bad_commit):'')],
 ['Обновление',esc(s.next_update||'—')],
].map(([k,v])=>`<dt>${k}</dt><dd>${v}</dd>`).join('');

function header(ok,text){$('hdr-dot').className='dot'+(ok?'':' bad');$('hdr-t').textContent=text}
async function tick(){
  try{const s=await api('/api/status');
    if(s.wifi.ap){ if($('setup').classList.contains('hide')){$('app').classList.add('hide');$('setup').classList.remove('hide');loadNets('s-ssid')} }
    else{$('setup').classList.add('hide');$('app').classList.remove('hide')}
    header(s.wifi.online,(s.wifi.ssid||'кабель')+' · '+s.temp+' · '+s.time); $('info').innerHTML=fmt(s);
  }catch(e){header(false,'нет связи')}
}
tick(); setInterval(tick,5000);

// The screen costs Kodi a full-resolution render per frame, so it runs only when asked
// for: the button (or opening the tab on a phone), about one frame a second, off again
// after two minutes or when the page is hidden.
const LIVE_MAX_MS=120000, FRAME_GAP_MS=1000;
let live=false, liveSince=0, shotBusy=false, liveTimer=null, gotFrame=false, failed=0, redo=false;
function shotState(t,bad){ // over the placeholder until a frame exists, under the picture after
  if(!gotFrame)$('shot-s').textContent=t;
  const c=$('shot-ms'); c.textContent=gotFrame?t:''; c.classList.toggle('bad',!!bad)
}
function setLive(on){
  live=on; liveSince=Date.now();
  $('live-t').textContent=on?'Стоп':'Смотреть';
  $('live-ic').setAttribute('href',on?'#i-stop':'#i-play');
  if(on){failed=0;shotState('Загрузка…');frame()}
  else{clearTimeout(liveTimer);shotState(gotFrame?'Остановлено':'Нажмите «Смотреть»')}
}
function frame(){
  if(shotBusy){redo=true;return}
  shotBusy=true; const t=Date.now(), im=new Image();
  im.onload=()=>{shotBusy=false;failed=0;gotFrame=true;$('shot').src=im.src;$('shot-box').classList.add('has');
    if(live)shotState((Date.now()-t)+' мс');
    clearTimeout(liveTimer);
    if(live&&!document.hidden&&Date.now()-liveSince<LIVE_MAX_MS)liveTimer=setTimeout(frame,FRAME_GAP_MS);
    else if(live)setLive(false);
    if(redo){redo=false;setTimeout(frame,0)}};
  // the first frame after idle can be slow or fail once: retry before giving up
  im.onerror=()=>{shotBusy=false;redo=false;
    if(!gotFrame&&failed++<1){shotState('Загрузка…');setTimeout(frame,800);return}
    shotState('Kodi не отвечает',true);if(live)liveTimer=setTimeout(frame,3000)};
  im.src='/shot.png?'+t;
}
document.addEventListener('visibilitychange',()=>{if(document.hidden&&live)setLive(false)});

// Tap on the picture = click at that spot on the TV; hold = right click (Kodi's context
// menu); drag up or down = scroll. Spots are fractions of the picture itself, not of its box
// (object-fit leaves bars). A fresh frame follows each action, live or not.
const LONG_MS=500, SLOP_PX=10, STEP_PX=36, REFRESH_MS=380;
const HINT=$('shot-h').textContent, box=$('shot-box');
let ptrNote=null, g=null, lastType='', spend=0, sbusy=false, spos=null;
const ptr=(action,x,y,dy)=>api('/api/pointer',dy===undefined?{action,x,y}:{action,x,y,dy});
function ptrErr(e){
  const h=$('shot-h'); h.textContent=e.message||'Не получилось'; h.classList.add('bad');
  clearTimeout(ptrNote); ptrNote=setTimeout(()=>{h.textContent=HINT;h.classList.remove('bad')},4000)
}
function spot(cx,cy){
  const im=$('shot'), w=im.naturalWidth, h=im.naturalHeight;
  if(!gotFrame||!w||!h)return null;
  const r=im.getBoundingClientRect(), k=Math.min(r.width/w,r.height/h), dw=w*k, dh=h*k,
        x=(cx-r.left-(r.width-dw)/2)/dw, y=(cy-r.top-(r.height-dh)/2)/dh;
  return x<0||x>1||y<0||y>1?null:{x,y}
}
function ripple(cx,cy,cls){
  const b=box.getBoundingClientRect(), d=document.createElement('i');
  d.className='rip'+(cls?' '+cls:''); d.style.left=(cx-b.left)+'px'; d.style.top=(cy-b.top)+'px';
  box.appendChild(d); setTimeout(()=>d.remove(),900)
}
function tap(action,cx,cy){
  const p=spot(cx,cy); if(!p)return;
  buzz(); ripple(cx,cy,action==='right'?'r':'');
  if(!live)setLive(true);  // the first tap also starts the live picture (same limits as the button)
  ptr(action,p.x,p.y).then(()=>setTimeout(frame,REFRESH_MS)).catch(ptrErr)
}
function flushScroll(){
  if(sbusy||!spend||!spos)return;
  const d=spend; spend=0; sbusy=true;
  ptr('scroll',spos.x,spos.y,d).then(()=>setTimeout(frame,REFRESH_MS)).catch(ptrErr)
    .finally(()=>{sbusy=false;flushScroll()})
}
box.addEventListener('pointerdown',e=>{
  lastType=e.pointerType;
  if(g||(e.pointerType==='mouse'&&e.button!==0))return;
  g={id:e.pointerId,x:e.clientX,y:e.clientY,ly:e.clientY,acc:0,moved:false,scroll:false,long:false,t:0};
  try{box.setPointerCapture(e.pointerId)}catch(_){}
  // a mouse has its own right button (contextmenu below); only a finger needs the hold
  if(e.pointerType!=='mouse')g.t=setTimeout(()=>{if(g&&!g.moved){g.long=true;tap('right',g.x,g.y)}},LONG_MS)
});
box.addEventListener('pointermove',e=>{
  if(!g||e.pointerId!==g.id)return;
  const dx=e.clientX-g.x, dy=e.clientY-g.y;
  if(!g.moved&&Math.hypot(dx,dy)>SLOP_PX){
    g.moved=true; clearTimeout(g.t);
    const p=Math.abs(dy)>Math.abs(dx)?spot(g.x,g.y):null;
    if(p){g.scroll=true;spos=p;if(!live)setLive(true)}
  }
  if(g.scroll){  // finger down = wheel up (the view follows the finger)
    g.acc+=e.clientY-g.ly; g.ly=e.clientY;
    const n=Math.trunc(g.acc/STEP_PX);
    if(n){g.acc-=n*STEP_PX;spend+=n;flushScroll()}
  }
});
function endGesture(e,cancel){
  if(!g||e.pointerId!==g.id)return;
  clearTimeout(g.t); const s=g; g=null;
  if(!cancel&&!s.moved&&!s.long)tap('click',s.x,s.y)
}
box.addEventListener('pointerup',e=>endGesture(e,false));
box.addEventListener('pointercancel',e=>endGesture(e,true));
box.addEventListener('contextmenu',e=>{e.preventDefault();if(lastType==='mouse')tap('right',e.clientX,e.clientY)});
if(wide()){shotState('Загрузка…');frame()}  // one still frame on a computer, live only on request
</script></body></html>"""


# ---------------- server ----------------

def json_body(h):
    n = int(h.headers.get("Content-Length") or 0)
    try:
        return json.loads(h.rfile.read(min(n, 8192)) or b"{}")
    except ValueError:
        return {}


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):  # never log requests: bodies may carry a Wi-Fi password
        pass

    def send(self, body, ctype="application/json", code=200):
        if isinstance(body, (dict, list)):
            body = json.dumps(body)
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def host_ok(self):
        return bool(HOST_OK.match(self.headers.get("Host", "")))

    def pointer_post(self, b):
        """POST /api/pointer {action, x, y, dy}: x and y are fractions 0..1 of the screen."""
        if not isinstance(b, dict):
            return self.send("bad request", "text/plain", 400)
        a = b.get("action", "click")
        if a not in POINTER_ACTIONS:
            return self.send("unknown action", "text/plain", 400)

        def num(v):
            ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
            return float(v) if ok else None

        fx, fy = num(b.get("x")), num(b.get("y"))
        has_xy = "x" in b or "y" in b
        if (has_xy or a != "scroll") and (fx is None or fy is None):
            return self.send("x and y: numbers 0..1", "text/plain", 400)
        if fx is not None:
            fx, fy = min(1.0, max(0.0, fx)), min(1.0, max(0.0, fy))
        wheel = 0
        if a == "scroll":
            dy = num(b.get("dy"))
            if dy is None:
                return self.send("dy: a number", "text/plain", 400)
            wheel = int(max(-10, min(10, round(dy))))
        try:
            POINTER.act(a, fx, fy, wheel)
        except PointerUnavailable as e:
            return self.send("Указатель недоступен: %s" % e, "text/plain", 503)
        forget_shot()
        return self.send({"ok": True})

    def do_GET(self):
        if not self.host_ok():
            # hotspot mode: every name resolves here, so phones' captive-portal checks
            # land on us; send them to the page
            if wifi_status().get("ap"):
                self.send_response(302)
                self.send_header("Location", "http://10.42.0.1/")
                self.end_headers()
                return
            return self.send("bad host", "text/plain", 421)
        p = self.path.split("?")[0]
        if p == "/":
            return self.send(PAGE, "text/html; charset=utf-8")
        if p == "/api/status":
            return self.send(status())
        if p == "/api/wifi/scan":
            rc, out = run(["sudo", "-n", "/usr/local/bin/wifi-setup", "scan"], timeout=40)
            return self.send(out or "[]")
        if p == "/shot.png":
            try:
                return self.send(screenshot(), "image/png")
            except (OSError, TimeoutError) as e:
                return self.send(str(e), "text/plain", 503)
        # anything else (phone captive-portal probes on our own name): the page
        self.send(PAGE, "text/html; charset=utf-8")

    def do_POST(self):
        if not self.host_ok() or self.headers.get("X-Panel") != "1":
            return self.send("forbidden", "text/plain", 403)
        p = self.path.split("?")[0]
        b = json_body(self)
        if p == "/api/pointer":
            return self.pointer_post(b)
        try:
            if p == "/api/key":
                a = b.get("action")
                if web_app_on():
                    if a == "home":
                        run(["sudo", "-n", "systemctl", "stop", "web-app@*"])
                    elif a in WEB_KEYS:
                        web_key(WEB_KEYS[a])
                    elif a not in ACTIONS:
                        return self.send("unknown action", "text/plain", 400)
                    return self.send({"ok": True})
                if a == "home":
                    kodi("GUI.ActivateWindow", {"window": "home"})
                elif a in ACTIONS:
                    kodi("Input.ExecuteAction", {"action": a})
                else:
                    return self.send("unknown action", "text/plain", 400)
                return self.send({"ok": True})
            if p == "/api/text" and web_app_on():
                web_type(str(b.get("text", ""))[:200])
                return self.send({"ok": True})
            if p == "/api/text":
                kodi("Input.SendText", {"text": str(b.get("text", ""))[:200], "done": True})
                return self.send({"ok": True})
        except OSError:
            return self.send("Kodi не отвечает", "text/plain", 503)
        if p == "/api/wifi/connect":
            req = json.dumps({"ssid": b.get("ssid", ""), "psk": b.get("psk", ""),
                              "country": b.get("country", "")})
            # answer first: the connect takes the hotspot (and maybe this page) away
            self.send({"ok": True, "message": "подключаюсь"})
            threading.Thread(target=run, args=(["sudo", "-n", "/usr/local/bin/wifi-setup", "connect"],),
                             kwargs={"stdin": req, "timeout": 120}, daemon=True).start()
            return
        if p == "/api/update":
            subprocess.Popen(["sudo", "-n", "systemctl", "start", "--no-block", "media-stick-update.service"])
            return self.send({"ok": True, "message": "Проверяю обновления. Если есть новая версия, она поставится за пару минут."})
        if p == "/api/reboot":
            self.send({"ok": True, "message": "Перезагружаюсь, вернусь через минуту."})
            subprocess.Popen(["sudo", "-n", "systemctl", "reboot"])
            return
        self.send("not found", "text/plain", 404)


class DualStack(ThreadingHTTPServer):
    """IPv6 and IPv4 on one socket: mediastick.local often resolves to IPv6 first."""
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


if __name__ == "__main__":
    os.makedirs(SHOTS, exist_ok=True)
    POINTER.start()
    DualStack(("::", PORT), H).serve_forever()
