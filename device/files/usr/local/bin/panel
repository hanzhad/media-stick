  }else if(s.state==='error'){
    show('h-msg','Не получилось: '+(s.message||'неизвестная ошибка')+'. Повторю сам в течение суток; можно «Отключить» и начать заново.')
  }else show('h-msg',H_TEXT[s.state]||'Настраиваю…');
  hLoaded=true
}
// hWait: a restart of the panel is expected (it restarts itself the moment the certificate is
// ready, and after «Отключить»), so a failed request then means "wait", not "broken".
let hWait=false, hFails=0, hWaitMsg='Панель перезапускается…';
async function httpsLoad(){
  clearTimeout(hTimer);
  try{
    const s=await api('/api/https');hFails=0;hView(s);
    hWait=s.state==='updating-dns'||s.state==='issuing';
    if(hWait)hWaitMsg='Сертификат готов, панель перезапускается…';
    if(hWait)hTimer=setTimeout(httpsLoad,3000)
  }catch(e){
    if(hWait&&++hFails<=20){show('h-msg',hWaitMsg);hTimer=setTimeout(httpsLoad,3000);return}
    hWait=false;show('h-msg','Нет связи с панелью: '+e.message)
  }
}
async function httpsSet(){
  const domain=subOf($('h-dom').value), token=$('h-tok').value.trim();
