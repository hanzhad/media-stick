async function api(path,body){
  const o=body===undefined?{}:{method:'POST',headers:{'X-Panel':'1','Content-Type':'application/json'},body:JSON.stringify(body)};
  const r=await fetch(path,o); if(!r.ok) throw new Error(await r.text()); return r.json();
}
function buzz(){if(navigator.vibrate)navigator.vibrate(12)}
document.querySelectorAll('[data-a]').forEach(b=>b.addEventListener('click',()=>{buzz();api('/api/key',{action:b.dataset.a}).catch(()=>{})}));
