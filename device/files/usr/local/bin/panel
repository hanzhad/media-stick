// ---- Air mouse: hold the pad and aim the phone at the TV like a remote. ----
// Phone in portrait, top edge towards the TV, screen towards you, tilted up to about 45
// degrees. devicemotion rotationRate (deg/s): alpha turns about the screen's normal, which
// is close to the vertical when the phone lies flat-ish, so turning left/right = yaw;
// beta turns about the short axis, so raising/lowering the top edge = pitch.
// Turn left -> alpha>0 -> pointer left; raise the top edge -> beta>0 -> pointer up.
// Deltas are summed and sent at most every AIR_GAP_MS, one request in flight, as screen
// fractions (the same unit as /api/pointer). A short press without motion is a click.
const airOk=window.isSecureContext&&'DeviceMotionEvent' in window;
const AIR_GAP_MS=33, AIR_MAX=0.25, AIR_DZ=2.5, AIR_SMOOTH=0.5, AIR_DEG_FULL=45, TAP_MS=350, TAP_DEG=5;
const AIR_HINT='Отпустите — указка остановится.';
let airHeld=false, airOn=false, airK=5, airAcc={x:0,y:0}, airSm={x:0,y:0}, airBusy=false, airLast=0,
    airTimer=null, airClick=false, airPerm=null, airT0=0, airTPrev=0, airMoved=0, airGot=false, airChk=null, airNoteT=null;
try{const v=parseInt(localStorage.getItem('airk'),10);if(v>=1&&v<=10)airK=v}catch(e){}
$('air-k').value=airK;
$('air-k').addEventListener('input',e=>{airK=+e.target.value;try{localStorage.setItem('airk',String(airK))}catch(_){}});
// The air tab says what is missing when the pad cannot work here. The http page first checks
// that the https address really opens from this phone: a browser tab then moves there by
// itself (once, on load); a home-screen app saved with the old http address cannot change
// its address, so it explains how to add it again.
const HTTPS_RE=/^https:[/][/][a-z0-9.-]+[/]?$/;
const standalone=navigator.standalone===true||matchMedia('(display-mode: standalone)').matches;
let httpsOk=null, httpsFor='', statusSeen=false;
const httpsBase=()=>httpsUrl.replace(/[/]?$/,'/');
function httpsCheck(){
  const first=!statusSeen;statusSeen=true;
  if(location.protocol==='https:'||!HTTPS_RE.test(httpsUrl)||httpsFor===httpsUrl)return;
  httpsFor=httpsUrl;httpsOk=null;
  const base=httpsBase(), ctl=new AbortController(), t=setTimeout(()=>ctl.abort(),5000);
  fetch(base+'api/https',{mode:'no-cors',cache:'no-store',signal:ctl.signal})
    .then(()=>{httpsOk=true;if(first&&!standalone){location.replace(base+(location.hash||(tab==='air'?'#air':'')));return}airUi()},
          ()=>{httpsOk=false;airUi()})
    .finally(()=>clearTimeout(t))
}
function airCopy(){
  const u=httpsBase(), done=()=>{$('air-nt').textContent='Адрес скопирован: '+u};
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(u).then(done,()=>{});return}
  const t=document.createElement('textarea');t.value=u;t.setAttribute('readonly','');t.style.position='fixed';t.style.opacity='0';
  document.body.appendChild(t);t.select();t.setSelectionRange(0,u.length);
  try{if(document.execCommand('copy'))done()}catch(e){}
  t.remove()
}
function airUi(){
  $('air').classList.toggle('hide',!airOk);
  $('air-no').classList.toggle('hide',airOk);
  if(!$('air-h').textContent)airNote('');
  if(airOk)return;
  const nt=$('air-nt'), a=$('air-a'), cp=$('air-copy'), st=$('air-steps');
  let steps=false, copy=false;
  a.classList.remove('hide');a.removeAttribute('target');
  if(window.isSecureContext){
    nt.textContent='На этом устройстве нет датчика движения. Откройте пульт на телефоне.';a.classList.add('hide');
  }else if(!HTTPS_RE.test(httpsUrl)){
    nt.textContent='Указка по наклону телефона. Телефон даёт датчики только защищённой странице (HTTPS), а она ещё не настроена — это пара минут.';
    a.href='#https';a.textContent='Настроить HTTPS';
  }else{
    const host=httpsUrl.replace(/^https:[/][/]/,'').replace(/[/]$/,'');
    a.href=httpsBase()+'#air';copy=true;
    if(httpsOk===false){
      nt.textContent='HTTPS настроен ('+host+'), но с этого телефона адрес не открылся. Телефон должен быть в той же Wi-Fi, что и приставка.';
      a.textContent='Попробовать открыть';a.target='_blank';
    }else if(standalone){
      nt.textContent='HTTPS уже настроен, но этот значок на экране «Домой» сохранён со старым адресом (http), а аэромыши нужен новый: '+host+'. Сам значок адрес не сменит — добавьте его заново:';
      a.textContent='Открыть новый адрес';a.target='_blank';steps=true;
    }else{
      nt.textContent='HTTPS настроен: аэромышь работает по адресу '+host+'.';
      a.textContent='Перейти на HTTPS';
    }
  }
  st.classList.toggle('hide',!steps);cp.classList.toggle('hide',!copy);
}
function airNote(t,bad){
  const h=$('air-h');h.textContent=t||AIR_HINT;h.classList.toggle('bad',!!bad);
  clearTimeout(airNoteT);if(t)airNoteT=setTimeout(()=>airNote(''),5000)
}
function airPump(){
  if(airBusy)return;
  const wait=AIR_GAP_MS-(performance.now()-airLast);
  if(wait>0){if(!airTimer)airTimer=setTimeout(()=>{airTimer=null;airPump()},wait);return}
  const cl=v=>Math.max(-AIR_MAX,Math.min(AIR_MAX,v));
  let body=null;
  if(Math.abs(airAcc.x)>1e-5||Math.abs(airAcc.y)>1e-5){
    const dx=cl(airAcc.x), dy=cl(airAcc.y);airAcc.x-=dx;airAcc.y-=dy;
    body={action:'move_by',dx,dy}
  }else if(airClick){airClick=false;body={action:'click',here:true}}
  if(!body)return;
  airBusy=true;airLast=performance.now();
  api('/api/pointer',body).then(()=>{if(body.action==='click'&&live)setTimeout(frame,REFRESH_MS)})
    .catch(e=>{airAcc.x=airAcc.y=0;airClick=false;airLast=performance.now()+1000;airNote(e.message||'Не получилось',1)})
    .finally(()=>{airBusy=false;if(airClick||Math.abs(airAcc.x)>1e-5||Math.abs(airAcc.y)>1e-5)airPump()})
}
function onMotion(e){
  const r=e.rotationRate;
  if(!airHeld||!r||r.alpha==null||r.beta==null)return;
  const now=performance.now();airGot=true;
  let dt=airTPrev?(now-airTPrev)/1000:0;airTPrev=now;
  if(dt<=0)return;if(dt>0.1)dt=0.1;
  const dz=v=>Math.abs(v)<AIR_DZ?0:v-Math.sign(v)*AIR_DZ;
  airSm.x+=AIR_SMOOTH*(-dz(r.alpha)-airSm.x);   // deg/s; left and up are negative
  airSm.y+=AIR_SMOOTH*(-dz(r.beta)-airSm.y);
  const k=Math.pow(1.3,airK-5)/AIR_DEG_FULL;   // screen widths per degree
  airAcc.x+=airSm.x*dt*k;airAcc.y+=airSm.y*dt*k*(16/9);   // the same angle is more of a short side
  airMoved+=Math.hypot(airSm.x,airSm.y)*dt;
  airPump()
}
function airAsk(){  // iOS 13+: ask inside the user's gesture; elsewhere there is nothing to ask
  const D=window.DeviceMotionEvent;
  if(!D||typeof D.requestPermission!=='function'){airPerm=true;return Promise.resolve(true)}
  if(airPerm!==null)return Promise.resolve(airPerm);
  return D.requestPermission().then(r=>airPerm=(r==='granted'),()=>airPerm=false)
}
function airStop(cancel){
  if(!airHeld)return;
  airHeld=false;$('air-pad').classList.remove('on');
  if(airOn){removeEventListener('devicemotion',onMotion);airOn=false}
  clearTimeout(airChk);airAcc.x=airAcc.y=0;   // releasing stops the pointer
  if(!cancel&&performance.now()-airT0<TAP_MS&&airMoved<TAP_DEG){airClick=true;buzz();airPump()}
}
const pad=$('air-pad');
pad.addEventListener('pointerdown',e=>{
  if(airHeld||(e.pointerType==='mouse'&&e.button!==0))return;
  e.preventDefault();
  try{pad.setPointerCapture(e.pointerId)}catch(_){}
  airHeld=true;airT0=performance.now();airTPrev=0;airMoved=0;airGot=false;airSm.x=airSm.y=0;
  pad.classList.add('on');buzz();
  const first=airPerm===null&&window.DeviceMotionEvent&&typeof DeviceMotionEvent.requestPermission==='function';
  airAsk().then(ok=>{
    if(!ok){airStop(true);airNote('Нет доступа к датчикам движения: разрешите его в настройках браузера.',1);return}
    if(first){airStop(true);airNote('Доступ разрешён. Теперь удерживайте площадку и наводите телефон.');return}
    if(!airHeld||airOn)return;
    addEventListener('devicemotion',onMotion);airOn=true;
    airChk=setTimeout(()=>{if(airHeld&&!airGot)airNote('Датчик движения не отвечает на этом устройстве.',1)},1500)
  })
});
pad.addEventListener('pointerup',()=>airStop(false));
pad.addEventListener('pointercancel',()=>airStop(true));
pad.addEventListener('contextmenu',e=>e.preventDefault());
document.addEventListener('visibilitychange',()=>{if(document.hidden)airStop(true)});
airUi();
try{if(localStorage.getItem('tab')==='air'&&!location.hash)document.querySelector('[data-go=air]').click()}catch(e){}
document.addEventListener('gesturestart',e=>e.preventDefault());
document.addEventListener('dblclick',e=>e.preventDefault());
</script></body></html>"""


# ---------------- server ----------------

def json_body(h):
    n = int(h.headers.get("Content-Length") or 0)
    try:
        return json.loads(h.rfile.read(min(n, 8192)) or b"{}")
    except ValueError:
        return {}


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):  # never log requests: bodies may carry a Wi-Fi password
        pass

    def send(self, body, ctype="application/json", code=200):
        if isinstance(body, (dict, list)):
            body = json.dumps(body)
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    secure = False   # True in the HTTPS listener's handler class

    def host_ok(self):
        host = self.headers.get("Host", "")
        if HOST_OK.match(host):
            return True
        pub = public_host()
        return bool(pub) and host_name(host) == pub

    def redirect_to_https(self):
        """Plain http addressed by our public name -> the same path on https, but only
        while the HTTPS listener is really up (else the redirect would lead nowhere)."""
        pub = public_host()
        if self.secure or not pub or not https_state["up"] or host_name(self.headers.get("Host", "")) != pub:
            return False
        path = self.path if self.path.startswith("/") else "/"
        self.send_response(301 if self.command in ("GET", "HEAD") else 308)
        self.send_header("Location", "https://" + pub + path)
        self.send_header("Content-Length", "0")
        self.end_headers()
        return True

    def https_set(self, b):
        """POST /api/https {domain, token}: the helper validates and stores them."""
        if not isinstance(b, dict):
            return self.send("bad request", "text/plain", 400)
        req = json.dumps({"domain": str(b.get("domain", "")), "token": str(b.get("token", ""))})
        rc, out = run(HTTPS_HELPER + ["set"], stdin=req, timeout=20)
        https_cache["t"] = 0.0
        if rc != 0:
            return self.send(TOKEN_RE.sub("***", out) or "Не получилось сохранить", "text/plain", 400)
        return self.send({"ok": True})

    def pointer_post(self, b):
        """POST /api/pointer {action, x, y, dy}: x and y are fractions 0..1 of the screen."""
        if not isinstance(b, dict):
            return self.send("bad request", "text/plain", 400)
        a = b.get("action", "click")
        if a not in POINTER_ACTIONS:
            return self.send("unknown action", "text/plain", 400)

        def num(v):
            ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
            return float(v) if ok else None

        wheel = 0
        if a == "move_by":   # air mouse: dx, dy are fractions of the screen, at most 0.25 per call
            dx, dy = num(b.get("dx")), num(b.get("dy"))
            if dx is None or dy is None:
                return self.send("dx and dy: numbers", "text/plain", 400)
            fx, fy = min(0.25, max(-0.25, dx)), min(0.25, max(-0.25, dy))
        else:
            fx, fy = num(b.get("x")), num(b.get("y"))
            has_xy = "x" in b or "y" in b
            # {"here": true} clicks where the pointer already is (the air mouse's tap)
            here = b.get("here") is True and a in ("click", "right") and not has_xy
            if not here and (has_xy or a != "scroll") and (fx is None or fy is None):
                return self.send("x and y: numbers 0..1", "text/plain", 400)
            if fx is not None:
                fx, fy = min(1.0, max(0.0, fx)), min(1.0, max(0.0, fy))
        if a == "scroll":
            dy = num(b.get("dy"))
            if dy is None:
                return self.send("dy: a number", "text/plain", 400)
            wheel = int(max(-10, min(10, round(dy))))
        try:
            POINTER.act(a, fx, fy, wheel)
        except PointerUnavailable as e:
            return self.send("Указатель недоступен: %s" % e, "text/plain", 503)
        forget_shot()
        return self.send({"ok": True})

    def do_GET(self):
        if self.redirect_to_https():
            return
        if not self.host_ok():
            # hotspot mode: every name resolves here, so phones' captive-portal checks
            # land on us; send them to the page
            if wifi_status().get("ap"):
                self.send_response(302)
                self.send_header("Location", "http://10.42.0.1/")
                self.end_headers()
                return
            return self.send("bad host", "text/plain", 421)
        p = self.path.split("?")[0]
        if p == "/":
            return self.send(PAGE, "text/html; charset=utf-8")
        if p == "/api/status":
            return self.send(status())
        if p == "/api/https":
            return self.send(https_status())
        if p == "/api/wifi/scan":
            rc, out = run(["sudo", "-n", "/usr/local/bin/wifi-setup", "scan"], timeout=40)
            return self.send(out or "[]")
        if p == "/shot.png":
            try:
                return self.send(screenshot(), "image/png")
            except (OSError, TimeoutError) as e:
                return self.send(str(e), "text/plain", 503)
        # anything else (phone captive-portal probes on our own name): the page
        self.send(PAGE, "text/html; charset=utf-8")

    def do_POST(self):
        if self.redirect_to_https():
            return
        if not self.host_ok() or self.headers.get("X-Panel") != "1":
            return self.send("forbidden", "text/plain", 403)
        p = self.path.split("?")[0]
        b = json_body(self)
        if p == "/api/pointer":
            return self.pointer_post(b)
        try:
            if p == "/api/key":
                a = b.get("action")
                if web_app_on():
                    if a == "home":
                        run(["sudo", "-n", "systemctl", "stop", "web-app@*"])
                    elif a in WEB_KEYS:
                        web_key(WEB_KEYS[a])
                    elif a not in ACTIONS:
                        return self.send("unknown action", "text/plain", 400)
                    return self.send({"ok": True})
                if a == "home":
                    kodi("GUI.ActivateWindow", {"window": "home"})
                elif a in ACTIONS:
                    kodi("Input.ExecuteAction", {"action": a})
                else:
                    return self.send("unknown action", "text/plain", 400)
                return self.send({"ok": True})
            if p == "/api/text" and web_app_on():
                web_type(str(b.get("text", ""))[:200])
                return self.send({"ok": True})
            if p == "/api/text":
                kodi("Input.SendText", {"text": str(b.get("text", ""))[:200], "done": True})
                return self.send({"ok": True})
        except OSError:
            return self.send("Kodi не отвечает", "text/plain", 503)
        if p == "/api/https":
            return self.https_set(b)
        if p == "/api/https/clear":
            # answer first: the helper restarts this very panel
            self.send({"ok": True, "message": "HTTPS отключён, панель перезапускается."})
            https_cache["t"] = 0.0
            threading.Thread(target=run, args=(HTTPS_HELPER + ["clear"],), kwargs={"timeout": 60},
                             daemon=True).start()
            return
        if p == "/api/wifi/connect":
            req = json.dumps({"ssid": b.get("ssid", ""), "psk": b.get("psk", ""),
                              "country": b.get("country", "")})
            # answer first: the connect takes the hotspot (and maybe this page) away
            self.send({"ok": True, "message": "подключаюсь"})
            threading.Thread(target=run, args=(["sudo", "-n", "/usr/local/bin/wifi-setup", "connect"],),
                             kwargs={"stdin": req, "timeout": 120}, daemon=True).start()
            return
        if p == "/api/update":
            subprocess.Popen(["sudo", "-n", "systemctl", "start", "--no-block", "media-stick-update.service"])
            return self.send({"ok": True, "message": "Проверяю обновления. Если есть новая версия, она поставится за пару минут."})
        if p == "/api/reboot":
            self.send({"ok": True, "message": "Перезагружаюсь, вернусь через минуту."})
            subprocess.Popen(["sudo", "-n", "systemctl", "reboot"])
            return
        self.send("not found", "text/plain", 404)


class DualStack(ThreadingHTTPServer):
    """IPv6 and IPv4 on one socket: mediastick.local often resolves to IPv6 first."""
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 0)
        super().server_bind()


class TLSServer(DualStack):
    """The same handler over TLS. The handshake runs in the request's own thread, not in
    accept(), so a client that stalls in it cannot hold up the others."""
    ctx = None

    def finish_request(self, request, client_address):
        request.settimeout(15)
        try:
            tls = self.ctx.wrap_socket(request, server_side=True)
        except (ssl.SSLError, OSError):
            return
        try:
            self.RequestHandlerClass(tls, client_address, self)
        finally:
            try:
                tls.close()
            except OSError:
                pass


class HTTPSHandler(H):
    secure = True


def start_https():
    """Serve HTTPS on 443 too when media-stick-cert has published a certificate. Any
    failure leaves port 80 as it was."""
    if not (os.path.isfile(TLS_CRT) and os.path.isfile(TLS_KEY)):
        return
    try:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(TLS_CRT, TLS_KEY)
        srv = TLSServer(("::", HTTPS_PORT), HTTPSHandler)
    except (OSError, ssl.SSLError) as e:
        print("panel: HTTPS not started: %s" % e, file=sys.stderr, flush=True)
        return
    srv.ctx = ctx
    https_state["up"] = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()


if __name__ == "__main__":
    os.makedirs(SHOTS, exist_ok=True)
    POINTER.start()
    start_https()
    DualStack(("::", PORT), H).serve_forever()
