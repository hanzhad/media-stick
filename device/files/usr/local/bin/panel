// Slide the thumb on the pad = scroll, like a wheel: sideways = left/right keys (the home row,
// one card per 40 px; the focus follows the thumb), up/down = the mouse wheel where the dot is,
// thumb down = the page down.
const SW_SLOP=16, SW_KEY_PX=40, SW_WHEEL_PX=30;
let wpend=0, wbusy=false;
function flushWheel(){
  if(wbusy||!wpend)return;
