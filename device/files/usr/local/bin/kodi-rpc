#!/usr/bin/python3
"""Send one JSON-RPC call to the local Kodi (TCP 9090, localhost only, no auth).

Usage: kodi-rpc Method '{"param":1}'
Prints the response object. Exit 1 if Kodi does not answer or answers with an error.
Kodi's TCP replies carry no newline and the socket also pushes notifications, so the
reply is read as JSON objects until the one with our id arrives.
"""
import json
import socket
import sys

method = sys.argv[1]
params = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
try:
    s = socket.create_connection(("127.0.0.1", 9090), timeout=5)
    s.sendall(json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode())
    buf, dec = "", json.JSONDecoder()
    while True:
        chunk = s.recv(65536)
        if not chunk:
            sys.exit(1)
        buf += chunk.decode("utf-8", "replace")
        while buf.strip():
            try:
                obj, end = dec.raw_decode(buf.lstrip())
            except ValueError:
                break
            buf = buf.lstrip()[end:]
            if obj.get("id") == 1:
                print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))
                sys.exit(1 if "error" in obj else 0)
except OSError:
    sys.exit(1)
