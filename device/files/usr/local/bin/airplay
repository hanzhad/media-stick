#!/usr/bin/python3
"""AirPlay receiver: screen mirroring and audio from an iPhone, iPad or Mac, by UxPlay.

The screen belongs to whoever holds DRM master, and the first program to open it while
nobody does gets it: so UxPlay never touches it, and does not even decode. It writes the
phone's compressed H.264 to a pipe (-vd below; UxPlay's own decoder, converter and sink are
left a dummy test picture), this script passes it on, and only once a phone has connected
and Kodi (or a web app) is stopped does a small drawer (fdsrc ! v4l2h264dec ! kmssink) open
the screen, decode and show. There the decoder's buffer goes onto the screen as it is: the
Pi 3's decoder does 1080p at 60 pictures a second on 2% of the processor. Anything else
between the two, raw pictures over TCP and then the decoded buffer over a socket
(unixfdsink), made the decoder copy each 3 MB picture out of uncached memory, a whole core
for 27 pictures a second at most, fewer when the picture moves: a Mac's 30 fell behind by
half a second and more. A phone upright (498x1080) is small enough that it did not show.

The phone sends a whole picture (IDR, after the SPS) only when the stream starts or turns,
and a decoder cannot start without one: so the pipe's bytes are kept from the last SPS on
(Relay) and a drawer that starts later, after Kodi has stopped, gets them first.

Without Kodi the TV falls back to the console's mode, 1024x768 when the TV was off at boot,
so before the drawer starts the TV is set to 1080p showing the boot picture (kmssink keeps
the mode it finds, and the picture until the phone's first), and the screen is let go for
the drawer. Going back, the console framebuffer shows the same picture (console-splash). When the phone lets go, the drawer
stops and Kodi comes back. Run by airplay.service as root; UxPlay and the drawer run as
media. While the screen is taken, /run/media-stick/airplay exists: bootstrap leaves Kodi
alone then. While a Windows PC casting through miracast has the screen
(/run/media-stick/miracast exists) a phone is ignored.
"""
import fcntl
import json
import os
import queue
import re
import socket
import subprocess
import sys
import threading
import time

_HERE = os.path.dirname(os.path.abspath(__file__))
_REPO_LIB = os.path.normpath(os.path.join(_HERE, "..", "lib", "media-stick"))
for _lib in ("/usr/local/lib/media-stick", _REPO_LIB):
    if os.path.isdir(_lib) and _lib not in sys.path:
        sys.path.insert(0, _lib)

from mediastick_display import DisplayClient, DisplayError  # noqa: E402
from mediastick_drm import (  # noqa: E402
    CARD,
    Connector,
    CreateDumb,
    Encoder,
    MapDumb,
    ModeInfo,
    Resources,
    SPLASH,
    SPLASH_CACHE,
    light_screen,
    paint_splash,
    put_rows,
    splash_pixels,
)

RUN = "/run/media-stick"
FLAG = RUN + "/airplay"
MIRACAST_FLAG = RUN + "/miracast"   # miracast has the screen
STALE = (RUN + "/airplay-video.sock", RUN + "/airplay.shm")   # what earlier versions left
LOG = RUN + "/airplay.log"   # UxPlay's own debug output, for looking into problems
LOG_MAX = 256 << 10
DRAW_LOG = RUN + "/airplay-draw.log"   # the drawer's GStreamer warnings and errors
NAME = os.environ.get("AIRPLAY_NAME") or "Media Stick"
AUDIO_BUFFER_US = 40000   # the sound card's buffer: less is closer to the picture, too little crackles
AS_MEDIA = ["setpriv", "--reuid=media", "--regid=media", "--init-groups", "env", "HOME=/home/media"]


def _as_media():
    return list(AS_MEDIA) if os.geteuid() == 0 else []


def uxplay(fd):
    """UxPlay's video pipeline is fixed: appsrc ! queue ! h264parse ! <-vd> ! <-vc> !
    videoscale ! <-vs>. The -vd here ends it at fdsink, writing whole pictures (alignment=au)
    in byte-stream form to the pipe fd, and starts a second branch, a single test picture,
    for the rest to have something to scale and throw away."""
    return _as_media() + [
        "stdbuf", "-oL", "-eL", "uxplay", "-n", NAME, "-nh",
        "-vd", "capsfilter caps=video/x-h264,stream-format=byte-stream,alignment=au"
               " ! fdsink fd=%d sync=false async=false  videotestsrc num-buffers=1" % fd,
        "-vc", "videoconvert",
        "-vs", "fakesink",   # UxPlay appends " name=... sync=..."
        # sound 40 ms behind, not alsasink's default 200 ms: the picture is drawn as soon as
        # it is decoded (-vsync no, drawer below), so a Mac's sound came noticeably after it
        "-as", "alsasink buffer-time=%d latency-time=10000" % AUDIO_BUFFER_US,
        "-vsync", "no",   # no waiting to line the picture up with the sound: much less delay
        # no -hls: UxPlay 1.71's YouTube mode takes the video but never starts playing it (the
        # app shows "Something went wrong"); without it the YouTube app mirrors instead
        "-d"]       # the connection lines below are debug-level


# a phone really connecting (not just listing receivers): its pairing request
START = re.compile(r"connection request from|Begin streaming")
# audio-only AirPlay pauses Kodi without stopping it or taking the DRM screen
AUDIO_START = re.compile(r"changed audio connection")
# UxPlay's own count of open connections, logged on every accept and close
OPEN = re.compile(r"Open connections: (\d+)")
BACK_AFTER = 4.0   # seconds with no connection left before Kodi comes back


def say(*a):
    print("[airplay]", *a, flush=True)
    try:    # the journal is root's to read: the same lines go next to the drawer's
        with open(DRAW_LOG, "a") as out:
            out.write("[airplay %s] %s\n" % (time.strftime("%H:%M:%S"), " ".join(map(str, a))))
    except OSError:
        pass


def _kodi_rpc(method, params=None, timeout=2.0):
    req = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params or {}})
    with socket.create_connection(("127.0.0.1", 9090), timeout=timeout) as s:
        s.sendall(req.encode("utf-8"))
        buf, dec = "", json.JSONDecoder()
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            s.settimeout(max(0.05, deadline - time.monotonic()))
            chunk = s.recv(65536)
            if not chunk:
                return None
            buf += chunk.decode("utf-8", "replace")
            while buf.strip():
                try:
                    obj, end = dec.raw_decode(buf.lstrip())
                except ValueError:
                    break
                buf = buf.lstrip()[end:]
                if obj.get("id") == 1:
                    return obj.get("result")
    return None


def pause_kodi(rpc=_kodi_rpc):
    """Pause any active Kodi player via JSON-RPC without stopping Kodi."""
    try:
        players = rpc("Player.GetActivePlayers") or []
    except (OSError, ValueError) as e:
        say("could not query Kodi players:", e)
        return False
    paused = False
    for player in players:
        pid = player.get("playerid")
        if pid is not None:
            try:
                rpc("Player.PlayPause", {"playerid": pid, "play": False})
                paused = True
            except (OSError, ValueError) as e:
                say("could not pause Kodi player %s:" % pid, e)
    return paused


def may_take():
    """The screen is free for a phone unless a PC is casting to it through miracast."""
    return not os.path.exists(MIRACAST_FLAG)


def systemctl(*args):
    return subprocess.run(["systemctl", *args], capture_output=True, text=True)


def drawer():
    """H.264 on its standard input, decoded by the hardware (v4l2h264dec; bt709, or the
    colours come out wrong) straight into kmssink, which puts the decoder's buffer on a plane
    as it is and lets the display hardware scale it to the TV's current mode, centred with its
    shape kept (a phone held upright gets black bars at the sides). Only a queue between
    them: anything else there makes the decoder copy every picture. One picture waits at
    most: an older one is dropped rather than shown late. -v logs each picture size."""
    return (_as_media() or ["env"]) + [
        "GST_DEBUG=2,bufferpool:1", "gst-launch-1.0", "-v", "fdsrc", "fd=0",
        "!", "h264parse", "!", "capssetter", "caps=video/x-h264,colorimetry=bt709",
        "!", "v4l2h264dec", "!", "queue", "max-size-buffers=1", "leaky=downstream",
        "!", "kmssink", "sync=false"]


# a NAL unit's start code and an SPS header byte (type 7; any nal_ref_idc: a Mac sends 0x27)
SPS = re.compile(rb"\x00\x00\x01[\x07\x27\x47\x67]")
KEEP_MAX = 8 << 20   # about 10 s of a Mac's 1080p; past that a late drawer waits for a turn


def write_all(fd, data):
    view = memoryview(data)
    while view:
        view = view[os.write(fd, view):]


class Relay:
    """The compressed pictures from UxPlay's pipe to the drawer. Keeps the bytes from the last
    SPS on (None: not since the last reset, or more than KEEP_MAX), so that a drawer attached
    later starts on a whole picture."""

    def __init__(self):
        self.lock = threading.Lock()
        self.kept = None
        self.tail = b""   # the last bytes, for a start code split between two reads
        self.out = None   # the drawer's standard input

    def feed(self, data):
        with self.lock:
            look = self.tail + data
            last = None
            for last in SPS.finditer(look):
                pass
            if last is not None:
                start = last.start()
                if start and look[start - 1] == 0:   # the 4-byte start code
                    start -= 1
                self.kept = bytearray(look[start:])
            elif self.kept is not None:
                self.kept += data
                if len(self.kept) > KEEP_MAX:
                    self.kept = None
            self.tail = look[-3:]
            if self.out is not None:
                try:
                    write_all(self.out, data)
                except OSError:   # the drawer died; draw() starts another
                    self.out = None

    def attach(self, fd):
        with self.lock:
            self.out = fd
            if self.kept:
                try:
                    write_all(fd, self.kept)
                except OSError:
                    self.out = None

    def reset(self):
        """The phone let go: what comes next is a new stream."""
        with self.lock:
            self.out, self.kept, self.tail = None, None, b""


class Screen:
    def __init__(self, relay):
        self.relay = relay
        self.drawer = None
        self.card = None
        self.size = (1920, 1080)
        self._display = None

    @property
    def taken(self):
        return os.path.exists(FLAG)

    def take(self):
        open(FLAG, "w").close()
        client = DisplayClient()
        try:
            client.acquire("CAST_AIRPLAY", owner="airplay")
            self._display = client
        except (OSError, EOFError, DisplayError) as e:
            client.close()
            self._display = None
            if not isinstance(e, OSError):
                say("displayd acquire failed, falling back to systemctl:", e)
            apps = systemctl("list-units", "--state=active", "--plain", "--no-legend", "web-app@*").stdout.split()
            for unit in [u for u in apps if u.startswith("web-app@")]:
                systemctl("stop", unit)    # its own stop starts Kodi again, stopped next line
            systemctl("stop", "kodi.service")
        try:
            self.card, w, h = light_screen()
            self.size = (w, h)
        except (OSError, AttributeError) as e:
            say("could not set the TV mode:", e)
        self.draw()
        say("screen taken from Kodi at %dx%d" % self.size)

    def draw(self):
        """(Re)start the drawer if it is not running, and feed it."""
        if self.drawer is None or self.drawer.poll() is not None:
            if self.drawer is not None:
                say("drawer exited with", self.drawer.returncode)
                self.drawer.stdin.close()
            big = os.path.exists(DRAW_LOG) and os.path.getsize(DRAW_LOG) > LOG_MAX
            with open(DRAW_LOG, "w" if big else "a") as out:
                out.write("--- %s\n" % time.strftime("%H:%M:%S"))
                out.flush()
                self.drawer = subprocess.Popen(drawer(), stdin=subprocess.PIPE, stdout=out,
                                               stderr=subprocess.STDOUT, bufsize=0)
            roomy(self.drawer.stdin.fileno())
            self.relay.attach(self.drawer.stdin.fileno())

    def give_back(self):
        if self.drawer is not None:
            self.drawer.terminate()   # first: a write to it may be holding the relay's lock
            try:
                self.drawer.wait(5)
            except subprocess.TimeoutExpired:
                self.drawer.kill()
                self.drawer.wait()
            self.relay.reset()
            self.drawer.stdin.close()
            self.drawer = None
        if self.card is not None:
            os.close(self.card)
            self.card = None
        try:
            os.remove(FLAG)
        except FileNotFoundError:
            pass
        released = False
        if self._display is not None:
            try:
                self._display.release(owner="airplay")
                released = True
            except DisplayError as e:
                say("displayd release skipped:", e)
                released = True
            except (OSError, EOFError) as e:
                say("displayd release failed, falling back to systemctl:", e)
            finally:
                self._display.close()
                self._display = None
        else:
            client = DisplayClient()
            try:
                if client.status().get("state") == "CAST_AIRPLAY":
                    client.release(owner="airplay", force=True)
                released = True
            except (OSError, EOFError, DisplayError):
                pass
            finally:
                client.close()
        if not released:
            systemctl("start", "--no-block", "kodi.service")
        say("screen given back to Kodi")


def roomy(fd):
    """A 1 MB pipe instead of 64 KB: a few pictures of slack while the other side is busy."""
    try:
        fcntl.fcntl(fd, F_SETPIPE_SZ, 1 << 20)
    except OSError:
        pass


F_SETPIPE_SZ = 1031


def pump(fd, relay):
    while True:
        data = os.read(fd, 1 << 16)
        if not data:
            return
        relay.feed(data)


def _append_log(log, line):
    if log.tell() >= LOG_MAX:
        log.seek(0)
        log.truncate(0)
    log.write(line + "\n")
    log.flush()


def main():
    os.makedirs(RUN, exist_ok=True)
    relay = Relay()
    screen = Screen(relay)
    if screen.taken:            # left over from a crash
        screen.give_back()
    for stale in STALE:
        try:
            os.remove(stale)
        except FileNotFoundError:
            pass
    video_r, video_w = os.pipe()
    roomy(video_w)
    proc = subprocess.Popen(uxplay(video_w), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace", bufsize=1, pass_fds=(video_w,))
    os.close(video_w)   # UxPlay has it; the read below ends when UxPlay does
    # the boot picture for the 1080p switch made now, not when the first phone is waiting
    threading.Thread(target=splash_pixels, args=(1920, 1080), daemon=True).start()
    threading.Thread(target=pump, args=(video_r, relay), daemon=True).start()
    lines = queue.Queue()

    def reader():
        for line in proc.stdout:
            lines.put(line.rstrip("\n"))
        lines.put(None)
    threading.Thread(target=reader, daemon=True).start()

    log = open(LOG, "w")
    open_now, empty_since = 0, None
    try:
        while True:
            try:
                line = lines.get(timeout=1)
            except queue.Empty:
                line = ""
            if line is None:
                break
            if line:
                _append_log(log, line)
                if not line.startswith("GStreamer") and ("onnect" in line or "stream" in line or "rror" in line):
                    print(line, flush=True)
                m = OPEN.search(line)
                if m:
                    open_now = int(m.group(1))
                if AUDIO_START.search(line) and not screen.taken:
                    say("audio-only AirPlay connected: pausing Kodi")
                    pause_kodi()
                if START.search(line) and not screen.taken:
                    if may_take():
                        screen.take()
                    else:
                        say("a PC is casting through miracast: the phone is ignored")
            if screen.taken:
                screen.draw()
                if open_now:
                    empty_since = None
                elif empty_since is None:
                    empty_since = time.monotonic()
                elif time.monotonic() - empty_since > BACK_AFTER:
                    screen.give_back()
                    empty_since = None
    finally:
        log.close()
        if screen.taken:
            screen.give_back()
    raise SystemExit(proc.wait())


if __name__ == "__main__":
    main()
