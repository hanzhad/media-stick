# Least-privilege sudo allowlist for user media (Kodi and web panel actions).
media ALL=(root) NOPASSWD: /usr/bin/systemctl restart kodi.service
media ALL=(root) NOPASSWD: /usr/bin/systemctl reboot
media ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff
media ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block media-stick-update.service
media ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block web-app@netflix.service
media ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block web-app@disney.service
media ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block web-app@prime.service
media ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block web-app@max.service
media ALL=(root) NOPASSWD: /usr/bin/systemctl start --no-block web-app@youtube.service
media ALL=(root) NOPASSWD: /usr/local/sbin/media-stick-webapp-stop
media ALL=(root) NOPASSWD: /usr/local/bin/wifi-setup scan
media ALL=(root) NOPASSWD: /usr/local/bin/wifi-setup connect
media ALL=(root) NOPASSWD: /usr/local/bin/media-stick-https set
media ALL=(root) NOPASSWD: /usr/local/bin/media-stick-https status
media ALL=(root) NOPASSWD: /usr/local/bin/media-stick-https clear
