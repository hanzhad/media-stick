[Unit]
Description=Web app %i full screen on the TV (Chromium in cage)
# Takes the screen from Kodi; Kodi comes back when this stops, however it stops.
Conflicts=kodi.service getty@tty1.service
After=kodi.service

[Service]
User=media
Group=media
SupplementaryGroups=video render audio input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
MemoryHigh=450M
MemoryMax=580M
OOMScoreAdjust=500
ExecStart=/usr/local/bin/web-app %i
ExecStopPost=+/bin/systemctl start --no-block kodi.service
Restart=no
