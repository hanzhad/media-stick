[Unit]
Description=Web app %i full screen on the TV (Chromium in cage)
# Display lifecycle is arbitrated by mediastick-displayd; notify it on stop so Kodi returns
# only if this web app still owns the display.
Conflicts=getty@tty1.service
After=mediastick-displayd.service

[Service]
User=media
Group=media
SupplementaryGroups=video render audio input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
MemoryHigh=450M
MemoryMax=580M
OOMScoreAdjust=500
ExecStart=/usr/local/bin/web-app %i
ExecStopPost=-/usr/bin/python3 -c 'import sys; sys.path.insert(0, "/usr/local/lib/media-stick"); from mediastick_display import DisplayClient; c = DisplayClient(timeout=0.5); st = c.status(); c.close(); (DisplayClient(timeout=15.0).release(force=True) if st.get("state") == "WEB_APP" and st.get("app") == sys.argv[1] else None)' %i
Restart=no
