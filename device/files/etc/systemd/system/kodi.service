[Unit]
Description=Kodi on the TV (GBM, no desktop)
After=network-online.target systemd-user-sessions.service sound.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=media
Group=media
SupplementaryGroups=video render audio input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/kodi --standalone --windowing=gbm
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
