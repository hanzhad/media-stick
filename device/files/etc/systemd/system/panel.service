[Unit]
Description=Media Stick page: remote, screen, settings, Wi-Fi setup (port 80)
After=network.target kodi.service

[Service]
User=media
SupplementaryGroups=systemd-journal
Environment=XDG_RUNTIME_DIR=/run/user/1000
AmbientCapabilities=CAP_NET_BIND_SERVICE
OOMScoreAdjust=-200
ExecStart=/usr/bin/python3 /usr/local/bin/panel
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
