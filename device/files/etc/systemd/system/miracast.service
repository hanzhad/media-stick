[Unit]
Description=Miracast receiver: Windows Win+K "Cast" to the TV (MS-MICE, Wi-Fi Display)
After=network-online.target NetworkManager.service wpa_supplicant.service avahi-daemon.service sound.target
Wants=network-online.target NetworkManager.service avahi-daemon.service

[Service]
# root for wpa_supplicant, stopping and starting Kodi; the drawer runs as media (see the program)
EnvironmentFile=-/etc/media-stick/local.env
ExecStart=/usr/local/bin/miracast
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
