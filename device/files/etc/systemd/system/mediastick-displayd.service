[Unit]
Description=Media Stick display and power-state arbitrator
Before=kodi.service airplay.service miracast.service panel.service
After=local-fs.target systemd-tmpfiles-setup.service

[Service]
Type=simple
Group=media
ExecStart=/usr/bin/python3 /usr/local/bin/mediastick-displayd
Restart=always
RestartSec=2
OOMScoreAdjust=-200
RuntimeDirectory=media-stick
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=1775
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
