[Unit]
Description=DuckDNS address and Let's Encrypt certificate for the panel (HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root: writes /etc/media-stick/tls and restarts panel.service. Does nothing until
# DUCKDNS_DOMAIN and DUCKDNS_TOKEN are in /etc/media-stick/secrets.env.
ExecStart=/usr/local/bin/media-stick-cert
TimeoutStartSec=15min
Nice=10
