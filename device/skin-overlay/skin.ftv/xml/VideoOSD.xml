<?xml version="1.0" encoding="UTF-8"?>
<!-- media-stick overlay of skin.ftv 8.0.1 VideoOSD.xml, written by hand (stage/osd.py) after the approved mockup.
     Differs from upstream: the title and tags sit above a thick bar (includes MsPlayerTitle and VideoPlayerDetails)
     instead of at the top; the transport buttons are circles (ms-circle.png) with the skin's icons drawn over them,
     Play bigger, the focused one white with a dark icon and 10% larger; Stop is gone (Back leaves playback);
     the options are a row of chips at the right (Subtitles, Audio, Video, Bookmarks, plus 3D, DVD menu and
     colour management when they apply) instead of a column of right-aligned text; "Next video" is gone
     (the Next button does it); Left and Right move between the buttons and the chips. -->
<window>
	<!-- videoosd -->
	<onload condition="!Skin.HasSetting(HideOSDControls)">SetFocus(304)</onload>
	<onload condition="Skin.HasSetting(HideOSDControls)">SetFocus(12)</onload>
	<onunload>ClearProperty(VideoOSDSelect,home)</onunload>
	<controls>
		<control type="group">
			<visible>!Window.IsVisible(osdsubtitlesettings) + !Window.IsVisible(osdvideosettings) + !Window.IsVisible(osdaudiosettings) + !Window.IsVisible(videobookmarks) + !Window.IsVisible(subtitlesearch)</visible>
			<control type="image">
				<width>3840</width>
				<height>420</height>
				<texture border="1">osd/mask_top.png</texture>
			</control>
			<!-- Pause -->
			<control type="image">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>642</width>
				<height>682</height>
				<texture>osd/Pause.png</texture>
				<visible>Player.Paused</visible>
			</control>
			<include>VideoPlayerDetails</include>
			<include>MsPlayerTitle</include>
			<!-- transport: circles in a centred row, Play in the middle of the screen -->
			<control id="300" type="grouplist">
				<left>1144</left>
				<top>1883</top>
				<width>1552</width>
				<height>240</height>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<onleft>noop</onleft>
				<onright>100</onright>
				<itemgap>42</itemgap>
				<align>center</align>
				<orientation>horizontal</orientation>
				<usecontrolcoords>true</usecontrolcoords>
				<defaultcontrol always="true">304</defaultcontrol>
				<visible>!Skin.HasSetting(HideOSDControls)</visible>
				<control type="button" id="301">
					<!-- previous -->
					<top>45</top>
					<width>150</width>
					<height>150</height>
					<font/>
					<texturefocus>ms-circle.png</texturefocus>
					<texturenofocus colordiffuse="26ffffff">ms-circle.png</texturenofocus>
					<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="110" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
					<onclick>PlayerControl(Previous)</onclick>
				</control>
				<control type="button" id="302">
					<!-- rewind -->
					<top>45</top>
					<width>150</width>
					<height>150</height>
					<font/>
					<texturefocus>ms-circle.png</texturefocus>
					<texturenofocus colordiffuse="26ffffff">ms-circle.png</texturenofocus>
					<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="110" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
					<onclick condition="!Player.Paused + !Player.IsTempo">PlayerControl(Rewind)</onclick>
					<onclick condition="Player.Paused + Player.TempoEnabled">PlayerControl(Play)</onclick>
					<onclick condition="Player.Paused + Player.TempoEnabled">PlayerControl(TempoDown)</onclick>
					<onclick condition="Player.IsTempo + Player.TempoEnabled">PlayerControl(TempoDown)</onclick>
				</control>
				<control type="togglebutton" id="304">
					<!-- play / pause -->
					<top>24</top>
					<width>192</width>
					<height>192</height>
					<font/>
					<texturefocus>ms-circle.png</texturefocus>
					<texturenofocus colordiffuse="26ffffff">ms-circle.png</texturenofocus>
					<usealttexture>Player.Paused | Player.Forwarding | Player.Rewinding</usealttexture>
					<alttexturefocus>ms-circle.png</alttexturefocus>
					<alttexturenofocus colordiffuse="26ffffff">ms-circle.png</alttexturenofocus>
					<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="110" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
					<onclick>PlayerControl(Play)</onclick>
				</control>
				<control type="button" id="305">
					<!-- fast forward -->
					<top>45</top>
					<width>150</width>
					<height>150</height>
					<font/>
					<texturefocus>ms-circle.png</texturefocus>
					<texturenofocus colordiffuse="26ffffff">ms-circle.png</texturenofocus>
					<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="110" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
					<onclick condition="!Player.Paused + !Player.IsTempo">PlayerControl(Forward)</onclick>
					<onclick condition="Player.Paused + Player.TempoEnabled">PlayerControl(Play)</onclick>
					<onclick condition="Player.Paused + Player.TempoEnabled">PlayerControl(TempoUp)</onclick>
					<onclick condition="Player.IsTempo + Player.TempoEnabled">PlayerControl(TempoUp)</onclick>
				</control>
				<control type="button" id="306">
					<!-- next -->
					<top>45</top>
					<width>150</width>
					<height>150</height>
					<font/>
					<texturefocus>ms-circle.png</texturefocus>
					<texturenofocus colordiffuse="26ffffff">ms-circle.png</texturenofocus>
					<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto">Focus</animation>
					<animation effect="zoom" start="110" end="100" time="160" tween="cubic" easing="out" center="auto">UnFocus</animation>
					<onclick>PlayerControl(Next)</onclick>
				</control>
			</control>
			<!-- the skin's icons over the circles: white, dark on the focused circle, zoomed with it -->
			<control type="group">
				<visible>!Skin.HasSetting(HideOSDControls)</visible>
			<control type="image">
				<left>1467</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ffffffff">osd/osd_prev.png</texture>
				<visible>!Control.HasFocus(301)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(301)">Conditional</animation>
			</control>
			<control type="image">
				<left>1467</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ff0b0c10">osd/osd_prev.png</texture>
				<visible>Control.HasFocus(301)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(301)">Conditional</animation>
			</control>
			<control type="image">
				<left>1659</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ffffffff">osd/osd_rw.png</texture>
				<visible>!Control.HasFocus(302)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(302)">Conditional</animation>
			</control>
			<control type="image">
				<left>1659</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ff0b0c10">osd/osd_rw.png</texture>
				<visible>Control.HasFocus(302)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(302)">Conditional</animation>
			</control>
			<control type="image">
				<left>1860</left>
				<top>1943</top>
				<width>120</width>
				<height>120</height>
				<texture colordiffuse="ffffffff">osd/osd_pause.png</texture>
				<visible>!Control.HasFocus(304) + [!Player.Paused + !Player.Forwarding + !Player.Rewinding]</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(304)">Conditional</animation>
			</control>
			<control type="image">
				<left>1860</left>
				<top>1943</top>
				<width>120</width>
				<height>120</height>
				<texture colordiffuse="ff0b0c10">osd/osd_pause.png</texture>
				<visible>Control.HasFocus(304) + [!Player.Paused + !Player.Forwarding + !Player.Rewinding]</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(304)">Conditional</animation>
			</control>
			<control type="image">
				<left>1860</left>
				<top>1943</top>
				<width>120</width>
				<height>120</height>
				<texture colordiffuse="ffffffff">osd/osd_play.png</texture>
				<visible>!Control.HasFocus(304) + ![!Player.Paused + !Player.Forwarding + !Player.Rewinding]</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(304)">Conditional</animation>
			</control>
			<control type="image">
				<left>1860</left>
				<top>1943</top>
				<width>120</width>
				<height>120</height>
				<texture colordiffuse="ff0b0c10">osd/osd_play.png</texture>
				<visible>Control.HasFocus(304) + ![!Player.Paused + !Player.Forwarding + !Player.Rewinding]</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(304)">Conditional</animation>
			</control>
			<control type="image">
				<left>2085</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ffffffff">osd/osd_ff.png</texture>
				<visible>!Control.HasFocus(305)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(305)">Conditional</animation>
			</control>
			<control type="image">
				<left>2085</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ff0b0c10">osd/osd_ff.png</texture>
				<visible>Control.HasFocus(305)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(305)">Conditional</animation>
			</control>
			<control type="image">
				<left>2277</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ffffffff">osd/osd_next.png</texture>
				<visible>!Control.HasFocus(306)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(306)">Conditional</animation>
			</control>
			<control type="image">
				<left>2277</left>
				<top>1955</top>
				<width>96</width>
				<height>96</height>
				<texture colordiffuse="ff0b0c10">osd/osd_next.png</texture>
				<visible>Control.HasFocus(306)</visible>
				<animation effect="zoom" start="100" end="110" time="160" tween="cubic" easing="out" center="auto" reversible="true" condition="Control.HasFocus(306)">Conditional</animation>
			</control>
			</control>
			<!-- options: chips at the right end of the same row -->
			<control id="100" type="grouplist">
				<left>2079</left>
				<top>1945</top>
				<width>1600</width>
				<height>116</height>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<onleft condition="!Skin.HasSetting(HideOSDControls)">300</onleft>
				<onright>noop</onright>
				<itemgap>24</itemgap>
				<align>right</align>
				<orientation>horizontal</orientation>
				<visible>!Player.Forwarding + !Player.Rewinding</visible>
				<control id="10" type="button">
					<width>auto</width>
					<height>116</height>
					<font>Med24</font>
					<label>$LOCALIZE[31153]</label>
					<textoffsetx>48</textoffsetx>
					<aligny>center</aligny>
					<textcolor>e6ffffff</textcolor>
					<focusedcolor>ff000000</focusedcolor>
					<texturefocus border="47">ms-pill.png</texturefocus>
					<texturenofocus border="47" colordiffuse="26ffffff">ms-pill.png</texturenofocus>
					<onclick>Close</onclick>
					<onclick>StereoMode</onclick>
					<visible>VideoPlayer.IsStereoscopic</visible>
				</control>
				<control id="11" type="button">
					<width>auto</width>
					<height>116</height>
					<font>Med24</font>
					<label>$LOCALIZE[31136]</label>
					<textoffsetx>48</textoffsetx>
					<aligny>center</aligny>
					<textcolor>e6ffffff</textcolor>
					<focusedcolor>ff000000</focusedcolor>
					<texturefocus border="47">ms-pill.png</texturefocus>
					<texturenofocus border="47" colordiffuse="26ffffff">ms-pill.png</texturenofocus>
					<onclick>PlayerControl(ShowVideoMenu)</onclick>
					<visible>VideoPlayer.HasMenu</visible>
				</control>
				<control id="12" type="button">
					<width>auto</width>
					<height>116</height>
					<font>Med24</font>
					<label>$LOCALIZE[287]</label>
					<textoffsetx>48</textoffsetx>
