			<texturebg border="12" colordiffuse="33ffffff">ms-bar.png</texturebg>
			<lefttexture/>
			<midtexture border="12" colordiffuse="40ffffff">ms-bar.png</midtexture>
			<righttexture/>
			<overlaytexture/>
		</control>
		<!--  Progress bar -->
