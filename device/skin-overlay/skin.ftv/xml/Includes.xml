			<texturebg colordiffuse="00ffffff" border="12">osd/progress_bar_back.png</texturebg>
			<righttexture>osd/progress_bar_chapter.png</righttexture>
		</control>
		<!--  Chapters -->
		<control id="99" type="ranges">
			<left>161</left>
			<top>1775</top>
			<width>3518</width>
			<height>24</height>
			<info>Player.Chapters</info>
			<texturebg colordiffuse="00ffffff" border="12">osd/progress_bar_back.png</texturebg>
			<righttexture>osd/progress_bar_chapter.png</righttexture>
		</control>
		<!--  Elapsed -->
		<control id="99" type="label">
			<left>161</left>
			<top>1831</top>
			<width>1200</width>
			<height>60</height>
			<font>Med24</font>
			<textcolor>e6ffffff</textcolor>
			<shadowcolor>ShadowColour</shadowcolor>
			<label>$VAR[PlayerTime]</label>
		</control>
		<!--  Left and finish time -->
		<control id="99" type="label">
			<left>1879</left>
			<top>1831</top>
			<width>1800</width>
			<height>60</height>
			<font>Med24</font>
			<align>right</align>
			<textcolor>e6ffffff</textcolor>
			<shadowcolor>ShadowColour</shadowcolor>
			<label>$INFO[Player.TimeRemaining,−,]$INFO[Player.FinishTime,[COLOR 99ffffff]   ·   ends at ,[/COLOR]]</label>
		</control>
		<!--  X-Ray -->
		<control id="99" type="grouplist">
			<centerleft>50%</centerleft>
			<top>1823</top>
			<height>84</height>
			<itemgap>20</itemgap>
			<align>center</align>
			<orientation>horizontal</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<visible>!String.IsEmpty(Container(1000).ListItem.Label)</visible>
