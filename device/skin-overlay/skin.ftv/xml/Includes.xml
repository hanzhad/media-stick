				<width>auto</width>
				<height>84</height>
				<font>Med24</font>
				<textcolor>e6ffffff</textcolor>
				<label>31233</label>
			</control>
			<control id="99" type="image">
				<top>8</top>
				<width>80</width>
				<height>76</height>
				<texture>osd/x_ray.png</texture>
			</control>
		</control>
	</include>
