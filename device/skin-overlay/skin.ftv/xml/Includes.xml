<?xml version="1.0" encoding="UTF-8"?>
<!-- media-stick overlay of skin.ftv 8.0.1 (generated by stage/build_overlay.py). Differs from upstream: progress fill -> white_square.png x1; message panel -> ms-pill.png F2141922 x1; dialog background fade-in 220 ms x2; dialog background fade-out 180 ms x2.; third pass: BackgroundImage is the blurred launcher wallpapers (/var/cache/media-stick/wallpapers-blur) under a dark veil, DialogBackgroundImage a plain dark veil, MessageBackground the rounded ms-card.png.; third pass, playback: VideoPlayerDetails is a shade, a thick rounded bar (ms-bar.png) and the times under it; new MsPlayerTitle (clock, title, tags) for the OSD and the seek bar. -->
<includes>
	<include file="Defaults.xml"/>
	<include file="Includes_Animations.xml"/>
	<include file="Includes_Expressions.xml"/>
	<include file="Includes_Parameters.xml"/>
	<include file="Includes_Variables.xml"/>
	<include file="Includes_AddonBrowser.xml"/>
	<include file="Includes_Dialog_Video_Information.xml"/>
	<include file="Includes_Dialog_Person_Information.xml"/>
	<include file="Includes_Dialog_Set_Information.xml"/>
	<include file="Includes_Dialog_Movie_TV_Information.xml"/>
	<include file="Includes_Dialog_Default_Video_Information.xml"/>
	<include file="Includes_DialogSelect.xml"/>
	<include file="Includes_DialogSettings.xml"/>
	<include file="Includes_DialogGameControllers.xml"/>
	<include file="Includes_Home_Widgets_Setup.xml"/>
	<include file="Viewtype50.xml"/>
	<include file="Viewtype51.xml"/>
	<include file="Viewtype52.xml"/>
	<include file="Viewtype53.xml"/>
	<include file="Viewtype54.xml"/>
	<include file="Viewtype55.xml"/>
	<include file="Viewtype56.xml"/>
	<include file="ForcedViewtype60.xml"/>
	<include file="ForcedViewtype61.xml"/>
	<include file="script-skinviewtypes-includes.xml"/>
	<include file="script-skinshortcuts-includes.xml"/>
	<!-- Fullscreen dimensions -->
	<include name="FullscreenDimensions">
		<left>0</left>
		<top>0</top>
		<width>3840</width>
		<height>2160</height>
	</include>
	<!-- Background image -->
	<include name="BackgroundImage">
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture colordiffuse="BackgroundColour">common/white_square.png</texture>
		</control>
		<!-- media-stick: the launcher's photos, blurred ahead of time by media-stick-wallpapers
		     (Kodi blurs nothing itself), dimmed so white text reads on any photo -->
		<control type="multiimage">
			<include>FullscreenDimensions</include>
			<imagepath>/var/cache/media-stick/wallpapers-blur/</imagepath>
			<timeperimage>60000</timeperimage>
			<fadetime>2000</fadetime>
			<randomize>true</randomize>
			<aspectratio>scale</aspectratio>
		</control>
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture colordiffuse="99080a12">common/white_square.png</texture>
		</control>
	</include>
	<!-- Debug window label -->
	<include name="DebugWindowLabel">
		<width>3840</width>
		<height>42</height>
		<textcolor>FF0000FF</textcolor>
		<shadowcolor>ShadowColour</shadowcolor>
		<font>font13</font>
		<align>left</align>
	</include>
	<!-- Debug dialog label -->
	<include name="DebugDialogLabel">
		<width>3840</width>
		<height>42</height>
		<textcolor>FFFF0000</textcolor>
		<shadowcolor>ShadowColour</shadowcolor>
		<font>font13</font>
		<align>left</align>
	</include>
	<!-- Debug control label -->
	<include name="DebugControlLabel">
		<width>2800</width>
		<height>42</height>
		<textcolor>FFFF0000</textcolor>
		<shadowcolor>ShadowColour</shadowcolor>
		<font>font13</font>
		<align>right</align>
	</include>
	<!-- Dialog background image -->
	<include name="DialogBackgroundImage">
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture colordiffuse="a6060810">common/white_square.png</texture>
			<animation effect="fade" end="100" start="0" time="220" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" end="0" start="100" time="180" tween="cubic" easing="in">WindowClose</animation>
		</control>
	</include>
	<!-- Dialog text background image -->
	<include name="DialogTextBackgroundImage">
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture colordiffuse="a6060810">common/white_square.png</texture>
			<animation effect="fade" end="100" start="0" time="220" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" end="0" start="100" time="180" tween="cubic" easing="in">WindowClose</animation>
		</control>
	</include>
	<!-- Message Background image -->
	<include name="MessageBackground">
		<texture border="76" colordiffuse="DialogBackColour">ms-card.png</texture>
		<bordersize>-104</bordersize>
	</include>
	<!-- Widths -->
	<include name="Width390">
		<width>390</width>
	</include>
	<include name="Width584">
		<width>584</width>
	</include>
	<include name="Width1346">
		<width>1346</width>
	</include>
	<include name="Width1540">
		<width>1540</width>
	</include>
	<include name="Width1430">
		<width>1430</width>
	</include>
	<include name="Width1624">
		<width>1624</width>
	</include>
	<!-- OSD Padding -->
	<include name="osd_padding">
		<height>164</height>
		<width>35</width>
		<texture/>
	</include>
	<!-- Hidden List -->
	<include name="HiddenList">
		<top>-20</top>
		<width>20</width>
		<height>1</height>
		<viewtype label="">list</viewtype>
		<orientation>horizontal</orientation>
		<itemlayout height="1" width="1"/>
		<focusedlayout height="1" width="1"/>
	</include>
	<!-- Cast list -->
	<include name="CastList">
		<control type="list" id="50">
			<include>HiddenList</include>
		</control>
	</include>
	<!-- Fanart -->
	<include name="Fanart">
		<control type="group">
			<animation condition="!Window.Previous(visualisation)" delay="800" effect="fade" end="100" start="0" time="200">WindowOpen</animation>
			<control type="image">
				<include>FullscreenDimensions</include>
				<fadetime>400</fadetime>
				<colordiffuse>26ffffff</colordiffuse>
				<texture background="true">$VAR[Fanart]</texture>
			</control>
		</control>
	</include>
	<!-- No textures -->
	<include name="NoTextures">
		<texturefocus/>
		<texturenofocus/>
		<alttexturenofocus/>
		<alttexturefocus/>
		<textureradioonfocus/>
		<textureradioonnofocus/>
		<textureradioofffocus/>
		<textureradiooffnofocus/>
		<textureup/>
		<texturedown/>
		<textureupfocus/>
		<texturedownfocus/>
	</include>
	<!-- Hidden control -->
