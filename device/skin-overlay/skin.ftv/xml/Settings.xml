<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- settings -->
	<!--
		media-stick overlay. Replaces upstream skin.ftv Settings.xml: the launcher's side-menu look
		instead of the row of grey tiles. A vertical list of pills (icon + label, 192 tall, white pill
		and black text on focus) on the left, the focused category's big icon and description on the
		right. Only the categories this device uses: Games (no games here) and "More" (a second
		System entry plus file manager and profiles) are gone; System info is a list item of its own.
		The settings level button moved into SettingsCategory.xml.
	-->
	<backgroundcolor>BackgroundColour</backgroundcolor>
	<onload>Dialog.Close(all,true)</onload>
	<defaultcontrol always="true">9000</defaultcontrol>
	<animation type="WindowOpen">
		<effect type="fade" start="0" end="100" time="220" tween="cubic" easing="out"/>
	</animation>
	<animation type="WindowClose">
		<effect type="fade" start="100" end="0" time="180" tween="cubic" easing="in"/>
	</animation>
	<controls>
		<include>BackgroundImage</include>
		<control type="label">
			<left>192</left>
			<top>112</top>
			<width>2400</width>
			<height>200</height>
			<font>MsTitle</font>
			<aligny>center</aligny>
			<textcolor>ffffffff</textcolor>
			<label>$LOCALIZE[5]</label>
		</control>
		<control id="9000" type="list">
			<left>144</left>
			<top>400</top>
			<width>940</width>
			<height>1536</height>
			<onup>9000</onup>
			<ondown>9000</ondown>
			<onleft>noop</onleft>
			<onright>noop</onright>
			<orientation>vertical</orientation>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<itemlayout height="192" width="940">
				<control type="image">
					<left>64</left>
					<top>48</top>
					<width>96</width>
					<height>96</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[ListItem.Icon]</texture>
					<colordiffuse>b3ffffff</colordiffuse>
				</control>
				<control type="label">
					<left>216</left>
					<width>700</width>
					<height>192</height>
					<font>Med32</font>
					<aligny>center</aligny>
					<textcolor>b3ffffff</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="192" width="940">
				<control type="image">
					<width>940</width>
					<height>192</height>
					<texture border="47">ms-pill.png</texture>
					<visible>Control.HasFocus(9000)</visible>
				</control>
				<control type="image">
					<left>64</left>
					<top>48</top>
					<width>96</width>
					<height>96</height>
					<aspectratio>keep</aspectratio>
					<texture>$INFO[ListItem.Icon]</texture>
					<colordiffuse>ff000000</colordiffuse>
				</control>
				<control type="label">
					<left>216</left>
					<width>700</width>
					<height>192</height>
					<font>Med32</font>
					<aligny>center</aligny>
					<textcolor>ff000000</textcolor>
					<selectedcolor>ff000000</selectedcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>14206</label>
					<label2>$LOCALIZE[31115]</label2>
					<icon>settings/icon_appearance.png</icon>
					<onclick>ActivateWindow(interfacesettings)</onclick>
				</item>
				<item>
					<label>14200</label>
					<label2>$LOCALIZE[31117]</label2>
					<icon>settings/icon_player.png</icon>
					<onclick>ActivateWindow(playersettings)</onclick>
				</item>
				<item>
					<label>14211</label>
					<label2>$LOCALIZE[31118]</label2>
					<icon>settings/icon_library.png</icon>
					<onclick>ActivateWindow(mediasettings)</onclick>
				</item>
				<item>
					<label>13000</label>
					<label2>$LOCALIZE[31121]</label2>
					<icon>settings/icon_system.png</icon>
					<onclick>ActivateWindow(systemsettings)</onclick>
				</item>
				<item>
					<label>14036</label>
					<label2>$LOCALIZE[31122]</label2>
					<icon>settings/icon_service.png</icon>
					<onclick>ActivateWindow(servicesettings)</onclick>
				</item>
				<item>
					<label>24001</label>
					<label2>$LOCALIZE[31116]</label2>
					<icon>settings/icon_addons.png</icon>
					<onclick>ActivateWindow(addonbrowser,addons://)</onclick>
				</item>
				<item>
					<label>130</label>
					<label2>$LOCALIZE[31127]</label2>
					<icon>settings/icon_more.png</icon>
					<onclick>ActivateWindow(systeminfo)</onclick>
				</item>
			</content>
		</control>
		<!-- right: the focused category, big and faint, with what it holds, on a glass card -->
		<control type="image">
			<left>1280</left>
			<top>368</top>
			<width>2448</width>
			<height>1712</height>
			<texture border="76" colordiffuse="66141620">ms-card.png</texture>
		</control>
		<control type="image">
			<left>1400</left>
			<top>400</top>
			<width>480</width>
			<height>480</height>
			<aspectratio align="left" aligny="top">keep</aspectratio>
			<texture>$INFO[Container(9000).ListItem.Icon]</texture>
			<colordiffuse>59ffffff</colordiffuse>
		</control>
		<control type="textbox">
			<left>1400</left>
			<top>960</top>
			<width>2000</width>
			<height>400</height>
			<font>Light32</font>
			<textcolor>b3ffffff</textcolor>
			<label>$INFO[Container(9000).ListItem.Label2]</label>
		</control>
	</controls>
</window>
