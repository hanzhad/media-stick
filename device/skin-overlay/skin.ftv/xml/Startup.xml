<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- startup -->
	<!--
		media-stick overlay. Differs from upstream skin.ftv Startup.xml:
		- No splash: the StartUp property that shows window 1108 (fTV logo) and starts the
		  4 s autoclosestartupscreen timer in Timers.xml is never set, so 1108 stays invisible and
		  the timer never runs. Timers.xml and Custom_1108 are left as they are.
		- No background fill (upstream BackgroundColour): the boot picture instead (Kodi's own
		  splash, special://home/media/splash.png, also Plymouth's), so the TV keeps showing it
		  while this window hands over to the startup window (Home, which the launcher then covers).
		- The first-run block (about 450 lines of Home widget/menu defaults) is dropped: it only
		  configured the skin Home, which is not shown. The non-widget settings it made are kept.
		Kodi opens this window at boot whenever the skin has Startup.xml, so it must stay and
		must still ReplaceWindow to the startup window.
	-->
	<defaultcontrol always="true">99</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>3840</width>
			<height>2160</height>
			<aspectratio>scale</aspectratio>
			<texture>special://home/media/splash.png</texture>
		</control>
		<control type="button" id="99">
			<include>HiddenControl</include>
			<onfocus condition="Skin.HasSetting(firstrun)">ReplaceWindow($INFO[System.StartupWindow])</onfocus>
			<onfocus condition="!Skin.HasSetting(firstrun)">SetFocus(100)</onfocus>
		</control>
		<control type="button" id="100">
			<include>HiddenControl</include>
			<onfocus>Skin.SetString(skinshortcuts-sharedmenu,false)</onfocus>
			<onfocus>Skin.SetBool(ExtendedInfo)</onfocus>
			<onfocus>Skin.SetBool(EnableFanart)</onfocus>
			<onfocus>Skin.SetBool(EnableXRay)</onfocus>
			<onfocus>Skin.SetBool(TomatoMeterAllCritics)</onfocus>
			<onfocus>Skin.SetBool(US)</onfocus>
			<onfocus>Skin.SetBool(firstrun)</onfocus>
			<onfocus>ReplaceWindow($INFO[System.StartupWindow])</onfocus>
		</control>
	</controls>
</window>
