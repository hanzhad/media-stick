<?xml version="1.0" encoding="UTF-8"?>
<!-- media-stick overlay of skin.ftv 8.0.1 (generated by stage/build_overlay.py). Differs from upstream: unfocused text ffffffff -> b3ffffff x4; amber hex -> ffffffff x4; focus fill -> ms-pill.png border 47 x5; focused label -> ff000000 x5; progress fill -> white_square.png x1; second pass (stage/gen2.py): row separator lines removed x5; hand edit: OSD settings rows get the focus pill. -->
<includes>
	<include name="Includes_DialogSettings_Default">
		<include>DialogBackgroundImage</include>
		<!-- Main group -->
		<control type="group">
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>2756</width>
			<height>960</height>
			<include>DialogSlideAnimation</include>
			<include content="DialogZoomAnimation">
				<param name="OpenCondition" value="!Window.IsVisible(settingscategory.xml) + !Window.IsVisible(addonbrowser)"/>
				<param name="CloseCondition" value="!Window.IsVisible(settingscategory.xml)"/>
			</include>
			<include content="DialogBack"/>
			<!-- Heading -->
			<include content="DialogHeading">
				<param name="dialog_heading_label_id" value="2"/>
			</include>
			<!-- Grouplist -->
			<control type="grouplist" id="5">
				<top>120</top>
				<width>1956</width>
				<height>840</height>
				<itemgap>0</itemgap>
				<onleft>noop</onleft>
				<onright>9001</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<scrolltime>0</scrolltime>
				<orientation>vertical</orientation>
				<usecontrolcoords>true</usecontrolcoords>
			</control>
			<!-- Default button -->
			<control type="button" id="7">
				<width>1956</width>
				<height>168</height>
				<font>Light32</font>
				<textoffsetx>80</textoffsetx>
				<textcolor>NotFocusedColour</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
			</control>
			<!-- Default radiobutton -->
			<control type="radiobutton" id="8">
				<width>1956</width>
				<height>168</height>
				<font>Light32</font>
				<textwidth>1508</textwidth>
				<textoffsetx>80</textoffsetx>
				<textcolor>NotFocusedColour</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<radiowidth>250</radiowidth>
				<radioheight>106</radioheight>
				<radioposx>1646</radioposx>
				<textureradioonfocus>settings/radio_on_focus.png</textureradioonfocus>
				<textureradioonnofocus>settings/radio_on_no_focus.png</textureradioonnofocus>
				<textureradioondisabled>settings/radio_on_disabled.png</textureradioondisabled>
				<textureradioofffocus>settings/radio_off_focus.png</textureradioofffocus>
				<textureradiooffnofocus>settings/radio_off_no_focus.png</textureradiooffnofocus>
				<textureradiooffdisabled>settings/radio_off_disabled.png</textureradiooffdisabled>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
			</control>
			<!-- Default spincontrolex -->
			<control type="spincontrolex" id="9">
				<width>1956</width>
				<height>168</height>
				<font>Light32</font>
				<textwidth>1476</textwidth>
				<textoffsetx>80</textoffsetx>
				<textcolor>NotFocusedColour</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<selectedcolor>SelectedColour</selectedcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
				<aligny>center</aligny>
				<reverse>yes</reverse>
			</control>
			<!-- Default seperator -->
			<control id="11" type="image">
				<top>-4</top>
				<height>4</height>
				<texture>dialogs/default_line.png</texture>
			</control>
			<!-- Default edit -->
			<control type="edit" id="12">
				<width>1956</width>
				<height>168</height>
				<font>Light32</font>
				<textoffsetx>80</textoffsetx>
				<textcolor>NotFocusedColour</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
			</control>
			<!-- Default slider -->
			<control type="sliderex" id="13">
				<width>1956</width>
				<height>168</height>
				<font>Light32</font>
				<textwidth>1476</textwidth>
				<textoffsetx>80</textoffsetx>
				<textcolor>NotFocusedColour</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
				<sliderwidth>400</sliderwidth>
				<sliderheight>24</sliderheight>
				<texturesliderbar border="12">osd/progress_bar_back.png</texturesliderbar>
				<texturesliderbardisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_back.png</texturesliderbardisabled>
				<textureslidernib border="12">osd/progress_bar_cache.png</textureslidernib>
				<textureslidernibdisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_cache.png</textureslidernibdisabled>
				<textureslidernibfocus>common/white_square.png</textureslidernibfocus>
			</control>
			<!-- Default label -->
			<control type="label" id="14">
				<width>1956</width>
				<height>168</height>
				<font>Bold30</font>
				<textoffsetx>80</textoffsetx>
				<textcolor>ffdadada</textcolor>
			</control>
			<control type="grouplist" id="9001">
				<right>48</right>
				<bottom>66</bottom>
				<width>704</width>
				<height>840</height>
				<onleft>5</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<onback>5</onback>
				<itemgap>20</itemgap>
				<align>right</align>
				<!-- Settings Button -->
				<include content="DialogButton">
					<param name="button_id" value="30"/>
					<param name="button_label" value=""/>
					<param name="button_visible" value="Control.IsEnabled(30)"/>
				</include>
				<!-- Cancel Button -->
				<include content="DialogButton">
					<param name="button_id" value="29"/>
					<param name="button_label" value=""/>
					<param name="button_visible" value="Control.IsEnabled(29)"/>
				</include>
				<!-- OK Button -->
				<include content="DialogButton">
					<param name="button_id" value="28"/>
					<param name="button_label" value=""/>
					<param name="button_visible" value="Control.IsEnabled(28)"/>
				</include>
			</control>
		</control>
	</include>
	<include name="Includes_DialogSettings_OSDSettings">
		<!-- media-stick: rows as everywhere else: white pill with black text on focus (the stock panel
		     only brightened the text, which reads as no focus at all on a TV) -->
		<control type="group">
			<top>1310</top>
			<animation effect="fade" start="100" end="0" time="200" condition="Window.IsVisible(subtitlesearch) | Window.IsVisible(SliderDialog) | Window.IsVisible(FileBrowser)">Conditional</animation>
			<!-- Background -->
			<control type="image">
				<width>3840</width>
				<height>850</height>
				<texture>osd/mask.png</texture>
			</control>
			<!-- Heading label -->
			<control type="label" id="2">
				<left>238</left>
				<top>40</top>
				<height>72</height>
				<font>Bold30</font>
				<textcolor>ffdadada</textcolor>
			</control>
			<!-- Grouplist -->
			<control type="grouplist" id="5">
				<left>174</left>
				<top>120</top>
				<width>3492</width>
				<height>696</height>
				<itemgap>0</itemgap>
				<onleft>noop</onleft>
				<onright>noop</onright>
				<onup>noop</onup>
				<ondown>noop</ondown>
				<orientation>vertical</orientation>
				<scrolltime tween="sine" easing="out">240</scrolltime>
			</control>
			<!-- Default button -->
			<control type="button" id="7">
				<height>116</height>
				<font>Light32</font>
				<textoffsetx>64</textoffsetx>
				<textcolor>b3ffffff</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<disabledcolor>88ffffff</disabledcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
			</control>
			<!-- Default radiobutton -->
			<control type="radiobutton" id="8">
				<height>116</height>
				<font>Light32</font>
				<textoffsetx>64</textoffsetx>
				<textcolor>b3ffffff</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<disabledcolor>88ffffff</disabledcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
				<radioposx>1416</radioposx>
				<radiowidth/>
				<radioheight/>
				<textureradioonfocus/>
				<textureradioonnofocus/>
				<textureradioofffocus/>
				<textureradiooffnofocus/>
			</control>
			<!-- Default spincontrolex -->
			<control type="spincontrolex" id="9">
				<height>116</height>
				<font>Light32</font>
				<textoffsetx>64</textoffsetx>
				<textcolor>b3ffffff</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<disabledcolor>88ffffff</disabledcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
			</control>
			<!-- Default sliderex -->
			<control type="sliderex" id="13">
				<height>116</height>
				<font>Light32</font>
				<textoffsetx>64</textoffsetx>
				<textcolor>b3ffffff</textcolor>
				<focusedcolor>ff000000</focusedcolor>
				<disabledcolor>88ffffff</disabledcolor>
				<texturefocus border="47">ms-pill.png</texturefocus>
				<texturenofocus/>
				<sliderwidth>400</sliderwidth>
				<sliderheight>24</sliderheight>
				<texturesliderbar border="12" colordiffuse="ff808080">osd/progress_bar_back.png</texturesliderbar>
				<textureslidernib border="12">osd/progress_bar_cache.png</textureslidernib>
				<textureslidernibfocus border="12" colordiffuse="ff000000">osd/progress_bar_cache.png</textureslidernibfocus>
			</control>
		</control>
	</include>
</includes>
