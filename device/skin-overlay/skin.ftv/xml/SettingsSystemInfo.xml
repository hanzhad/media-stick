<window>
	<!-- systeminfo -->
	<!--
		media-stick overlay. Replaces upstream skin.ftv SettingsSystemInfo.xml (hub tiles plus a
		sliding panel) with the layout of our SettingsCategory.xml: "Settings" small and "System
		info" big at the top, the pages as pills on the left (Summary, Storage, Network, Video,
		Hardware, Kodi build, Privacy policy), the focused page's lines on the right (ids 2-11,
		filled by Kodi). Summary and Privacy policy are drawn by the skin, as upstream.
	-->
