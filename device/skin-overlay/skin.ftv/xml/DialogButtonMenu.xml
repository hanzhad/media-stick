<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- shutdownmenu -->
	<!--
		media-stick overlay. Differs from upstream skin.ftv DialogButtonMenu.xml: the list is three
		static items (Restart Kodi, Reboot, Power off) instead of the skinshortcuts shutdown group
		(Quit, Suspend, Hibernate, timers, log off, ...). Same sudo commands as the launcher's
		Power menu (script.media-stick.home launcher.py POWER). The list is a centred plain list
		with focus on the first item, and open/close use the 220/180 ms cubic fades of the other dialogs.
	-->
	<defaultcontrol always="true">6000</defaultcontrol>
	<animation type="WindowOpen">
		<effect center="auto" tween="cubic" easing="out" end="100" start="104" time="220" type="zoom"/>
		<effect easing="out" end="100" start="0" time="220" tween="cubic" type="fade"/>
	</animation>
	<animation easing="in" effect="fade" end="0" start="100" time="180" tween="cubic">WindowClose</animation>
	<controls>
		<!-- Background -->
		<control type="image">
			<include>FullscreenDimensions</include>
			<texture>special://skin/extras/backgrounds/shutdown.png</texture>
		</control>
		<!-- Time -->
		<control type="grouplist">
			<centerleft>50%</centerleft>
			<top>344</top>
			<width>3840</width>
			<height>296</height>
			<align>center</align>
			<itemgap>0</itemgap>
			<orientation>horizontal</orientation>
			<usecontrolcoords>true</usecontrolcoords>
			<control type="label">
				<width>auto</width>
				<height>296</height>
				<label>$INFO[System.Time(HH)]</label>
				<font>Light148</font>
				<textcolor>ffbfbcbb</textcolor>
			</control>
			<control type="group">
				<width>80</width>
				<height>296</height>
				<visible>String.EndsWith(System.Time(ss),0) | String.EndsWith(System.Time(ss),2) | String.EndsWith(System.Time(ss),4) | String.EndsWith(System.Time(ss),6) | String.EndsWith(System.Time(ss),8)</visible>
				<control type="label">
					<top>84</top>
					<width>80</width>
					<height>40</height>
					<label>·</label>
					<font>Light80</font>
					<align>center</align>
					<textcolor>ffbfbcbb</textcolor>
				</control>
				<control type="label">
					<top>192</top>
					<width>80</width>
					<height>40</height>
					<label>·</label>
					<font>Light80</font>
					<align>center</align>
					<textcolor>ffbfbcbb</textcolor>
				</control>
			</control>
			<control type="group">
				<width>80</width>
				<height>296</height>
				<visible>String.EndsWith(System.Time(ss),1) | String.EndsWith(System.Time(ss),3) | String.EndsWith(System.Time(ss),5) | String.EndsWith(System.Time(ss),7) | String.EndsWith(System.Time(ss),9)</visible>
				<control type="label">
					<top>84</top>
					<width>80</width>
					<height>40</height>
					<label>·</label>
					<font>Light80</font>
					<align>center</align>
					<textcolor>88bfbcbb</textcolor>
				</control>
				<control type="label">
					<top>192</top>
					<width>80</width>
					<height>40</height>
					<label>·</label>
					<font>Light80</font>
					<align>center</align>
					<textcolor>88bfbcbb</textcolor>
				</control>
			</control>
			<control type="label">
				<width>auto</width>
				<height>296</height>
				<label>$INFO[System.Time(mm)]</label>
				<font>Light148</font>
				<textcolor>ffbfbcbb</textcolor>
			</control>
			<control type="label">
				<top>158</top>
				<width>auto</width>
				<height>116</height>
				<label>$INFO[System.Time(xx)]</label>
				<font>Med58</font>
				<textcolor>ffbfbcbb</textcolor>
				<visible>!String.IsEmpty(System.Time(xx))</visible>
			</control>
		</control>
		<!-- List -->
		<!-- a plain list exactly three items wide, centred: focus starts on Restart Kodi, the
		     harmless one (upstream's fixedlist put it on the last item, Power off, which a Pi
		     cannot undo without pulling the plug) -->
		<control id="6000" type="list">
			<centerleft>50%</centerleft>
			<top>1084</top>
			<width>1368</width>
			<height>456</height>
			<scrolltime>0</scrolltime>
			<orientation>horizontal</orientation>
			<itemlayout height="456" width="456">
				<control type="image">
					<left>40</left>
					<width>376</width>
					<height>376</height>
					<texture border="6">common/button_nf.png</texture>
				</control>
				<control type="image">
					<left>140</left>
					<top>32</top>
					<width>176</width>
					<height>176</height>
					<texture fallback="shutdown/DefaultShortcut.png">$INFO[ListItem.Icon,shutdown/]</texture>
				</control>
				<control type="textbox">
					<left>60</left>
					<top>204</top>
					<width>336</width>
					<height>132</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>Med23Spaced</font>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>ffa5a5a6</textcolor>
				</control>
			</itemlayout>
			<focusedlayout height="456" width="456">
				<control type="image">
					<left>40</left>
					<width>376</width>
					<height>376</height>
					<texture border="6">common/button_fo.png</texture>
				</control>
				<control type="image">
					<left>140</left>
					<top>32</top>
					<width>176</width>
					<height>176</height>
					<colordiffuse>d9000000</colordiffuse>
					<texture fallback="shutdown/DefaultShortcut.png">$INFO[ListItem.Icon,shutdown/]</texture>
				</control>
				<control type="textbox">
					<left>60</left>
					<top>204</top>
					<width>336</width>
					<height>132</height>
					<align>center</align>
					<aligny>center</aligny>
					<font>Med23Spaced</font>
					<label>$INFO[ListItem.Label]</label>
					<textcolor>ff000000</textcolor>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>Restart Kodi</label>
					<icon>DefaultQuit.png</icon>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>System.Exec("sudo -n /bin/systemctl restart kodi.service")</onclick>
				</item>
				<item>
					<label>Reboot</label>
					<icon>DefaultShortcut.png</icon>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>System.Exec("sudo -n /bin/systemctl reboot")</onclick>
				</item>
				<item>
					<label>Power off</label>
					<icon>DefaultShutdown.png</icon>
					<onclick>Dialog.Close(shutdownmenu)</onclick>
					<onclick>System.Exec("sudo -n /bin/systemctl poweroff")</onclick>
				</item>
			</content>
		</control>
	</controls>
</window>
