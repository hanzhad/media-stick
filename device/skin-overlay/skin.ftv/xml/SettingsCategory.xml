<?xml version="1.0" encoding="UTF-8"?>
<window>
	<!-- settingscategory -->
	<!--
		media-stick overlay. Replaces upstream skin.ftv SettingsCategory.xml (the hub's tiles again,
		with a panel sliding over them) with the layout of our Settings.xml: "Settings" small and the
		category big at the top, its sections as pills on the left (id 3), the settings of the
		focused section always shown on the right (id 5), the focused item's description at the
		bottom (id 6, filled by Kodi). Right/left moves between the two columns, Back from the
		settings returns to the sections. The settings level button (id 20) sits under the sections.
		Rows have no separator lines; focus is the white pill with black text, as everywhere.
	-->
	<backgroundcolor>BackgroundColour</backgroundcolor>
	<defaultcontrol always="true">3</defaultcontrol>
	<animation type="WindowOpen">
		<effect type="fade" start="0" end="100" time="220" tween="cubic" easing="out"/>
	</animation>
	<animation type="WindowClose">
		<effect type="fade" start="100" end="0" time="180" tween="cubic" easing="in"/>
	</animation>
	<controls>
		<include>BackgroundImage</include>
		<!-- Kodi writes the focused item's description here; shown by the textbox below -->
		<control id="6" type="label">
			<font/>
		</control>
		<control type="label">
			<left>192</left>
			<top>96</top>
			<width>2400</width>
			<height>80</height>
			<font>Med28</font>
			<aligny>center</aligny>
			<textcolor>80ffffff</textcolor>
			<label>$LOCALIZE[5]</label>
		</control>
		<control type="grouplist">
			<left>192</left>
			<top>168</top>
			<width>2400</width>
			<height>160</height>
			<orientation>horizontal</orientation>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[14206]</label>
				<visible>Window.IsVisible(interfacesettings)</visible>
			</control>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[14200]</label>
				<visible>Window.IsVisible(playersettings)</visible>
			</control>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[14211]</label>
				<visible>Window.IsVisible(mediasettings)</visible>
			</control>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[13000]</label>
				<visible>Window.IsVisible(systemsettings)</visible>
			</control>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[14036]</label>
				<visible>Window.IsVisible(servicesettings)</visible>
			</control>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[15016]</label>
				<visible>Window.IsVisible(gamesettings)</visible>
			</control>
			<control type="label">
				<width>auto</width>
				<height>160</height>
				<font>MsTitle</font>
				<aligny>center</aligny>
				<textcolor>ffffffff</textcolor>
				<label>$LOCALIZE[19180]</label>
				<visible>Window.IsVisible(pvrsettings)</visible>
			</control>
		</control>
		<!-- left: sections -->
		<control id="3" type="grouplist">
			<left>144</left>
			<top>400</top>
			<width>1040</width>
			<height>1248</height>
			<itemgap>0</itemgap>
			<onleft>Back</onleft>
			<onright>5</onright>
			<onup>noop</onup>
			<ondown>20</ondown>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
		</control>
		<control id="10" type="button">
			<width>1040</width>
			<height>176</height>
			<textoffsetx>64</textoffsetx>
			<textwidth>912</textwidth>
			<aligny>center</aligny>
			<font>Med32</font>
			<textcolor>b3ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
			<onclick>SetFocus(5)</onclick>
			<pulseonselect>false</pulseonselect>
		</control>
		<!-- left, under the sections: Basic / Standard / Advanced / Expert (label set by Kodi) -->
		<control type="label">
			<left>208</left>
			<top>1680</top>
			<width>912</width>
			<height>64</height>
			<font>Light28</font>
			<aligny>center</aligny>
			<textcolor>80ffffff</textcolor>
			<label>$LOCALIZE[31016]</label>
		</control>
		<control id="20" type="button">
			<left>144</left>
			<top>1752</top>
			<width>1040</width>
			<height>176</height>
			<textoffsetx>64</textoffsetx>
			<textwidth>912</textwidth>
			<aligny>center</aligny>
			<font>Med32</font>
			<textcolor>b3ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
			<onup>3</onup>
			<ondown>noop</ondown>
			<onleft>Back</onleft>
			<onright>5</onright>
			<onclick>SettingsLevelChange</onclick>
			<pulseonselect>false</pulseonselect>
		</control>
		<!-- right: the settings of the focused section, on a glass card (description at its foot) -->
		<control type="image">
			<left>1280</left>
			<top>368</top>
			<width>2448</width>
			<height>1712</height>
			<texture border="76" colordiffuse="66141620">ms-card.png</texture>
		</control>
		<control id="5" type="grouplist">
			<left>1312</left>
			<top>400</top>
			<width>2384</width>
			<height>1440</height>
			<itemgap>0</itemgap>
			<onleft>3</onleft>
			<onright>noop</onright>
			<onup>noop</onup>
			<ondown>noop</ondown>
			<onback>3</onback>
			<scrolltime tween="cubic" easing="out">200</scrolltime>
			<usecontrolcoords>true</usecontrolcoords>
		</control>
		<control type="textbox">
			<left>1376</left>
			<top>1872</top>
			<width>2256</width>
			<height>200</height>
			<font>Light28</font>
			<aligny>top</aligny>
			<textcolor>99ffffff</textcolor>
			<label>$INFO[Control.GetLabel(6)]</label>
		</control>
		<!-- templates Kodi copies into id 5 -->
		<control id="7" type="button">
			<width>2384</width>
			<height>160</height>
			<font>Light32</font>
			<textoffsetx>64</textoffsetx>
			<aligny>center</aligny>
			<textcolor>e6ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<disabledcolor>4dffffff</disabledcolor>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
		</control>
		<control id="8" type="radiobutton">
			<width>2384</width>
			<height>160</height>
			<font>Light32</font>
			<textwidth>1900</textwidth>
			<textoffsetx>64</textoffsetx>
			<aligny>center</aligny>
			<textcolor>e6ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<disabledcolor>4dffffff</disabledcolor>
			<radiowidth>144</radiowidth>
			<radioheight>81</radioheight>
			<radioposx>2176</radioposx>
			<textureradioonfocus>ms-toggle-on-fo.png</textureradioonfocus>
			<textureradioonnofocus>ms-toggle-on-nf.png</textureradioonnofocus>
			<textureradioondisabled colordiffuse="66ffffff">ms-toggle-on-nf.png</textureradioondisabled>
			<textureradioofffocus>ms-toggle-off-fo.png</textureradioofffocus>
			<textureradiooffnofocus>ms-toggle-off-nf.png</textureradiooffnofocus>
			<textureradiooffdisabled colordiffuse="66ffffff">ms-toggle-off-nf.png</textureradiooffdisabled>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
		</control>
		<control id="9" type="spincontrolex">
			<width>2384</width>
			<height>160</height>
			<font>Light32</font>
			<textoffsetx>64</textoffsetx>
			<aligny>center</aligny>
			<textcolor>e6ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<disabledcolor>4dffffff</disabledcolor>
			<selectedcolor>SelectedColour</selectedcolor>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
			<reverse>yes</reverse>
		</control>
		<control id="11" type="image">
			<height>32</height>
			<texture/>
		</control>
		<control id="13" type="sliderex">
			<width>2384</width>
			<height>160</height>
			<font>Light32</font>
			<textwidth>1600</textwidth>
			<textoffsetx>64</textoffsetx>
			<textcolor>e6ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<disabledcolor>4dffffff</disabledcolor>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
			<sliderwidth>400</sliderwidth>
			<sliderheight>24</sliderheight>
			<texturesliderbar border="12">osd/progress_bar_back.png</texturesliderbar>
			<texturesliderbardisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_back.png</texturesliderbardisabled>
			<textureslidernib border="12">osd/progress_bar_cache.png</textureslidernib>
			<textureslidernibdisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_cache.png</textureslidernibdisabled>
			<textureslidernibfocus>common/white_square.png</textureslidernibfocus>
		</control>
		<control id="14" type="label">
			<left>64</left>
			<width>2320</width>
			<height>128</height>
			<font>Med28</font>
			<aligny>bottom</aligny>
			<textcolor>80ffffff</textcolor>
		</control>
		<control id="15" type="colorbutton">
			<width>2384</width>
			<height>160</height>
			<font>Light32</font>
			<textoffsetx>64</textoffsetx>
			<aligny>center</aligny>
			<textcolor>e6ffffff</textcolor>
			<focusedcolor>ff000000</focusedcolor>
			<disabledcolor>4dffffff</disabledcolor>
			<texturefocus border="47">ms-pill.png</texturefocus>
			<texturenofocus/>
		</control>
	</controls>
</window>
