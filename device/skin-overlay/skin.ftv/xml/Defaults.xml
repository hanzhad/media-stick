<?xml version="1.0" encoding="UTF-8"?>
<!-- media-stick overlay of skin.ftv 8.0.1 (generated by stage/build_overlay.py). Differs from upstream: focus fill -> ms-pill.png border 47 x3; progress fill -> white_square.png x3; second pass (stage/gen2.py): unfocused button -> faint pill x2; row separator lines removed x1. -->
<includes>
	<default type="label">
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffffffff</textcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<include condition="Integer.IsLess(System.ScreenHeight,1080)">ScrollSpeed_720</include>
		<include condition="Integer.IsEqual(System.ScreenHeight,1080)">ScrollSpeed_1080</include>
		<include condition="Integer.IsGreaterOrEqual(System.ScreenHeight,2160)">ScrollSpeed_4k</include>
		<scrollsuffix>         |         </scrollsuffix>
	</default>
	<default type="fadelabel">
		<height>72</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<scrollout>false</scrollout>
		<include condition="Integer.IsLess(System.ScreenHeight,1080)">ScrollSpeed_720</include>
		<include condition="Integer.IsEqual(System.ScreenHeight,1080)">ScrollSpeed_1080</include>
		<include condition="Integer.IsGreaterOrEqual(System.ScreenHeight,2160)">ScrollSpeed_4k</include>
		<pauseatend>2000</pauseatend>
	</default>
	<default type="button">
		<width>800</width>
		<height>132</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<invalidcolor>DisabledColour</invalidcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<texturefocus border="47">ms-pill.png</texturefocus>
		<texturenofocus border="47" colordiffuse="1affffff">ms-pill.png</texturenofocus>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="togglebutton">
		<width>800</width>
		<height>132</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<texturefocus/>
		<texturenofocus/>
		<alttexturenofocus/>
		<alttexturefocus/>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="radiobutton">
		<width>800</width>
		<height>132</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<radiowidth>200</radiowidth>
		<radioheight>116</radioheight>
		<textureradioonfocus/>
		<textureradioonnofocus/>
		<textureradioofffocus/>
		<textureradiooffnofocus/>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrolex">
		<width>800</width>
		<height>132</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<spinwidth>64</spinwidth>
		<spinheight>42</spinheight>
		<texturenofocus/>
		<texturefocus/>
		<textureup colordiffuse="NotFocusedColour">dialogs/SpinUp.png</textureup>
		<texturedown colordiffuse="NotFocusedColour">dialogs/SpinDown.png</texturedown>
		<textureupfocus colordiffuse="FocusedColour">dialogs/SpinUp.png</textureupfocus>
		<texturedownfocus colordiffuse="FocusedColour">dialogs/SpinDown.png</texturedownfocus>
		<textureupdisabled colordiffuse="DisabledColour">dialogs/SpinUp.png</textureupdisabled>
		<texturedowndisabled colordiffuse="DisabledColour">dialogs/SpinDown.png</texturedowndisabled>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="spincontrol">
		<height>132</height>
		<width>132</width>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<spinwidth>64</spinwidth>
		<spinheight>42</spinheight>
		<textureup colordiffuse="NotFocusedColour">dialogs/SpinUp.png</textureup>
		<texturedown colordiffuse="NotFocusedColour">dialogs/SpinDown.png</texturedown>
		<textureupfocus colordiffuse="FocusedColour">dialogs/SpinUp.png</textureupfocus>
		<texturedownfocus colordiffuse="FocusedColour">dialogs/SpinDown.png</texturedownfocus>
		<textureupdisabled colordiffuse="DisabledColour">dialogs/SpinUp.png</textureupdisabled>
		<texturedowndisabled colordiffuse="DisabledColour">dialogs/SpinDown.png</texturedowndisabled>
		<reverse>yes</reverse>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="sliderex">
		<height>132</height>
		<width>366</width>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<texturefocus border="47">ms-pill.png</texturefocus>
		<texturenofocus/>
		<sliderwidth>300</sliderwidth>
		<sliderheight>24</sliderheight>
		<texturesliderbar border="12">osd/progress_bar_back.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_back.png</texturesliderbardisabled>
		<textureslidernib border="12">osd/progress_bar_cache.png</textureslidernib>
		<textureslidernibdisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_cache.png</textureslidernibdisabled>
		<textureslidernibfocus>common/white_square.png</textureslidernibfocus>
		<pulseonselect>false</pulseonselect>
	</default>
	<default type="slider">
		<width>720</width>
		<height>46</height>
		<orientation>horizontal</orientation>
		<texturesliderbar border="12">osd/progress_bar_back.png</texturesliderbar>
		<texturesliderbardisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_back.png</texturesliderbardisabled>
		<textureslidernib border="12">osd/progress_bar_cache.png</textureslidernib>
		<textureslidernibdisabled colordiffuse="DisabledColour" border="12">osd/progress_bar_cache.png</textureslidernibdisabled>
		<textureslidernibfocus>common/white_square.png</textureslidernibfocus>
	</default>
	<default type="progress">
		<height>88</height>
		<texturebg border="12">osd/progress_bar_back.png</texturebg>
		<lefttexture/>
		<midtexture>common/white_square.png</midtexture>
		<righttexture/>
		<overlaytexture/>
		<reveal>true</reveal>
	</default>
	<default type="textbox">
		<font>Med22</font>
		<autoscroll delay="8000" repeat="12000" time="4000">true</autoscroll>
	</default>
	<default type="edit">
		<height>132</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<invalidcolor>DisabledColour</invalidcolor>
		<texturefocus/>
		<pulseonselect>no</pulseonselect>
		<hinttext>...</hinttext>
	</default>
	<default type="colorbutton">
		<width>800</width>
		<height>132</height>
		<align>left</align>
		<aligny>center</aligny>
		<font>Med22</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<selectedcolor>SelectedColour</selectedcolor>
		<invalidcolor>DisabledColour</invalidcolor>
		<disabledcolor>DisabledColour</disabledcolor>
		<texturefocus border="47">ms-pill.png</texturefocus>
		<texturenofocus border="47" colordiffuse="1affffff">ms-pill.png</texturenofocus>
		<colorwidth>226</colorwidth>
		<colorheight>66</colorheight>
		<texturecolormask>common/white_square.png</texturecolormask>
		<texturecolordisabledmask colordiffuse="DisabledColour">common/white_square.png</texturecolordisabledmask>
		<pulseonselect>false</pulseonselect>
	</default>
</includes>
