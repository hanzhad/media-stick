<?xml version="1.0" encoding="UTF-8"?>
<!-- Accounts (resources/lib/accounts_screen.py). List 600: label = the action, label2 = the state,
     property confirm = the first press of a two-step action has happened. -->
<window>
    <defaultcontrol always="true">600</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>F2080B10</colordiffuse>
        </control>
        <control type="group">
            <left>360</left>
            <top>120</top>
            <width>1200</width>
            <height>840</height>
            <control type="image">
                <left>-40</left>
                <top>-30</top>
                <width>1280</width>
                <height>920</height>
                <texture border="56">card-shadow.png</texture>
            </control>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>840</height>
                <texture border="47">pill.png</texture>
                <colordiffuse>F2141922</colordiffuse>
            </control>
            <control type="label">
                <left>72</left>
                <top>48</top>
                <width>1056</width>
                <height>90</height>
                <font>Light60</font>
                <textcolor>FFFFFFFF</textcolor>
                <aligny>center</aligny>
                <label>Accounts</label>
            </control>
            <control type="list" id="600">
                <left>48</left>
                <top>160</top>
                <width>1104</width>
                <height>580</height>
                <orientation>vertical</orientation>
                <scrolltime>200</scrolltime>
                <itemlayout width="1104" height="116">
                    <control type="label">
                        <left>24</left>
                        <top>12</top>
                        <width>1056</width>
                        <height>52</height>
                        <font>Med32</font>
                        <textcolor>B3FFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>62</top>
                        <width>1056</width>
                        <height>38</height>
                        <font>Reg25</font>
                        <textcolor>80FFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                </itemlayout>
                <focusedlayout width="1104" height="116">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>1104</width>
                        <height>112</height>
                        <texture border="47">pill.png</texture>
                        <colordiffuse>33FFFFFF</colordiffuse>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>12</top>
                        <width>1056</width>
                        <height>52</height>
                        <font>Med32</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>String.IsEmpty(ListItem.Property(confirm))</visible>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>12</top>
                        <width>1056</width>
                        <height>52</height>
                        <font>Med32</font>
                        <textcolor>FFFF8A80</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <visible>!String.IsEmpty(ListItem.Property(confirm))</visible>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>62</top>
                        <width>1056</width>
                        <height>38</height>
                        <font>Reg25</font>
                        <textcolor>CCFFFFFF</textcolor>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                </focusedlayout>
            </control>
            <control type="label">
                <left>72</left>
                <top>760</top>
                <width>1056</width>
                <height>50</height>
                <font>Reg25</font>
                <textcolor>80FFFFFF</textcolor>
                <aligny>center</aligny>
                <label>OK chooses, Back closes. Signing in works from the phone remote too.</label>
            </control>
        </control>
    </controls>
</window>
