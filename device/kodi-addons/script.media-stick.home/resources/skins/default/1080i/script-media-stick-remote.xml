            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>B3000000</colordiffuse>
        </control>
        <control type="group">
            <left>500</left>
            <top>310</top>
            <width>920</width>
            <height>460</height>
