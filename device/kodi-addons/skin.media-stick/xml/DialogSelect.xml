<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">3</defaultcontrol>
	<controls>
		<include>DialogBackgroundImage</include>
		<control type="group">
			<include>DialogAnimation</include>
			<centerleft>50%</centerleft>
			<centertop>50%</centertop>
			<width>880</width>
			<height>720</height>
			<control type="image">
				<width>880</width>
				<height>720</height>
				<texture border="47" colordiffuse="DialogBackColour">ms-card.png</texture>
			</control>
			<control id="1" type="label">
				<left>48</left>
				<top>32</top>
				<width>784</width>
				<height>52</height>
				<font>MsHeading</font>
				<textcolor>FFFFFFFF</textcolor>
			</control>
			<!-- Simple list -->
			<control id="3" type="list">
				<left>36</left>
				<top>104</top>
				<width>808</width>
				<height>500</height>
				<onleft>5</onleft>
				<onright>5</onright>
				<onup>3</onup>
				<ondown>3</ondown>
				<scrolltime tween="cubic" easing="out">180</scrolltime>
				<itemlayout height="68" width="808">
					<control type="label">
						<left>24</left>
						<width>760</width>
						<height>68</height>
						<font>Med28</font>
						<textcolor>NotFocusedColour</textcolor>
						<label>$INFO[ListItem.Label]</label>
