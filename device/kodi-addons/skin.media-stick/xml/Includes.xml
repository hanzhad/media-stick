<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="HiddenControl">
		<left>-10</left>
		<top>-10</top>
		<width>1</width>
		<height>1</height>
		<texturefocus/>
		<texturenofocus/>
	</include>
	<include name="BackgroundImage">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="BackgroundColour">white.png</texture>
		</control>
	</include>
	<include name="DialogBackgroundImage">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="b3000000">white.png</texture>
			<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
		</control>
	</include>
	<include name="DialogAnimation">
		<animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="out">WindowOpen</animation>
		<animation effect="fade" start="100" end="0" time="160" tween="cubic" easing="in">WindowClose</animation>
	</include>
	<include name="WindowFadeAnimation">
		<animation effect="fade" start="0" end="100" time="200" tween="cubic" easing="out">WindowOpen</animation>
		<animation effect="fade" start="100" end="0" time="160" tween="cubic" easing="in">WindowClose</animation>
	</include>
	<include name="KeyboardButtons">
		<width>74</width>
		<height>72</height>
		<align>center</align>
		<aligny>center</aligny>
		<textoffsetx>0</textoffsetx>
		<font>Med24</font>
		<textcolor>ffd8d8d8</textcolor>
		<focusedcolor>ff000000</focusedcolor>
		<texturefocus border="28">ms-pill.png</texturefocus>
		<texturenofocus border="28" colordiffuse="1affffff">ms-pill.png</texturenofocus>
		<pulseonselect>false</pulseonselect>
	</include>
