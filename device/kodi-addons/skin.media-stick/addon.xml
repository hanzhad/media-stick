<?xml version="1.0" encoding="UTF-8"?>
<addon id="skin.media-stick" version="1.0.0" name="Media Stick" provider-name="media-stick">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Lightweight native 1080p skin for Media Stick</summary>
		<description lang="en_GB">Purpose-built native 1920x1080 dark skin for Raspberry Pi 3B+ with zero third-party skin dependencies.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
	</extension>
</addon>
