<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.media-stick.webapp" name="Web app launcher" version="1.0.0" provider-name="media-stick">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Opens a web service full screen in Chromium; Kodi returns when it closes.</summary>
        <platform>linux</platform>
    </extension>
</addon>
