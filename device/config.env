# Device settings. bootstrap.sh applies them; a change here reaches the device with
# the next update like any other change. One device can override any line in
# /etc/media-stick/local.env (not in the repository).

# How often the device pulls main and applies it. systemd OnCalendar syntax.
#   every 5 minutes (while developing): *:0/5
#   once a day at 04:00:                *-*-* 04:00
UPDATE_SCHEDULE="*:0/5"
