<!-- Tiles on the Kodi home screen (the Favourites row), in this order. Bootstrap
     puts these first in /home/media/.kodi/userdata/favourites.xml and keeps any
     favourites added on the TV after them. Matched by name.
     Web services run full screen in Chromium (/usr/local/bin/web-app); Kodi comes
     back when the browser is closed or "Back to Kodi" is pressed on the page. -->
<favourites>
    <favourite name="SWEET.TV" thumb="special://home/addons/plugin.video.sweettv/icon.png">ActivateWindow(10025,&quot;plugin://plugin.video.sweettv/&quot;,return)</favourite>
    <favourite name="YouTube" thumb="special://home/addons/plugin.video.youtube/resources/media/icon.png">ActivateWindow(10025,&quot;plugin://plugin.video.youtube/&quot;,return)</favourite>
    <favourite name="Netflix" thumb="special://home/media/web-apps/netflix.png">RunScript(script.media-stick.webapp,netflix)</favourite>
    <favourite name="Disney+" thumb="special://home/media/web-apps/disney.png">RunScript(script.media-stick.webapp,disney)</favourite>
    <favourite name="Prime Video" thumb="special://home/media/web-apps/prime.png">RunScript(script.media-stick.webapp,prime)</favourite>
    <favourite name="HBO Max" thumb="special://home/media/web-apps/max.png">RunScript(script.media-stick.webapp,max)</favourite>
    <favourite name="Plex" thumb="special://home/addons/script.plex/icon.png">RunScript(script.plex)</favourite>
    <favourite name="Add-ons" thumb="DefaultAddon.png">ActivateWindow(AddonBrowser,return)</favourite>
</favourites>
